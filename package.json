{
  "name": "byond-retail-os",
  "version": "0.0.0",
  "private": true,
  "description": "BYOND Retail OS — edge-first, cloud-managed, multitenant retail operating system.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-api.ps1",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "security:secrets": "node infra/scripts/security-secrets.mjs",
    "security:scan": "node infra/scripts/security-scan.mjs",
    "codex:summary": "node scripts/codex-review-summary.mjs",
    "codex:auto-loop": "node scripts/codex-auto-loop.mjs",
    "codex:fix-loop:docs": "echo \"Run Claude command: /fix-codex-review (see docs/development/codex-claude-loop.md)\"",
    "ml:test": "python -m unittest discover -s ml/tests -p \"test_*.py\"",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down -v"
  }
}
