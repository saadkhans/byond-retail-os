# Copy to infra/docker/.env and fill in. Never commit the filled-in file.
POSTGRES_USER=byond
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=byond
POSTGRES_PORT=5432

# Must be a real, high-entropy secret — the API refuses to boot on a weak one.
JWT_SECRET=change-me-to-a-long-random-string

API_PORT=3000
ADMIN_WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:3000
