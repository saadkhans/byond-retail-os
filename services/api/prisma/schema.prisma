// BYOND core platform schema — Phase 1.
//
// Scope rules:
// - Global (platform-owned, no tenantId): Permission, PlatformModule.
// - Tenant-owned (tenantId required): Location, TenantModule.
// - Hybrid (tenantId nullable, guarded by CHECK constraints in migration SQL):
//   User  — NULL tenantId ⇔ userType = PLATFORM (BYOND staff)
//   Role  — NULL tenantId ⇔ isSystem = true (seeded system role)
//   AuditLog — NULL tenantId only for pure platform-level actions
// A NULL tenantId is NEVER a wildcard: the repository layer treats platform
// scope as an explicit, separate code path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserType {
  PLATFORM
  TENANT
}

enum LocationType {
  STORE
  WAREHOUSE
  DARK_STORE
  POPUP
  OFFICE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ModuleStatus {
  ENABLED
  DISABLED
  TRIAL
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ENABLE
  DISABLE
  INVITE
  ROLE_ASSIGN
  ROLE_REVOKE
  SUSPEND
  REACTIVATE
  CONFIG_CHANGE
  ACCESS_DENIED
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  STOCK_ADJUSTMENT
  REGISTER
  HEARTBEAT
  COMPLETE
  CANCEL
  EXPIRE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

// Quantities are INTEGERS in the product's unit of measure. Products sold by
// weight/volume declare a base unit that keeps integer counts expressive
// (GRAM, MILLILITER) — there are no fractional stock quantities anywhere in
// the ledger, which keeps stock math exact (no float/decimal drift).
enum UnitOfMeasure {
  EACH
  PACK
  BOX
  CASE
  PAIR
  GRAM
  MILLILITER
}

enum BarcodeFormat {
  EAN13
  EAN8
  UPC_A
  UPC_E
  CODE128
  CODE39
  QR
  OTHER
}

// Ledger event types. Phase 3 shipped manual adjustments; Phase 5 adds SALE
// (checkout completion). Later phases append more values (RECEIPT, TRANSFER,
// ...) — the ledger shape (signed delta + snapshot + reference fields) is
// already sized for them.
enum InventoryMovementType {
  ADJUSTMENT
  SALE
}

// ---------------------------------------------------------------------------
// Phase 4 — stores (Location), autonomous retail units, devices.
// ---------------------------------------------------------------------------

enum RetailUnitType {
  SMART_FRIDGE
  SMART_SHELF
  KIOSK
  VENDING_MACHINE
  MICRO_MARKET
  SMART_GATE
  OTHER
}

enum RetailUnitStatus {
  DRAFT
  ACTIVE
  MAINTENANCE
  DISABLED
  RETIRED
}

enum DeviceType {
  CAMERA
  DOOR_LOCK
  SHELF_SENSOR
  WEIGHT_SENSOR
  PAYMENT_TERMINAL
  EDGE_GATEWAY
  TEMPERATURE_SENSOR
  OTHER
}

enum DeviceStatus {
  PROVISIONED
  ONLINE
  OFFLINE
  MAINTENANCE
  DISABLED
  RETIRED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(PENDING)
  settings  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]
  roles     Role[]
  locations Location[]
  modules   TenantModule[]
  auditLogs AuditLog[]

  productCategories  ProductCategory[]
  brands             Brand[]
  products           Product[]
  productBarcodes    ProductBarcode[]
  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  retailUnits        RetailUnit[]
  devices            Device[]
  checkoutSessions     CheckoutSession[]
  checkoutSessionLines CheckoutSessionLine[]
  orders               Order[]
  orderLines           OrderLine[]
}

model User {
  id       String   @id @default(cuid())
  tenantId String?
  userType UserType
  email    String   @unique
  firstName String
  lastName  String
  status    UserStatus @default(INVITED)
  // Nullable: users may authenticate via future providers (SSO/OIDC/OTP)
  // and never hold a local credential. Never plaintext. Only AuthRepository
  // may load this column — every non-auth user query goes through
  // SAFE_USER_SELECT (users.repository.ts), which omits it; audit snapshot
  // redaction and toSafeUser() are additional layers, not the only ones.
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles UserRole[]
  auditLogs AuditLog[] @relation("AuditActor")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementActor")
  checkoutSessionsCreated     CheckoutSession[]     @relation("CheckoutSessionActor")
  checkoutSessionLinesCreated CheckoutSessionLine[] @relation("CheckoutSessionLineActor")
  ordersCreated               Order[]               @relation("OrderActor")
  orderLinesCreated           OrderLine[]           @relation("OrderLineActor")

  @@index([tenantId, status])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  // System roles (tenantId NULL) get a partial unique index in migration SQL,
  // because Postgres treats NULLs as distinct in this composite unique.
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id String @id @default(cuid())
  userId String
  roleId String
  // Denormalized from Role for join-free tenant isolation filtering.
  // Invariant (service layer): tenantId === role.tenantId.
  tenantId     String?
  assignedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([tenantId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Location {
  id        String         @id @default(cuid())
  tenantId  String
  name      String
  code      String
  type      LocationType
  status    LocationStatus @default(ACTIVE)
  timezone  String         @default("UTC")
  address   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  retailUnits        RetailUnit[]
  checkoutSessions   CheckoutSession[]
  orders             Order[]

  @@unique([tenantId, code])
  // Enables the composite tenant-integrity FKs added in migration SQL
  // (inventory rows must reference a location of the SAME tenant).
  @@unique([id, tenantId])
  @@index([tenantId, type])
}

model PlatformModule {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  isActive      Boolean  @default(true)
  defaultConfig Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantModules TenantModule[]
}

model TenantModule {
  id         String       @id @default(cuid())
  tenantId   String
  moduleId   String
  status     ModuleStatus @default(ENABLED)
  config     Json?
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  module PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, moduleId])
  @@index([moduleId])
}

// Append-only: no updatedAt, no update/delete repository methods, and
// migration-SQL triggers reject UPDATE/DELETE/TRUNCATE at the database level.
// Because rows are immutable, FKs must never require mutating them: both
// relations are Restrict/NoAction (a SetNull or cascading update would be
// rejected by the append-only trigger and break the referencing operation).
// Users are never hard-deleted while audit rows reference them — lifecycle is
// status-driven (DEACTIVATED), per the platform's audit retention model.
model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  actorId  String?
  // Point-in-time snapshot of the actor's email at write time.
  actorEmail String
  action     AuditAction
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — product catalog & inventory foundation.
//
// Every model below is tenant-owned (tenantId required, accessed only through
// TenantScopedRepository subclasses). Migration SQL additionally adds
// composite foreign keys — e.g. (productId, tenantId) → Product(id, tenantId)
// — so a row can never reference another tenant's product/location/category
// even if a repository bug slipped an unscoped id through.
// ---------------------------------------------------------------------------

model ProductCategory {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  // Optional single-parent hierarchy within the same tenant.
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, parentId])
}

model Brand {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
}

model Product {
  id          String  @id @default(cuid())
  tenantId    String
  // Stock-keeping unit code, unique per tenant, normalized to uppercase.
  sku         String
  name        String
  description String?
  categoryId  String?
  brandId     String?
  unitOfMeasure UnitOfMeasure @default(EACH)
  status        ProductStatus @default(DRAFT)
  // When set, inventory reads flag levels with quantity <= threshold as low
  // stock. Product-wide (per-location overrides are a later phase).
  lowStockThreshold Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)

  barcodes           ProductBarcode[]
  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  checkoutSessionLines CheckoutSessionLine[]
  orderLines           OrderLine[]

  @@unique([tenantId, sku])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([tenantId, name])
}

model ProductBarcode {
  id        String        @id @default(cuid())
  tenantId  String
  productId String
  // Scanned value; a barcode resolves to exactly one product per tenant.
  value     String
  format    BarcodeFormat @default(OTHER)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, value])
  @@index([productId])
}

// DERIVED stock projection — never written directly from user input. The
// quantity changes exclusively via atomic increments inside the same
// transaction that appends the InventoryMovement ledger row (the ledger is
// the source of truth, per AGENTS.md). CHECK (quantity >= 0) in migration
// SQL backstops the application-level guard against races.
model InventoryLevel {
  id        String @id @default(cuid())
  tenantId  String
  locationId String
  productId  String
  quantity   Int    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, locationId, productId])
  @@index([tenantId, productId])
  @@index([tenantId, locationId])
}

// Phase 4 — autonomous retail unit inside a store (smart fridge, smart
// shelf, kiosk, ...). Tenant-owned; always assigned to a Location of the
// SAME tenant (composite FK in migration SQL). Deletion is Restrict-guarded:
// a unit with devices (or future inventory references) cannot be removed.
model RetailUnit {
  id       String @id @default(cuid())
  tenantId String
  // The store (Location) this unit lives in.
  locationId String
  // Short human-readable identifier, unique per tenant, uppercase.
  code   String
  name   String
  type   RetailUnitType
  status RetailUnitStatus @default(DRAFT)
  // Physical placement within the store, e.g. "Aisle 3, next to entrance".
  placement String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  devices  Device[]
  checkoutSessions CheckoutSession[]
  orders           Order[]

  @@unique([tenantId, code])
  // Enables composite same-tenant FKs (devices must reference a unit of the
  // SAME tenant) — mirrors the Phase 3 hardening pattern.
  @@unique([id, tenantId])
  @@index([tenantId, locationId])
  @@index([tenantId, status])
  @@index([tenantId, type])
}

// Phase 4 — physical device attached to a retail unit (camera, lock,
// sensor, gateway, ...). `metadata` holds SAFE, NON-SECRET configuration
// only — credentials/secrets must never be stored here (audit snapshots
// additionally redact credential-shaped keys as a backstop).
//
// Edge registration stores ONLY the SHA-256 hash of a one-time registration
// token; the plaintext is returned once at issuance and never persisted or
// logged. Redeeming the token (POST /edge/register) clears the hash.
model Device {
  id       String @id @default(cuid())
  tenantId String
  unitId   String
  name     String
  type     DeviceType
  status   DeviceStatus @default(PROVISIONED)
  // Hardware serial number / ID, unique per tenant. Stored as entered
  // (trimmed) — serials can be case-sensitive.
  serialNumber String
  metadata     Json?
  firmwareVersion String?
  softwareVersion String?
  // Updated by the heartbeat endpoint; never client-supplied.
  lastSeenAt DateTime?
  registrationTokenHash      String?   @unique
  registrationTokenExpiresAt DateTime?
  registeredAt               DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unit   RetailUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  checkoutSessions CheckoutSession[]

  @@unique([tenantId, serialNumber])
  @@unique([id, tenantId])
  @@index([tenantId, unitId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, lastSeenAt])
}

// Append-only inventory ledger: no updatedAt, no update/delete repository
// methods, and migration-SQL triggers reject UPDATE/DELETE/TRUNCATE at the
// database level (same hardening as AuditLog). All relations are Restrict/
// NoAction so no FK action can ever need to mutate a ledger row.
model InventoryMovement {
  id         String @id @default(cuid())
  tenantId   String
  locationId String
  productId  String
  movementType  InventoryMovementType
  // Signed change, never zero (CHECK in migration SQL).
  quantityDelta Int
  // Resulting on-hand quantity, snapshotted inside the adjustment
  // transaction — lets auditors verify the ledger replays to the level.
  quantityAfter Int
  reason        String
  // Future phases link movements to their cause (order, transfer, receipt)
  // without schema changes.
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy User?    @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, locationId, productId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([productId])
  @@index([locationId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Phase 5 — checkout sessions & order foundation.
//
// Connects Phase 3 inventory and Phase 4 stores/units/devices into the first
// transaction backbone: session -> basket line -> order line -> SALE ledger
// movement. NO payment capture in this phase — pricing/total columns are
// nullable placeholders that stay NULL until the pricing/payments phases, and
// nothing here may imply an order was paid.
//
// Evidence/source fields (sourceType, sourceId, evidenceBundleId,
// visionEventId, vlmReviewId, evidenceScore, evidenceQuality, reasonCodes)
// are VENDOR-NEUTRAL lineage placeholders: future CV/VLM providers plug in
// through adapter layers that populate these normalized references. No
// camera/model/vendor-specific data is ever stored in the checkout core.
// ---------------------------------------------------------------------------

enum CheckoutSessionStatus {
  OPEN
  ACTIVE
  PENDING_REVIEW
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// Who/what produced a session, line, or order: staff acting manually, an
// admin tool, a device-originated flow, a vision pipeline (future), or the
// system itself (e.g. expiry sweeps). Deliberately generic — never a vendor
// or model name.
enum EvidenceSourceType {
  MANUAL
  ADMIN
  DEVICE
  VISION
  SYSTEM
}

enum EvidenceQuality {
  LOW
  MEDIUM
  HIGH
}

// Basket line lifecycle. Removing a line is a SOFT delete (status → REMOVED):
// the row survives as a tombstone so its tenant-scoped idempotencyKey stays
// reserved forever — a lost-response retry of the original add can never
// resurrect an intentionally removed item. REMOVED lines are excluded from
// the active basket and from completion.
enum CheckoutSessionLineStatus {
  ACTIVE
  REMOVED
}

// A shopping visit at one retail unit in one store. Lifecycle:
// OPEN -> ACTIVE -> PENDING_REVIEW -> COMPLETED, with CANCELLED/EXPIRED as
// the other terminal states. Terminal sessions are immutable except through
// the audit trail. Completion is the ONLY path that creates an Order and
// consumes stock, atomically with SALE ledger movements.
model CheckoutSession {
  id         String                @id @default(cuid())
  tenantId   String
  locationId String
  unitId     String
  // Optional source device reference (no edge runtime in Phase 5).
  deviceId  String?
  status    CheckoutSessionStatus @default(OPEN)
  startedAt DateTime              @default(now())
  endedAt   DateTime?
  // Vendor-neutral evidence/source lineage (see Phase 5 header comment).
  sourceType       EvidenceSourceType @default(MANUAL)
  sourceId         String?
  evidenceBundleId String?
  visionEventId    String?
  vlmReviewId      String?
  evidenceScore    Float?
  evidenceQuality  EvidenceQuality?
  reasonCodes      String[]           @default([])
  // Tenant-scoped idempotency for session creation: replays return the
  // original session instead of opening a duplicate.
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location  Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit      RetailUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  device    Device?    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("CheckoutSessionActor", fields: [createdById], references: [id], onDelete: Restrict)
  lines     CheckoutSessionLine[]
  order     Order?

  // Enables composite same-tenant FKs (lines/orders must reference a session
  // of the SAME tenant) — mirrors the Phase 3/4 hardening pattern.
  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, startedAt, id])
  @@index([tenantId, locationId])
  @@index([tenantId, unitId])
}

// Basket line: one product per session (quantity aggregates). Snapshots the
// product's sku/name/unit so completed history never rewrites when the
// catalog is edited later. Every mutation carries evidence/source lineage or
// a manual/admin actor reference.
model CheckoutSessionLine {
  id        String @id @default(cuid())
  tenantId  String
  sessionId String
  productId String
  // Product snapshot (immutable history even if the product is later edited):
  sku           String
  productName   String
  unitOfMeasure UnitOfMeasure
  quantity      Int
  // Soft-delete lifecycle: REMOVED lines are tombstones that keep the
  // idempotencyKey reserved (see CheckoutSessionLineStatus above).
  status    CheckoutSessionLineStatus @default(ACTIVE)
  removedAt DateTime?
  // Pricing placeholders — ALWAYS NULL in Phase 5; future pricing/payment
  // phases populate them (minor currency units, integer-exact).
  unitPriceMinor Int?
  lineTotalMinor Int?
  currencyCode   String?
  // Vendor-neutral evidence/source lineage (same set as the session).
  sourceType       EvidenceSourceType @default(MANUAL)
  sourceId         String?
  evidenceBundleId String?
  visionEventId    String?
  vlmReviewId      String?
  evidenceScore    Float?
  evidenceQuality  EvidenceQuality?
  reasonCodes      String[]           @default([])
  // Tenant-scoped idempotency for line creation replays.
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session    CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy  User?           @relation("CheckoutSessionLineActor", fields: [createdById], references: [id], onDelete: Restrict)
  orderLines OrderLine[]

  @@unique([id, tenantId])
  // One ACTIVE line per product per session ("adds aggregate into updates")
  // is enforced by a PARTIAL unique index in migration SQL
  // (CheckoutSessionLine_active_product_key, WHERE status = 'ACTIVE') —
  // Prisma cannot express partial indexes. REMOVED tombstones are exempt so
  // a product can be legitimately re-added after removal.
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, sessionId, createdAt, id])
  @@index([tenantId, sessionId, productId])
}

// Order foundation generated from a completed checkout session. CONFIRMED
// means inventory was consumed atomically — it does NOT mean paid/captured;
// payment status arrives in a later phase. Cancelling an order in Phase 5 is
// a status change only (stock reversal ships with the returns/refunds phase).
model Order {
  id       String @id @default(cuid())
  tenantId String
  // Human-readable, unique per tenant (ORD-000001 style).
  orderNumber String
  // One order per session; globally unique because ids are cuids, and
  // additionally unique per tenant below (the composite same-tenant FK in
  // migration SQL keeps the pair tenant-consistent).
  checkoutSessionId String      @unique
  locationId        String
  unitId            String
  status            OrderStatus @default(CONFIRMED)
  placedAt          DateTime    @default(now())
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  totalQuantity     Int
  // Pricing/payment placeholders — ALWAYS NULL in Phase 5 (no paid/captured
  // semantics anywhere).
  subtotalMinor Int?
  totalMinor    Int?
  currencyCode  String?
  // Evidence lineage copied from the completed session.
  sourceType       EvidenceSourceType @default(MANUAL)
  sourceId         String?
  evidenceBundleId String?
  visionEventId    String?
  vlmReviewId      String?
  evidenceScore    Float?
  evidenceQuality  EvidenceQuality?
  reasonCodes      String[]           @default([])
  // Tenant-scoped completion idempotency: a duplicate completion request
  // with the same key returns this order instead of creating another.
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  location  Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit      RetailUnit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy User?           @relation("OrderActor", fields: [createdById], references: [id], onDelete: Restrict)
  lines     OrderLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, orderNumber])
  @@unique([tenantId, checkoutSessionId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, placedAt, id])
  @@index([tenantId, locationId])
}

// Order line snapshot. Copies the session line's product snapshot and
// evidence lineage at completion time, plus a sessionLineId back-reference so
// the full chain session -> basket line -> order line -> SALE movement stays
// traceable. Never updated after creation (no updatedAt by design).
model OrderLine {
  id        String  @id @default(cuid())
  tenantId  String
  orderId   String
  productId String
  // Lineage: which basket line this order line was materialized from.
  sessionLineId String?
  sku           String
  productName   String
  unitOfMeasure UnitOfMeasure
  quantity      Int
  // Pricing placeholders — ALWAYS NULL in Phase 5.
  unitPriceMinor Int?
  lineTotalMinor Int?
  currencyCode   String?
  // Vendor-neutral evidence/source lineage copied from the session line.
  sourceType       EvidenceSourceType @default(MANUAL)
  sourceId         String?
  evidenceBundleId String?
  visionEventId    String?
  vlmReviewId      String?
  evidenceScore    Float?
  evidenceQuality  EvidenceQuality?
  reasonCodes      String[]           @default([])
  createdById      String?
  createdAt        DateTime           @default(now())

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  sessionLine CheckoutSessionLine? @relation(fields: [sessionLineId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation("OrderLineActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, orderId])
}
