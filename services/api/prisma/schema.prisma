// BYOND core platform schema — Phase 1.
//
// Scope rules:
// - Global (platform-owned, no tenantId): Permission, PlatformModule.
// - Tenant-owned (tenantId required): Location, TenantModule.
// - Hybrid (tenantId nullable, guarded by CHECK constraints in migration SQL):
//   User  — NULL tenantId ⇔ userType = PLATFORM (BYOND staff)
//   Role  — NULL tenantId ⇔ isSystem = true (seeded system role)
//   AuditLog — NULL tenantId only for pure platform-level actions
// A NULL tenantId is NEVER a wildcard: the repository layer treats platform
// scope as an explicit, separate code path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserType {
  PLATFORM
  TENANT
}

enum LocationType {
  STORE
  WAREHOUSE
  DARK_STORE
  POPUP
  OFFICE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ModuleStatus {
  ENABLED
  DISABLED
  TRIAL
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ENABLE
  DISABLE
  INVITE
  ROLE_ASSIGN
  ROLE_REVOKE
  SUSPEND
  REACTIVATE
  CONFIG_CHANGE
  ACCESS_DENIED
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  STOCK_ADJUSTMENT
  REGISTER
  HEARTBEAT
  COMPLETE
  CANCEL
  EXPIRE
  // Phase 7 — vision review decisions.
  APPROVE
  REJECT
  OVERRIDE
  // Phase 10 — audited byte-exposing reads (quarantine screening preview).
  // The only audited READ so far: sample frames of a QUARANTINED upload
  // served in-memory to a `video-asset:screen` holder so the screening
  // decision is informed, not blind. Ordinary metadata reads stay unaudited.
  READ
  // Phase 6 — payment lifecycle. Intent creation reuses CREATE; these cover
  // the state-machine transitions that have no generic equivalent.
  AUTHORIZE
  CAPTURE
  VOID
  FAIL
  RECONCILE
  // Phase 25 — pricing. PRICE_CHANGE marks the activation of a price book
  // version (the moment prices actually change for shoppers); ROLLBACK marks
  // a version created by copying an earlier one forward. Creating a book or a
  // draft version is an ordinary CREATE, and editing draft entries an UPDATE.
  PRICE_CHANGE
  ROLLBACK
  // Phase 29 — loyalty and promotions. PROMOTION_CHANGE marks the activation
  // of a promotion version (the moment a discount starts or stops applying);
  // POINTS_MOVEMENT marks an append to a loyalty account's points ledger.
  // Creating a promotion or a draft version is an ordinary CREATE, editing
  // draft rules an UPDATE, and a promotion rollback reuses ROLLBACK.
  PROMOTION_CHANGE
  POINTS_MOVEMENT
  // Phase 31 — procurement. RECEIVE marks a posted goods receipt (the moment
  // stock is admitted through the ledger). Creating or submitting a purchase
  // order is an ordinary CREATE/UPDATE, and cancelling one reuses CANCEL.
  RECEIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

// Quantities are INTEGERS in the product's unit of measure. Products sold by
// weight/volume declare a base unit that keeps integer counts expressive
// (GRAM, MILLILITER) — there are no fractional stock quantities anywhere in
// the ledger, which keeps stock math exact (no float/decimal drift).
enum UnitOfMeasure {
  EACH
  PACK
  BOX
  CASE
  PAIR
  GRAM
  MILLILITER
}

enum BarcodeFormat {
  EAN13
  EAN8
  UPC_A
  UPC_E
  CODE128
  CODE39
  QR
  OTHER
}

// Ledger event types. Phase 3 shipped manual adjustments; Phase 5 adds SALE
// (checkout completion). Later phases append more values (RECEIPT, TRANSFER,
// ...) — the ledger shape (signed delta + snapshot + reference fields) is
// already sized for them.
enum InventoryMovementType {
  ADJUSTMENT
  SALE
  // Operator-recorded external movements (pickup-lab setup workflow):
  // stock arriving (RECEIPT) and signed count corrections. Same append-only
  // ledger + projection invariants as ADJUSTMENT; idempotent by external
  // reference at the service layer.
  RECEIPT
  CORRECTION_IN
  CORRECTION_OUT
  // Phase 27 — the reverse flow. RETURN_IN puts goods back on the shelf when
  // an order is returned or a settled order is cancelled (the mirror of the
  // SALE that took them off it). SHRINK writes off stock that a camera saw
  // leave without ever being paid for. Both are ORDINARY ledger movements:
  // same append-only table, same signed delta, same projection increment —
  // the reverse flow never edits a stock level.
  //
  // Cycle-count variance deliberately does NOT get its own type: a count that
  // disagrees with the projection is a signed count correction, which is
  // exactly what CORRECTION_IN / CORRECTION_OUT already mean.
  RETURN_IN
  SHRINK
}

// ---------------------------------------------------------------------------
// Phase 4 — stores (Location), autonomous retail units, devices.
// ---------------------------------------------------------------------------

enum RetailUnitType {
  SMART_FRIDGE
  SMART_SHELF
  KIOSK
  VENDING_MACHINE
  MICRO_MARKET
  SMART_GATE
  OTHER
}

enum RetailUnitStatus {
  DRAFT
  ACTIVE
  MAINTENANCE
  DISABLED
  RETIRED
}

enum DeviceType {
  CAMERA
  DOOR_LOCK
  SHELF_SENSOR
  WEIGHT_SENSOR
  PAYMENT_TERMINAL
  EDGE_GATEWAY
  TEMPERATURE_SENSOR
  OTHER
}

enum DeviceStatus {
  PROVISIONED
  ONLINE
  OFFLINE
  MAINTENANCE
  DISABLED
  RETIRED
}

model Tenant {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  status            TenantStatus @default(PENDING)
  settings          Json?
  /// VERIFIED platform-sandbox identity: set exclusively by the sandbox
  /// seeder, never by the tenant-creation API. Platform users resolve
  /// their request context ONLY to a tenant carrying this marker — a
  /// customer tenant squatting the reserved slug can never be resolved.
  isPlatformSandbox Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users     User[]
  roles     Role[]
  locations Location[]
  modules   TenantModule[]
  auditLogs AuditLog[]

  productCategories     ProductCategory[]
  brands                Brand[]
  products              Product[]
  productBarcodes       ProductBarcode[]
  inventoryLevels       InventoryLevel[]
  inventoryMovements    InventoryMovement[]
  retailUnits           RetailUnit[]
  devices               Device[]
  checkoutSessions      CheckoutSession[]
  checkoutSessionLines  CheckoutSessionLine[]
  orders                Order[]
  orderLines            OrderLine[]
  evidenceBundles       EvidenceBundle[]
  visionEvents          VisionEvent[]
  visionEventCandidates VisionEventCandidate[]
  visionEventReviews    VisionEventReview[]

  paymentIntents               PaymentIntent[]
  paymentAuthorizations        PaymentAuthorization[]
  paymentCaptures              PaymentCapture[]
  paymentEvents                PaymentEvent[]
  paymentReconciliationRecords PaymentReconciliationRecord[]

  inferenceJobs       InferenceJob[]
  inferenceResults    InferenceResult[]
  inferenceCandidates InferenceCandidate[]

  videoAssets                    VideoAsset[]
  videoArtifacts                 VideoArtifact[]
  productReferenceImages         ProductReferenceImage[]
  videoGroundTruths              VideoGroundTruth[]
  productReferenceEmbeddings     ProductReferenceEmbedding[]
  pickupFusionRuns               PickupFusionRun[]
  customerJourneys               CustomerJourney[]
  customerJourneyEvents          CustomerJourneyEvent[]
  customerJourneyEventReviews    CustomerJourneyEventReview[]
  videoExtractionRequests        VideoExtractionRequest[]
  cameraSources                  CameraSource[]
  cameraPilotRuns                CameraPilotRun[]
  liveCameraSessions             LiveCameraSession[]
  liveSessionFinalizationIntents LiveCameraSessionFinalizationIntent[]
  pilotEvaluationRuns            PilotEvaluationRun[]
  cvTestProtocols                CvTestProtocol[]
  cvTestProtocolScenarios        CvTestProtocolScenario[]
  pilotEvaluationSessions        PilotEvaluationSession[]
  pilotObservationReviews        PilotObservationReview[]
  cameraCalibrationProfiles      CameraCalibrationProfile[]
  cameraCalibrationZones         CameraCalibrationZone[]
  cameraCalibrationZoneProducts  CameraCalibrationZoneProduct[]
  cvDatasetImprovementRuns       CvDatasetImprovementRun[]
  cvDatasetCandidates            CvDatasetCandidate[]
  planogramRacks                 PlanogramRack[]
  planogramCellAssignments       PlanogramCellAssignment[]
  pretrainedVisionRuns           PretrainedVisionRun[]

  priceBooks        PriceBook[]
  priceBookVersions PriceBookVersion[]
  priceBookEntries  PriceBookEntry[]

  shoppers                Shopper[]
  storeEntryTokens        StoreEntryToken[]
  storeFlowPolicies       StoreFlowPolicy[]
  storeFlowPolicyVersions StoreFlowPolicyVersion[]
  storeFlowProjections    StoreFlowProjection[]
  paymentRefunds          PaymentRefund[]
  orderReturns            OrderReturn[]
  orderReturnLines        OrderReturnLine[]
  cycleCounts             CycleCount[]
  cycleCountLines         CycleCountLine[]
  shrinkEvents            ShrinkEvent[]
  eslGateways             EslGateway[]
  eslLabels               EslLabel[]
  eslUpdateJobs           EslUpdateJob[]
  loyaltyAccounts         LoyaltyAccount[]
  loyaltyPointMovements   LoyaltyPointMovement[]
  promotions              Promotion[]
  promotionVersions       PromotionVersion[]
  promotionRules          PromotionRule[]
  suppliers               Supplier[]
  supplierProducts        SupplierProduct[]
  supplierProductCosts    SupplierProductCost[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderLines      PurchaseOrderLine[]
  goodsReceipts           GoodsReceipt[]
  goodsReceiptLines       GoodsReceiptLine[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String?
  userType     UserType
  email        String     @unique
  firstName    String
  lastName     String
  status       UserStatus @default(INVITED)
  // Nullable: users may authenticate via future providers (SSO/OIDC/OTP)
  // and never hold a local credential. Never plaintext. Only AuthRepository
  // may load this column — every non-auth user query goes through
  // SAFE_USER_SELECT (users.repository.ts), which omits it; audit snapshot
  // redaction and toSafeUser() are additional layers, not the only ones.
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant                      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles                   UserRole[]
  auditLogs                   AuditLog[]            @relation("AuditActor")
  inventoryMovements          InventoryMovement[]   @relation("InventoryMovementActor")
  checkoutSessionsCreated     CheckoutSession[]     @relation("CheckoutSessionActor")
  checkoutSessionLinesCreated CheckoutSessionLine[] @relation("CheckoutSessionLineActor")
  ordersCreated               Order[]               @relation("OrderActor")
  orderLinesCreated           OrderLine[]           @relation("OrderLineActor")
  evidenceBundlesCreated      EvidenceBundle[]      @relation("EvidenceBundleActor")
  visionEventsCreated         VisionEvent[]         @relation("VisionEventActor")
  visionEventReviews          VisionEventReview[]   @relation("VisionEventReviewer")

  paymentIntentsCreated        PaymentIntent[]               @relation("PaymentIntentActor")
  paymentAuthorizationsCreated PaymentAuthorization[]        @relation("PaymentAuthorizationActor")
  paymentCapturesCreated       PaymentCapture[]              @relation("PaymentCaptureActor")
  paymentEventsCreated         PaymentEvent[]                @relation("PaymentEventActor")
  paymentReconciliationCreated PaymentReconciliationRecord[] @relation("PaymentReconciliationActor")

  inferenceJobsCreated InferenceJob[] @relation("InferenceJobActor")

  videoAssetsUploaded   VideoAsset[]    @relation("VideoAssetUploader")
  videoArtifactsCreated VideoArtifact[] @relation("VideoArtifactActor")

  priceBooksCreated          PriceBook[]        @relation("PriceBookActor")
  priceBookVersionsCreated   PriceBookVersion[] @relation("PriceBookVersionActor")
  priceBookVersionsActivated PriceBookVersion[] @relation("PriceBookVersionActivator")

  shopperIdentity                Shopper[]                @relation("ShopperUser")
  storeEntryTokensIssued         StoreEntryToken[]        @relation("StoreEntryTokenIssuer")
  storeFlowPoliciesCreated       StoreFlowPolicy[]        @relation("StoreFlowPolicyActor")
  storeFlowPolicyVersionsCreated StoreFlowPolicyVersion[] @relation("StoreFlowPolicyVersionActor")
  paymentRefundsCreated          PaymentRefund[]          @relation("PaymentRefundActor")
  orderReturnsRecorded           OrderReturn[]            @relation("OrderReturnActor")
  cycleCountsOpened              CycleCount[]             @relation("CycleCountActor")
  cycleCountsReconciled          CycleCount[]             @relation("CycleCountReconciler")
  shrinkEventsRecorded           ShrinkEvent[]            @relation("ShrinkEventActor")
  eslGatewaysCreated             EslGateway[]             @relation("EslGatewayActor")
  eslLabelsCreated               EslLabel[]               @relation("EslLabelActor")
  eslUpdateJobsCreated           EslUpdateJob[]           @relation("EslUpdateJobActor")
  loyaltyAccountsCreated         LoyaltyAccount[]         @relation("LoyaltyAccountActor")
  loyaltyPointMovementsCreated   LoyaltyPointMovement[]   @relation("LoyaltyPointMovementActor")
  promotionsCreated              Promotion[]              @relation("PromotionActor")
  promotionVersionsCreated       PromotionVersion[]       @relation("PromotionVersionActor")
  promotionVersionsActivated     PromotionVersion[]       @relation("PromotionVersionActivator")
  suppliersCreated               Supplier[]               @relation("SupplierActor")
  supplierProductsCreated        SupplierProduct[]        @relation("SupplierProductActor")
  supplierProductCostsRecorded   SupplierProductCost[]    @relation("SupplierProductCostActor")
  purchaseOrdersCreated          PurchaseOrder[]          @relation("PurchaseOrderActor")
  purchaseOrdersSubmitted        PurchaseOrder[]          @relation("PurchaseOrderSubmitter")
  goodsReceiptsReceived          GoodsReceipt[]           @relation("GoodsReceiptActor")

  // Composite FK target for same-tenant creator constraints (id alone is
  // already unique; this adds nothing semantically, only an FK anchor).
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  // System roles (tenantId NULL) get a partial unique index in migration SQL,
  // because Postgres treats NULLs as distinct in this composite unique.
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  // Denormalized from Role for join-free tenant isolation filtering.
  // Invariant (service layer): tenantId === role.tenantId.
  tenantId     String?
  assignedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([tenantId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Location {
  id        String         @id @default(cuid())
  tenantId  String
  name      String
  code      String
  type      LocationType
  status    LocationStatus @default(ACTIVE)
  timezone  String         @default("UTC")
  address   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  inventoryLevels           InventoryLevel[]
  inventoryMovements        InventoryMovement[]
  retailUnits               RetailUnit[]
  checkoutSessions          CheckoutSession[]
  orders                    Order[]
  visionEvents              VisionEvent[]
  inferenceJobs             InferenceJob[]
  videoAssets               VideoAsset[]
  customerJourneys          CustomerJourney[]
  cameraSources             CameraSource[]
  pilotEvaluationRuns       PilotEvaluationRun[]
  cvTestProtocols           CvTestProtocol[]
  cameraCalibrationProfiles CameraCalibrationProfile[]
  planogramRacks            PlanogramRack[]
  priceBooks                PriceBook[]
  storeEntryTokens          StoreEntryToken[]
  storeFlowPolicies         StoreFlowPolicy[]
  cycleCounts               CycleCount[]
  shrinkEvents              ShrinkEvent[]
  eslGateways               EslGateway[]
  promotions                Promotion[]
  purchaseOrders            PurchaseOrder[]

  @@unique([tenantId, code])
  // Enables the composite tenant-integrity FKs added in migration SQL
  // (inventory rows must reference a location of the SAME tenant).
  @@unique([id, tenantId])
  @@index([tenantId, type])
}

model PlatformModule {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  isActive      Boolean  @default(true)
  defaultConfig Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantModules TenantModule[]
}

model TenantModule {
  id         String       @id @default(cuid())
  tenantId   String
  moduleId   String
  status     ModuleStatus @default(ENABLED)
  config     Json?
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  module PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, moduleId])
  @@index([moduleId])
}

// Append-only: no updatedAt, no update/delete repository methods, and
// migration-SQL triggers reject UPDATE/DELETE/TRUNCATE at the database level.
// Because rows are immutable, FKs must never require mutating them: both
// relations are Restrict/NoAction (a SetNull or cascading update would be
// rejected by the append-only trigger and break the referencing operation).
// Users are never hard-deleted while audit rows reference them — lifecycle is
// status-driven (DEACTIVATED), per the platform's audit retention model.
model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?
  actorId    String?
  // Point-in-time snapshot of the actor's email at write time.
  actorEmail String
  action     AuditAction
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — product catalog & inventory foundation.
//
// Every model below is tenant-owned (tenantId required, accessed only through
// TenantScopedRepository subclasses). Migration SQL additionally adds
// composite foreign keys — e.g. (productId, tenantId) → Product(id, tenantId)
// — so a row can never reference another tenant's product/location/category
// even if a repository bug slipped an unscoped id through.
// ---------------------------------------------------------------------------

model ProductCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  // Optional single-parent hierarchy within the same tenant.
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, parentId])
}

model Brand {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
}

model Product {
  id                String        @id @default(cuid())
  tenantId          String
  // Stock-keeping unit code, unique per tenant, normalized to uppercase.
  sku               String
  name              String
  description       String?
  // OCR/text-evidence catalog fields (pickup-fusion-v2): the Arabic
  // display/label name and free-form aliases the label may carry. Optional;
  // maintained through the same catalog ingestion path as everything else.
  nameArabic        String?
  aliases           String[]      @default([])
  categoryId        String?
  brandId           String?
  unitOfMeasure     UnitOfMeasure @default(EACH)
  status            ProductStatus @default(DRAFT)
  // When set, inventory reads flag levels with quantity <= threshold as low
  // stock. Product-wide (per-location overrides are a later phase).
  lowStockThreshold Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)

  barcodes                    ProductBarcode[]
  inventoryLevels             InventoryLevel[]
  inventoryMovements          InventoryMovement[]
  checkoutSessionLines        CheckoutSessionLine[]
  orderLines                  OrderLine[]
  visionEventCandidates       VisionEventCandidate[]
  visionReviewsApplied        VisionEventReview[]            @relation("VisionReviewAppliedProduct")
  referenceImages             ProductReferenceImage[]
  groundTruths                VideoGroundTruth[]
  referenceEmbeddings         ProductReferenceEmbedding[]
  journeyEvents               CustomerJourneyEvent[]
  journeyEventReviews         CustomerJourneyEventReview[]   @relation("JourneyReviewCorrectedProduct")
  pilotReviewExpectations     PilotObservationReview[]       @relation("PilotReviewExpectedProduct")
  bootstrapEvaluationRuns     PilotEvaluationRun[]           @relation("PilotRunBootstrapProduct")
  planogramCellAssignments    PlanogramCellAssignment[]
  cvScenarioExpectations      CvTestProtocolScenario[]       @relation("CvScenarioExpectedProduct")
  calibrationZoneExpectations CameraCalibrationZoneProduct[] @relation("CameraCalibrationZoneExpectedProduct")
  priceBookEntries            PriceBookEntry[]
  orderReturnLines            OrderReturnLine[]
  cycleCountLines             CycleCountLine[]
  shrinkEvents                ShrinkEvent[]
  eslLabels                   EslLabel[]
  promotionRules              PromotionRule[]
  supplierProducts            SupplierProduct[]
  purchaseOrderLines          PurchaseOrderLine[]
  goodsReceiptLines           GoodsReceiptLine[]

  @@unique([tenantId, sku])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([tenantId, name])
}

model ProductBarcode {
  id        String        @id @default(cuid())
  tenantId  String
  productId String
  // Scanned value; a barcode resolves to exactly one product per tenant.
  value     String
  format    BarcodeFormat @default(OTHER)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, value])
  @@index([productId])
}

// Pickup-detection reference image for one catalog product. The row is
// METADATA + an internal storage key — the API serves bytes only through
// the authenticated image endpoint and never exposes the key (same rule as
// VideoAsset/VideoArtifact). A product is INFERENCE-READY only when it has
// at least PICKUP_MIN_REFERENCE_IMAGES (5) of these.
model ProductReferenceImage {
  id               String   @id @default(cuid())
  tenantId         String
  productId        String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  storageKey       String
  createdById      String?
  createdAt        DateTime @default(now())

  tenant     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  embeddings ProductReferenceEmbedding[]

  // Anchor for hand-written same-tenant composite FKs
  // (20260811110000_cv_same_tenant_fks).
  @@unique([id, tenantId])
  @@unique([tenantId, productId, checksumSha256])
  @@index([tenantId, productId])
}

// Versioned visual descriptor of ONE reference image (pickup-fusion-v2
// retrieval index). One row per (image, modelKey) so a new embedding model
// backfills alongside the old instead of overwriting it; deleting the
// reference image cascades its vectors away.
model ProductReferenceEmbedding {
  id               String   @id @default(cuid())
  tenantId         String
  referenceImageId String
  productId        String
  modelKey         String
  modelVersion     String
  // L2-normalized Float array (small dimensionality) as JSON.
  vector           Json
  createdAt        DateTime @default(now())

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  referenceImage ProductReferenceImage @relation(fields: [referenceImageId], references: [id], onDelete: Cascade)

  @@unique([referenceImageId, modelKey])
  @@index([tenantId, modelKey])
  @@index([tenantId, productId])
}

// ---------------------------------------------------------------------------
// Customer journey SKELETON (shadow mode): a shopper's visit as an
// append-only event stream. The provisional basket is a FOLD over these
// events — never a checkout-session, order, payment, or inventory write.
// ---------------------------------------------------------------------------

enum CustomerJourneyStatus {
  OPEN
  EXITED
  RECONCILED
  REVIEW_REQUIRED
}

enum CustomerJourneyEventType {
  ENTRY
  EXIT
  SHELF_INTERACTION
  PRODUCT_PICKUP
  PRODUCT_RETURN
  REVIEW_REQUIRED
}

// Phase 11 — the final SHADOW decision of an exited journey. "SETTLE" is
// deliberately suffixed _SHADOW: no settlement exists; the decision is a
// recorded conclusion, never a trigger for checkout/order/payment writes.
enum CustomerJourneyDecision {
  READY_TO_SETTLE_SHADOW
  NEEDS_EVENT_REVIEW
  NEEDS_JOURNEY_REVIEW
  FAILED
}

// Phase 11 — reviewer decision over ONE journey event. CORRECT replaces
// the event's contribution to the fold (product/quantity/kind) without
// ever rewriting the observation row itself.
enum JourneyEventReviewDecision {
  APPROVE
  REJECT
  CORRECT
}

model CustomerJourney {
  id                String                    @id @default(cuid())
  tenantId          String
  locationId        String
  unitId            String?
  status            CustomerJourneyStatus     @default(OPEN)
  /// Phase 26 — commerce binding. A journey opened by the store-flow entry
  /// path carries the shopper it belongs to, the checkout session its
  /// observations fold into, and (after settlement) the order it became.
  /// All three stay NULL for the shadow journeys every earlier phase opens,
  /// so nothing about those changes.
  shopperId         String?
  checkoutSessionId String?                   @unique
  orderId           String?                   @unique
  /// How far the store-flow settlement pipeline has taken this journey.
  /// NOT_STARTED for every journey that is not store-flow owned.
  settlementStatus  StoreFlowSettlementStatus @default(NOT_STARTED)
  // Phase 11 — final shadow decision, set at exit reconciliation and
  // recomputed after each event review. Null while the journey is OPEN.
  decision          CustomerJourneyDecision?
  decisionReason    String?
  decidedAt         DateTime?
  startedAt         DateTime                  @default(now())
  endedAt           DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location             Location                     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit                 RetailUnit?                  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  shopper              Shopper?                     @relation(fields: [shopperId], references: [id], onDelete: Restrict)
  checkoutSession      CheckoutSession?             @relation("StoreFlowJourneySession", fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  order                Order?                       @relation("StoreFlowJourneyOrder", fields: [orderId], references: [id], onDelete: Restrict)
  entryToken           StoreEntryToken?             @relation("StoreEntryTokenJourney")
  storeFlowProjections StoreFlowProjection[]
  events               CustomerJourneyEvent[]
  eventReviews         CustomerJourneyEventReview[]
  cameraPilotRuns      CameraPilotRun[]
  liveCameraSessions   LiveCameraSession[]

  // Anchor for hand-written same-tenant composite FKs
  // (20260811110000_cv_same_tenant_fks).
  @@unique([id, tenantId])
  @@index([tenantId, status, startedAt(sort: Desc)])
  @@index([tenantId, shopperId, startedAt(sort: Desc)])
  @@index([tenantId, settlementStatus])
}

// APPEND-ONLY (service discipline; no update path exists): what the CV
// shadow pipeline OBSERVED, one row per observation. productId is the
// canonical link; sku/productName snapshots keep rows meaningful even if
// the catalog renames later.
model CustomerJourneyEvent {
  id           String                   @id @default(cuid())
  tenantId     String
  journeyId    String
  eventType    CustomerJourneyEventType
  occurredAt   DateTime
  productId    String?
  sku          String?
  productName  String?
  quantity     Int                      @default(1)
  /**
   * Uncalibrated score carried from the producing shadow pipeline.
   */
  matchScore   Float?
  sourceType   String                   @default("MANUAL")
  videoAssetId String?
  fusionRunId  String?
  note         String?
  createdById  String?
  createdAt    DateTime                 @default(now())

  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journey              CustomerJourney              @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  product              Product?                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  reviews              CustomerJourneyEventReview[]
  pilotReviews         PilotObservationReview[]
  storeFlowProjections StoreFlowProjection[]

  // Anchor for the review table's same-tenant composite FK (Phase 11).
  @@unique([id, tenantId])
  @@index([tenantId, journeyId, occurredAt])
}

// Phase 11 — APPEND-ONLY (DB triggers reject UPDATE/DELETE, same
// hardening as VisionEventReview): what a human reviewer decided about
// one journey observation. The observation row is never rewritten — the
// basket fold applies the LATEST review per event on read. Every write
// lands with an AuditLog row in the same transaction. No review path
// touches checkout, order, payment, or inventory tables.
model CustomerJourneyEventReview {
  id                   String                     @id @default(cuid())
  tenantId             String
  journeyId            String
  eventId              String
  decision             JourneyEventReviewDecision
  // CORRECT payload: what the fold should count instead. Snapshots keep
  // the correction meaningful if the catalog renames later. CHECK
  // constraints in migration SQL: CORRECT requires product + quantity;
  // APPROVE/REJECT must carry none; correctedEventType is restricted to
  // PRODUCT_PICKUP / PRODUCT_RETURN.
  correctedEventType   CustomerJourneyEventType?
  correctedProductId   String?
  correctedSku         String?
  correctedProductName String?
  correctedQuantity    Int?
  reason               String?
  reviewedById         String?
  // Client-supplied replay token: a retried POST with the same key returns
  // the existing review instead of appending a second immutable record of
  // the same human action. Unique per (tenant, event); NULLs (no key) are
  // distinct, preserving plain append-only behavior.
  idempotencyKey       String?
  createdAt            DateTime                   @default(now())

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journey          CustomerJourney      @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  event            CustomerJourneyEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  correctedProduct Product?             @relation("JourneyReviewCorrectedProduct", fields: [correctedProductId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, eventId, idempotencyKey])
  @@index([tenantId, journeyId, createdAt])
  @@index([tenantId, eventId, createdAt])
}

enum FusionPolicyResult {
  AUTO_PROPOSE
  NEEDS_VLM
  NEEDS_HUMAN_REVIEW
  UNKNOWN_PRODUCT
  FAILED
}

// Phase 12 — what a fusion run analyzed. WHOLE_CLIP runs are the unit of
// ground-truthed evaluation (validation dashboard, accuracy, confusion);
// REPLAY_WINDOW runs analyze one extracted event window of a camera
// replay and are EXCLUDED from whole-clip metrics so a pilot replay can
// never displace the evaluation result of its underlying test video.
enum FusionRunScope {
  WHOLE_CLIP
  REPLAY_WINDOW
  // Phase 13 — one live-sampled event window of an RTSP shadow session.
  // Like REPLAY_WINDOW, excluded from every whole-clip evaluation
  // surface (those filter WHOLE_CLIP explicitly).
  LIVE_WINDOW
}

// One pickup-fusion-v2 SHADOW run over a test video: full per-stage
// evidence (timeline/tracks, crops + quality, barcode, OCR, retrieval,
// classical, context, fused candidates, VLM exchange, per-stage timings)
// as safe-descriptor JSON. Deliberately DISCONNECTED from billing,
// checkout sessions, and vision events — CV proposes, this table records.
model PickupFusionRun {
  id              String             @id @default(cuid())
  tenantId        String
  // Nullable since Phase 13: a LIVE_WINDOW run analyzes frames sampled
  // straight from a live session — there is no video asset. Exactly one
  // of videoAssetId / liveSessionId is set (CHECK in migration SQL).
  videoAssetId    String?
  liveSessionId   String?
  pipelineVersion String
  runScope        FusionRunScope     @default(WHOLE_CLIP)
  policy          FusionPolicyResult
  fusedTopSku     String?
  fusedTopScore   Float?
  scoreMargin     Float?
  evidence        Json
  processingMs    Int
  createdAt       DateTime           @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  videoAsset  VideoAsset?        @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  liveSession LiveCameraSession? @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)

  @@index([tenantId, videoAssetId, createdAt(sort: Desc)])
  @@index([tenantId, liveSessionId, createdAt(sort: Desc)])
}

// What ACTUALLY happened in one controlled test video — operator-entered
// ground truth the validation dashboard scores detections against. One row
// per asset (upsert semantics); NONE means "no pickup occurs in this clip".
enum GroundTruthEventKind {
  PICKUP
  RETURN
  NONE
}

// Phase 11 — which CONTROLLED test scenario a ground-truthed clip
// exercises, so the evaluation dashboard can break accuracy down per
// test type. The two VLM_* scenarios are fault-injection drills (via
// PICKUP_VLM_FAULT) proving the pipeline degrades safely.
enum CvTestScenario {
  PICKUP_SINGLE
  RETURN_SINGLE
  FALSE_TOUCH
  TWO_SIMILAR_PICK_ONE
  TWO_VISIBLE_PICK_ONE
  VLM_UNAVAILABLE
  VLM_INVALID_SKU
}

model VideoGroundTruth {
  id                String               @id @default(cuid())
  tenantId          String
  videoAssetId      String               @unique
  eventKind         GroundTruthEventKind
  testType          CvTestScenario?
  productId         String?
  actualTimestampMs Int?
  quantity          Int                  @default(1)
  note              String?
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, videoAssetId])
  @@index([tenantId, productId])
}

// ---------------------------------------------------------------------------
// Phase 12 — edge camera replay runtime (SHADOW pilot).
//
// A CameraSource names where footage comes from; a CameraPilotRun records
// one auditable replay of a video asset through the existing shadow
// pipeline (event windows → crops → pickup detection → fusion → VLM →
// journey import → reconciliation). Only FILE_REPLAY is functional; RTSP
// and webcam are registered placeholders. NOTHING here touches checkout,
// order, payment, or inventory tables.
// ---------------------------------------------------------------------------

enum CameraSourceType {
  FILE_REPLAY
  RTSP_PLACEHOLDER
  LOCAL_WEBCAM_PLACEHOLDER
  // Phase 13 — the first LIVE source type, still shadow-only. Activation
  // requires a server-recognized credential slot; the actual stream URL
  // lives ONLY in operator-managed runtime configuration
  // (CAMERA_RTSP_SOURCE_<SLOT>), never in this database and never in an
  // API response. The two _PLACEHOLDER types keep their Phase 12
  // can-never-activate rule unchanged.
  RTSP_SHADOW
}

enum CameraSourceStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum CameraPilotRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model CameraSource {
  id                 String             @id @default(cuid())
  tenantId           String
  locationId         String
  unitId             String?
  name               String
  shelfZone          String?
  sourceType         CameraSourceType
  status             CameraSourceStatus @default(ACTIVE)
  // SAFE metadata only. connectionNote is screened free text (reject-on-
  // write, same policy as journey notes) — a URL with embedded
  // credentials never passes. credentialRef is the NAME of an
  // operator-managed secret slot (validated identifier), NEVER the
  // secret itself; responses expose only whether one is configured.
  connectionNote     String?
  credentialRef      String?
  // FILE_REPLAY: the default video asset this source replays.
  replayVideoAssetId String?
  lastError          String?
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location            Location                   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit                RetailUnit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  replayVideoAsset    VideoAsset?                @relation("CameraReplayAsset", fields: [replayVideoAssetId], references: [id], onDelete: SetNull)
  pilotRuns           CameraPilotRun[]
  liveSessions        LiveCameraSession[]
  cvTestProtocols     CvTestProtocol[]
  calibrationProfiles CameraCalibrationProfile[]
  calibrationZones    CameraCalibrationZone[]

  @@unique([id, tenantId])
  @@unique([tenantId, locationId, name])
  @@index([tenantId, status])
}

// One auditable replay run. Counters and stage timings are written by the
// runtime as it advances; eventWindows/errors hold controlled descriptor
// JSON only (timestamps, scores, stage names — never media bytes, OCR
// text, or free text from evidence).
model CameraPilotRun {
  id                     String                   @id @default(cuid())
  tenantId               String
  cameraSourceId         String
  videoAssetId           String
  journeyId              String?
  status                 CameraPilotRunStatus     @default(RUNNING)
  frameIntervalMs        Int
  framesProcessed        Int                      @default(0)
  // Windows the heuristics DETECTED vs windows the pipeline PROCESSED —
  // a failed window leaves the gap visible. Crop FRAMES (pre/peak/post
  // evidence) are counted separately from clip ARTIFACTS; Phase 12
  // generates no clip artifacts, so that counter stays 0 honestly.
  eventWindowsDetected   Int                      @default(0)
  eventWindowsProcessed  Int                      @default(0)
  cropFramesGenerated    Int                      @default(0)
  clipArtifactsGenerated Int                      @default(0)
  fusionRunsCompleted    Int                      @default(0)
  vlmInvoked             Int                      @default(0)
  vlmSkipped             Int                      @default(0)
  vlmFailed              Int                      @default(0)
  journeyEventsCreated   Int                      @default(0)
  reviewNeeded           Int                      @default(0)
  // Snapshot of the linked journey's final SHADOW decision at run end.
  decision               CustomerJourneyDecision?
  eventWindows           Json?
  stageTimings           Json?
  errors                 Json?
  // Client replay token: a retried run request with the same key returns
  // the existing run instead of replaying the footage twice.
  idempotencyKey         String?
  startedAt              DateTime                 @default(now())
  // Lease heartbeat + owner: the heartbeat is bumped PERIODICALLY while a
  // stage runs (not merely between stages), and every heartbeat and
  // finalization write is conditional on status=RUNNING AND the owner
  // token — a reclaimed or completed row can never be overwritten by an
  // attempt that lost its lease.
  heartbeatAt            DateTime?
  leaseOwner             String?
  finishedAt             DateTime?
  createdById            String?
  createdAt              DateTime                 @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cameraSource CameraSource     @relation(fields: [cameraSourceId], references: [id], onDelete: Restrict)
  videoAsset   VideoAsset       @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  journey      CustomerJourney? @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, cameraSourceId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Phase 13 — live RTSP shadow sessions.
//
// One row per start of a live camera: an auditable record of what the
// sampler saw and what the shadow pipeline made of it. The session owns
// ONE shadow journey (ENTRY at start, EXIT at stop, decision on
// reconcile); LIVE_WINDOW fusion runs link back via
// PickupFusionRun.liveSessionId. At most one non-terminal session per
// camera source (partial unique index in migration SQL). errorCode is a
// CONTROLLED code only — raw exception text is never persisted. NOTHING
// here touches checkout, order, payment, or inventory tables.
// ---------------------------------------------------------------------------

enum LiveCameraSessionStatus {
  STARTING
  RUNNING
  STOPPING
  STOPPED
  ERROR
}

model LiveCameraSession {
  id                    String                   @id @default(cuid())
  tenantId              String
  cameraSourceId        String
  journeyId             String?
  status                LiveCameraSessionStatus  @default(STARTING)
  frameIntervalMs       Int
  startedAt             DateTime                 @default(now())
  stoppedAt             DateTime?
  // Lease heartbeat + owner, same discipline as CameraPilotRun: bumped
  // periodically while sampling; every heartbeat and finalization write
  // is conditional on (non-terminal status AND owner token).
  heartbeatAt           DateTime?
  leaseOwner            String?
  lastFrameAt           DateTime?
  framesSampled         Int                      @default(0)
  eventWindowsDetected  Int                      @default(0)
  eventWindowsProcessed Int                      @default(0)
  fusionRunsCompleted   Int                      @default(0)
  journeyEventsCreated  Int                      @default(0)
  vlmInvoked            Int                      @default(0)
  vlmSkipped            Int                      @default(0)
  vlmFailed             Int                      @default(0)
  reviewNeeded          Int                      @default(0)
  // Snapshot of the linked journey's final SHADOW decision at stop.
  decision              CustomerJourneyDecision?
  errorCode             String?
  // Parked-finalization MODE ('STOP' | 'ERROR', DB CHECK) — recorded when
  // a finalization parks retryably so the retry re-enters with the SAME
  // journey-closure semantics (exit vs abort). NEVER derived from an
  // intent reason or the advisory errorCode (Codex P1: a marker-append
  // failure must not convert an ERROR finalization into a clean STOP).
  finalizationMode      String?
  eventWindows          Json?
  // Phase 14 — per-stage timing statistics (p50/p95/max/avg/count per
  // pipeline stage) written by the sampling loop. OBSERVABILITY ONLY:
  // controlled numeric aggregates, never URLs, credentials, pixels, or
  // free text; never read by any decision path.
  performance           Json?
  createdById           String?
  createdAt             DateTime                 @default(now())

  tenant                  Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cameraSource            CameraSource                          @relation(fields: [cameraSourceId], references: [id], onDelete: Restrict)
  journey                 CustomerJourney?                      @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  fusionRuns              PickupFusionRun[]
  finalizationIntents     LiveCameraSessionFinalizationIntent[]
  pilotEvaluationSessions PilotEvaluationSession[]
  cvTestScenarios         CvTestProtocolScenario[]

  @@unique([id, tenantId])
  @@index([tenantId, cameraSourceId, createdAt(sort: Desc)])
  @@index([tenantId, status])
}

// Phase 13 — DURABLE, ADDITIVE finalization intents (Codex P1): a single
// overwritable errorCode cannot carry several simultaneous fail-closed
// reasons, and a lost write could let a risky session finalize clean.
// One row per (session, reason); adding is idempotent via the unique
// pair; the finalizer must MATERIALIZE every unmaterialized intent into
// a review-required journey marker before the journey may exit, and a
// session with any intent can never conclude READY_TO_SETTLE_SHADOW.
// The reason vocabulary is CONTROLLED (service constant + DB CHECK).
model LiveCameraSessionFinalizationIntent {
  id             String    @id @default(cuid())
  tenantId       String
  liveSessionId  String
  reason         String
  createdAt      DateTime  @default(now())
  materializedAt DateTime?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  liveSession LiveCameraSession @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([liveSessionId, reason])
  @@index([tenantId, liveSessionId])
}

// DERIVED stock projection — never written directly from user input. The
// quantity changes exclusively via atomic increments inside the same
// transaction that appends the InventoryMovement ledger row (the ledger is
// the source of truth, per AGENTS.md). CHECK (quantity >= 0) in migration
// SQL backstops the application-level guard against races.
model InventoryLevel {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  productId  String
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, locationId, productId])
  @@index([tenantId, productId])
  @@index([tenantId, locationId])
}

// Phase 4 — autonomous retail unit inside a store (smart fridge, smart
// shelf, kiosk, ...). Tenant-owned; always assigned to a Location of the
// SAME tenant (composite FK in migration SQL). Deletion is Restrict-guarded:
// a unit with devices (or future inventory references) cannot be removed.
model RetailUnit {
  id         String           @id @default(cuid())
  tenantId   String
  // The store (Location) this unit lives in.
  locationId String
  // Short human-readable identifier, unique per tenant, uppercase.
  code       String
  name       String
  type       RetailUnitType
  status     RetailUnitStatus @default(DRAFT)
  // Physical placement within the store, e.g. "Aisle 3, next to entrance".
  placement  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location         Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  devices          Device[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
  visionEvents     VisionEvent[]
  inferenceJobs    InferenceJob[]
  videoAssets      VideoAsset[]
  customerJourneys CustomerJourney[]
  cameraSources    CameraSource[]
  storeEntryTokens StoreEntryToken[]

  @@unique([tenantId, code])
  // Enables composite same-tenant FKs (devices must reference a unit of the
  // SAME tenant) — mirrors the Phase 3 hardening pattern.
  @@unique([id, tenantId])
  @@index([tenantId, locationId])
  @@index([tenantId, status])
  @@index([tenantId, type])
}

// Phase 4 — physical device attached to a retail unit (camera, lock,
// sensor, gateway, ...). `metadata` holds SAFE, NON-SECRET configuration
// only — credentials/secrets must never be stored here (audit snapshots
// additionally redact credential-shaped keys as a backstop).
//
// Edge registration stores ONLY the SHA-256 hash of a one-time registration
// token; the plaintext is returned once at issuance and never persisted or
// logged. Redeeming the token (POST /edge/register) clears the hash.
model Device {
  id                         String       @id @default(cuid())
  tenantId                   String
  unitId                     String
  name                       String
  type                       DeviceType
  status                     DeviceStatus @default(PROVISIONED)
  // Hardware serial number / ID, unique per tenant. Stored as entered
  // (trimmed) — serials can be case-sensitive.
  serialNumber               String
  metadata                   Json?
  firmwareVersion            String?
  softwareVersion            String?
  // Updated by the heartbeat endpoint; never client-supplied.
  lastSeenAt                 DateTime?
  registrationTokenHash      String?      @unique
  registrationTokenExpiresAt DateTime?
  registeredAt               DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unit             RetailUnit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  checkoutSessions CheckoutSession[]
  visionEvents     VisionEvent[]
  inferenceJobs    InferenceJob[]
  videoAssets      VideoAsset[]

  @@unique([tenantId, serialNumber])
  @@unique([id, tenantId])
  @@index([tenantId, unitId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, lastSeenAt])
}

// Append-only inventory ledger: no updatedAt, no update/delete repository
// methods, and migration-SQL triggers reject UPDATE/DELETE/TRUNCATE at the
// database level (same hardening as AuditLog). All relations are Restrict/
// NoAction so no FK action can ever need to mutate a ledger row.
model InventoryMovement {
  id            String                @id @default(cuid())
  tenantId      String
  locationId    String
  productId     String
  movementType  InventoryMovementType
  // Signed change, never zero (CHECK in migration SQL).
  quantityDelta Int
  // Resulting on-hand quantity, snapshotted inside the adjustment
  // transaction — lets auditors verify the ledger replays to the level.
  quantityAfter Int
  reason        String
  // Future phases link movements to their cause (order, transfer, receipt)
  // without schema changes.
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime              @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy User?    @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // Phase 27 — the reverse-flow decision records point AT the movement they
  // produced. These are back-references only: the ledger row itself stays
  // immutable (UPDATE/DELETE/TRUNCATE triggers, since Phase 3).
  orderReturnLines OrderReturnLine[]
  cycleCountLines  CycleCountLine[]
  shrinkEvents     ShrinkEvent[]
  // Phase 31 — a posted goods receipt line points at the RECEIVE movement it
  // produced, the same back-reference shape.
  goodsReceiptLine GoodsReceiptLine?

  // Phase 27/31: anchors the same-tenant composite FKs those decision records
  // use, so a return/count/shrink/receipt can never cite another tenant's
  // movement.
  @@unique([id, tenantId])
  @@index([tenantId, locationId, productId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([productId])
  @@index([locationId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Phase 5 — checkout sessions & order foundation.
//
// Connects Phase 3 inventory and Phase 4 stores/units/devices into the first
// transaction backbone: session -> basket line -> order line -> SALE ledger
// movement. NO payment capture in this phase — pricing/total columns are
// nullable placeholders that stay NULL until the pricing/payments phases, and
// nothing here may imply an order was paid.
//
// Evidence/source fields (sourceType, sourceId, evidenceBundleId,
// visionEventId, vlmReviewId, evidenceScore, evidenceQuality, reasonCodes)
// are VENDOR-NEUTRAL lineage placeholders: future CV/VLM providers plug in
// through adapter layers that populate these normalized references. No
// camera/model/vendor-specific data is ever stored in the checkout core.
// ---------------------------------------------------------------------------

enum CheckoutSessionStatus {
  OPEN
  ACTIVE
  PENDING_REVIEW
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// Who/what produced a session, line, or order: staff acting manually, an
// admin tool, a device-originated flow, a vision pipeline (future), or the
// system itself (e.g. expiry sweeps). Deliberately generic — never a vendor
// or model name.
enum EvidenceSourceType {
  MANUAL
  ADMIN
  DEVICE
  VISION
  SYSTEM
}

enum EvidenceQuality {
  LOW
  MEDIUM
  HIGH
}

// Basket line lifecycle. Removing a line is a SOFT delete (status → REMOVED):
// the row survives as a tombstone so its tenant-scoped idempotencyKey stays
// reserved forever — a lost-response retry of the original add can never
// resurrect an intentionally removed item. REMOVED lines are excluded from
// the active basket and from completion.
enum CheckoutSessionLineStatus {
  ACTIVE
  REMOVED
}

// A shopping visit at one retail unit in one store. Lifecycle:
// OPEN -> ACTIVE -> PENDING_REVIEW -> COMPLETED, with CANCELLED/EXPIRED as
// the other terminal states. Terminal sessions are immutable except through
// the audit trail. Completion is the ONLY path that creates an Order and
// consumes stock, atomically with SALE ledger movements.
model CheckoutSession {
  id                        String                @id @default(cuid())
  tenantId                  String
  locationId                String
  unitId                    String
  // Optional source device reference (no edge runtime in Phase 5).
  deviceId                  String?
  // Phase 29 — the loyalty account this basket is being shopped under, when
  // the shopper identified themselves. NULL is the norm and means "no
  // member": member-only promotions simply do not apply, and no points are
  // accrued. It is captured when the session OPENS so a promotion decision
  // made on a line can never be changed by identifying later.
  loyaltyAccountId          String?
  status                    CheckoutSessionStatus @default(OPEN)
  startedAt                 DateTime              @default(now())
  endedAt                   DateTime?
  // Vendor-neutral evidence/source lineage (see Phase 5 header comment).
  // Since Phase 7, evidenceBundleId/visionEventId are CANONICAL references
  // to the Phase 7 EvidenceBundle/VisionEvent tables (validated at the
  // data-access layer, backstopped by same-tenant FKs in migration SQL).
  sourceType                EvidenceSourceType    @default(MANUAL)
  sourceId                  String?
  evidenceBundleId          String?
  visionEventId             String?
  // Pre-Phase-7 compatibility: opaque evidence references accepted by the
  // Phase 5 API before the canonical tables existed. Preserved verbatim by
  // the legacy_vision_ref_compat migration, NEVER resolved against Phase 7
  // tables, and not writable through the API.
  externalVisionEventRef    String?
  externalEvidenceBundleRef String?
  vlmReviewId               String?
  evidenceScore             Float?
  evidenceQuality           EvidenceQuality?
  reasonCodes               String[]              @default([])
  // Tenant-scoped idempotency for session creation: replays return the
  // original session instead of opening a duplicate.
  idempotencyKey            String?
  createdById               String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location         Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit             RetailUnit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  device           Device?               @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  createdBy        User?                 @relation("CheckoutSessionActor", fields: [createdById], references: [id], onDelete: Restrict)
  lines            CheckoutSessionLine[]
  order            Order?
  visionEvents     VisionEvent[]
  paymentIntents   PaymentIntent[]
  inferenceJobs    InferenceJob[]
  videoAssets      VideoAsset[]
  // Phase 26 — the store-flow journey whose observations fold into this
  // basket. NULL for every manually opened session.
  storeFlowJourney CustomerJourney?      @relation("StoreFlowJourneySession")
  loyaltyAccount   LoyaltyAccount?       @relation(fields: [loyaltyAccountId], references: [id], onDelete: Restrict)

  // Enables composite same-tenant FKs (lines/orders must reference a session
  // of the SAME tenant) — mirrors the Phase 3/4 hardening pattern.
  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, startedAt, id])
  @@index([tenantId, locationId])
  @@index([tenantId, unitId])
}

// Basket line: one product per session (quantity aggregates). Snapshots the
// product's sku/name/unit so completed history never rewrites when the
// catalog is edited later. Every mutation carries evidence/source lineage or
// a manual/admin actor reference.
model CheckoutSessionLine {
  id                        String                    @id @default(cuid())
  tenantId                  String
  sessionId                 String
  productId                 String
  // Product snapshot (immutable history even if the product is later edited):
  sku                       String
  productName               String
  unitOfMeasure             UnitOfMeasure
  quantity                  Int
  // Soft-delete lifecycle: REMOVED lines are tombstones that keep the
  // idempotencyKey reserved (see CheckoutSessionLineStatus above).
  status                    CheckoutSessionLineStatus @default(ACTIVE)
  removedAt                 DateTime?
  // Price snapshot, in minor currency units (integer-exact). NULL means
  // UNPRICED, never free. Since Phase 29 `unitPriceMinor` is the price the
  // shopper actually pays: the base price from a price book version, minus
  // at most one promotion. The provenance columns below make that number
  // explainable without re-deriving it — basePriceMinor is what the price
  // version said, promotionDiscountMinor is what the promotion took off, and
  // the two version ids name exactly which rows produced each part.
  unitPriceMinor            Int?
  lineTotalMinor            Int?
  currencyCode              String?
  // Phase 29 — price/promotion provenance. A promotion NEVER rewrites a
  // price version: it is recorded here as a separate, subtractive layer on
  // top of the version named by priceBookVersionId.
  priceBookVersionId        String?
  basePriceMinor            Int?
  promotionVersionId        String?
  promotionDiscountMinor    Int?
  // Vendor-neutral evidence/source lineage (same set as the session,
  // including the pre-Phase-7 external compatibility refs — see
  // CheckoutSession for the canonical-vs-external split).
  sourceType                EvidenceSourceType        @default(MANUAL)
  sourceId                  String?
  evidenceBundleId          String?
  visionEventId             String?
  externalVisionEventRef    String?
  externalEvidenceBundleRef String?
  vlmReviewId               String?
  evidenceScore             Float?
  evidenceQuality           EvidenceQuality?
  reasonCodes               String[]                  @default([])
  // Tenant-scoped idempotency for line creation replays.
  idempotencyKey            String?
  createdById               String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session            CheckoutSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceBookVersion   PriceBookVersion?   @relation("CheckoutLinePriceVersion", fields: [priceBookVersionId], references: [id], onDelete: Restrict)
  promotionVersion   PromotionVersion?   @relation("CheckoutLinePromotionVersion", fields: [promotionVersionId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("CheckoutSessionLineActor", fields: [createdById], references: [id], onDelete: Restrict)
  orderLines         OrderLine[]
  visionEventReviews VisionEventReview[]

  @@unique([id, tenantId])
  // One ACTIVE line per product per session ("adds aggregate into updates")
  // is enforced by a PARTIAL unique index in migration SQL
  // (CheckoutSessionLine_active_product_key, WHERE status = 'ACTIVE') —
  // Prisma cannot express partial indexes. REMOVED tombstones are exempt so
  // a product can be legitimately re-added after removal.
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, sessionId, createdAt, id])
  @@index([tenantId, sessionId, productId])
}

// Order foundation generated from a completed checkout session. CONFIRMED
// means inventory was consumed atomically — it does NOT mean paid/captured;
// payment status arrives in a later phase. Cancelling an order in Phase 5 is
// a status change only (stock reversal ships with the returns/refunds phase).
model Order {
  id                        String             @id @default(cuid())
  tenantId                  String
  // Human-readable, unique per tenant (ORD-000001 style).
  orderNumber               String
  // One order per session; globally unique because ids are cuids, and
  // additionally unique per tenant below (the composite same-tenant FK in
  // migration SQL keeps the pair tenant-consistent).
  checkoutSessionId         String             @unique
  locationId                String
  unitId                    String
  status                    OrderStatus        @default(CONFIRMED)
  placedAt                  DateTime           @default(now())
  confirmedAt               DateTime?
  cancelledAt               DateTime?
  cancelReason              String?
  totalQuantity             Int
  // Pricing placeholders — ALWAYS NULL until the pricing phase.
  subtotalMinor             Int?
  totalMinor                Int?
  currencyCode              String?
  // Phase 6 — payment linkage. paymentStatus is UNPAID until the internal
  // payment state machine reaches a valid captured/success state (only a
  // CAPTURED PaymentIntent flips it to PAID; a failed/voided intent NEVER
  // marks an order paid). REFUND_PENDING/REFUNDED are reserved for a later
  // returns/refunds phase (no money movement in Phase 6). paidAt is set
  // exactly when paymentStatus becomes PAID.
  paymentStatus             OrderPaymentStatus @default(UNPAID)
  paidAt                    DateTime?
  // Evidence lineage copied from the completed session (canonical Phase 7
  // refs and pre-Phase-7 external compatibility refs stay separate — see
  // CheckoutSession).
  sourceType                EvidenceSourceType @default(MANUAL)
  sourceId                  String?
  evidenceBundleId          String?
  visionEventId             String?
  externalVisionEventRef    String?
  externalEvidenceBundleRef String?
  vlmReviewId               String?
  evidenceScore             Float?
  evidenceQuality           EvidenceQuality?
  reasonCodes               String[]           @default([])
  // Tenant-scoped completion idempotency: a duplicate completion request
  // with the same key returns this order instead of creating another.
  idempotencyKey            String?
  createdById               String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session               CheckoutSession        @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  location              Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit                  RetailUnit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy             User?                  @relation("OrderActor", fields: [createdById], references: [id], onDelete: Restrict)
  lines                 OrderLine[]
  returns               OrderReturn[]
  paymentIntents        PaymentIntent[]
  // Phase 26 — the store-flow journey this order settled. NULL for orders
  // completed through the manual checkout route.
  storeFlowJourney      CustomerJourney?       @relation("StoreFlowJourneyOrder")
  loyaltyPointMovements LoyaltyPointMovement[]

  @@unique([id, tenantId])
  @@unique([tenantId, orderNumber])
  @@unique([tenantId, checkoutSessionId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, placedAt, id])
  @@index([tenantId, locationId])
}

// Order line snapshot. Copies the session line's product snapshot and
// evidence lineage at completion time, plus a sessionLineId back-reference so
// the full chain session -> basket line -> order line -> SALE movement stays
// traceable. Never updated after creation (no updatedAt by design).
model OrderLine {
  id                        String             @id @default(cuid())
  tenantId                  String
  orderId                   String
  productId                 String
  // Lineage: which basket line this order line was materialized from.
  sessionLineId             String?
  sku                       String
  productName               String
  unitOfMeasure             UnitOfMeasure
  quantity                  Int
  // Money snapshot copied verbatim from the basket line at completion. An
  // order line is never re-priced and never re-promoted: what the shopper
  // was charged stays readable for the life of the order.
  unitPriceMinor            Int?
  lineTotalMinor            Int?
  currencyCode              String?
  // Phase 29 — price/promotion provenance, copied from the basket line.
  priceBookVersionId        String?
  basePriceMinor            Int?
  promotionVersionId        String?
  promotionDiscountMinor    Int?
  // Vendor-neutral evidence/source lineage copied from the session line
  // (canonical Phase 7 refs and pre-Phase-7 external compatibility refs
  // stay separate — see CheckoutSession).
  sourceType                EvidenceSourceType @default(MANUAL)
  sourceId                  String?
  evidenceBundleId          String?
  visionEventId             String?
  externalVisionEventRef    String?
  externalEvidenceBundleRef String?
  vlmReviewId               String?
  evidenceScore             Float?
  evidenceQuality           EvidenceQuality?
  reasonCodes               String[]           @default([])
  createdById               String?
  createdAt                 DateTime           @default(now())

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  sessionLine      CheckoutSessionLine? @relation(fields: [sessionLineId], references: [id], onDelete: Restrict)
  createdBy        User?                @relation("OrderLineActor", fields: [createdById], references: [id], onDelete: Restrict)
  returnLines      OrderReturnLine[]
  priceBookVersion PriceBookVersion?    @relation("OrderLinePriceVersion", fields: [priceBookVersionId], references: [id], onDelete: Restrict)
  promotionVersion PromotionVersion?    @relation("OrderLinePromotionVersion", fields: [promotionVersionId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, orderId])
}

// ---------------------------------------------------------------------------
// Phase 6 — payment authorization, payment abstraction & reconciliation
// foundation.
//
// PROVIDER-NEUTRAL BY CONSTRUCTION. There is NO live payment gateway in this
// phase: authorization and capture are SIMULATED through the internal state
// machine, and every "provider" reference is an OPAQUE, normalized identifier
// a future gateway adapter will populate. Real adapters (and their webhook
// signature verification) arrive in a later phase — the models below are
// sized for that without schema churn.
//
// SECURITY INVARIANT (AGENTS.md): no raw card data or secrets are EVER stored,
// logged, or audited. These tables carry only opaque provider references and
// SAFE card metadata (brand, last4, expiry month/year, wallet type). Raw PAN,
// CVV, PIN, magnetic-track data, provider secret keys, bearer tokens, API
// keys, and raw webhook secrets/payloads never reach any column here — every
// free-form string that is persisted or audited is additionally screened by
// common/sensitive-keys before any write.
// ---------------------------------------------------------------------------

// Provider-neutral payment provider. SIMULATED is the built-in Phase 6
// simulator; MANUAL is a staff-recorded reference. Real gateways append
// values here through their adapter phase — no provider SDK in this phase.
enum PaymentProvider {
  SIMULATED
  MANUAL
}

// The payment intent lifecycle state machine. CREATED and
// REQUIRES_AUTHORIZATION are pre-auth; AUTHORIZED holds funds;
// CAPTURE_PENDING/CAPTURED move money (simulated). CAPTURED is the ONLY
// success terminal state that may flip an order to PAID. FAILED, CANCELLED,
// VOIDED, and EXPIRED are the terminal non-success states — nothing about a
// terminal intent may change again. Reconciliation is tracked on
// PaymentReconciliationRecord, not on this financial lifecycle.
enum PaymentStatus {
  CREATED
  REQUIRES_AUTHORIZATION
  AUTHORIZED
  CAPTURE_PENDING
  CAPTURED
  FAILED
  CANCELLED
  VOIDED
  EXPIRED
}

// Order-level payment status projection. UNPAID until the intent state
// machine reaches a valid captured/success state. REFUND_PENDING and REFUNDED
// are RESERVED placeholders — Phase 6 implements no refund money movement.
enum OrderPaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  PAYMENT_FAILED
  VOIDED
  REFUND_PENDING
  REFUNDED
}

enum PaymentAuthorizationStatus {
  AUTHORIZED
  VOIDED
  EXPIRED
}

enum PaymentCaptureStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Normalized, provider-neutral event types. A gateway adapter maps its native
// event names onto these; UNKNOWN safely records an unsupported event.
enum PaymentEventType {
  AUTHORIZATION_SUCCEEDED
  AUTHORIZATION_FAILED
  CAPTURE_SUCCEEDED
  CAPTURE_FAILED
  PAYMENT_CANCELLED
  PAYMENT_VOIDED
  PAYMENT_EXPIRED
  UNKNOWN
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  MISMATCH
  RECONCILED
  FAILED
}

// The payment intent aggregate. Tenant-owned; optionally linked to an order
// and/or checkout session of the SAME tenant (composite same-tenant FKs in
// migration SQL). An intent may be created before an order exists (walk-out:
// payment association happens before/during checkout) and later bound to one.
model PaymentIntent {
  id                    String          @id @default(cuid())
  tenantId              String
  orderId               String?
  checkoutSessionId     String?
  provider              PaymentProvider @default(SIMULATED)
  status                PaymentStatus   @default(CREATED)
  amountMinor           Int
  currencyCode          String
  // Simulated capture accumulates here; only ever set by the capture path.
  capturedAmountMinor   Int             @default(0)
  // Phase 27 — money returned against `capturedAmountMinor`. Only ever
  // incremented by a SUCCEEDED refund settlement, and never past the captured
  // amount (service ceiling + CHECK constraint in migration SQL). The intent
  // itself stays CAPTURED: a refund is a separate financial record, not a
  // resurrection of a terminal intent.
  refundedAmountMinor   Int             @default(0)
  // OPAQUE provider references — never secrets. Screened for credential- and
  // payment-bearing values before any write.
  providerRef           String?
  providerCustomerRef   String?
  // SAFE instrument metadata ONLY — never raw PAN/CVV/PIN/track/token.
  instrumentBrand       String?
  instrumentLast4       String?
  instrumentExpiryMonth Int?
  instrumentExpiryYear  Int?
  instrumentWallet      String?
  description           String?
  failureReason         String?
  authorizedAt          DateTime?
  capturedAt            DateTime?
  cancelledAt           DateTime?
  failedAt              DateTime?
  expiresAt             DateTime?
  // Tenant-scoped idempotency for intent creation.
  idempotencyKey        String?
  createdById           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order                 Order?                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  session               CheckoutSession?              @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  createdBy             User?                         @relation("PaymentIntentActor", fields: [createdById], references: [id], onDelete: Restrict)
  authorizations        PaymentAuthorization[]
  captures              PaymentCapture[]
  refunds               PaymentRefund[]
  events                PaymentEvent[]
  reconciliationRecords PaymentReconciliationRecord[]

  // Enables composite same-tenant FKs (authorizations/captures/events must
  // reference an intent of the SAME tenant).
  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt, id])
  @@index([tenantId, orderId])
  @@index([tenantId, checkoutSessionId])
}

// A simulated authorization hold recorded when an intent is authorized. Voided
// when the intent is cancelled/voided.
model PaymentAuthorization {
  id             String                     @id @default(cuid())
  tenantId       String
  intentId       String
  status         PaymentAuthorizationStatus @default(AUTHORIZED)
  amountMinor    Int
  providerRef    String?
  authorizedAt   DateTime                   @default(now())
  expiresAt      DateTime?
  voidedAt       DateTime?
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  intent    PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("PaymentAuthorizationActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, intentId, createdAt, id])
}

// A simulated capture. The (tenantId, idempotencyKey) unique is the last-line
// backstop against a DUPLICATE CAPTURE: a retried capture with the same key
// replays the original instead of moving money twice.
model PaymentCapture {
  id             String               @id @default(cuid())
  tenantId       String
  intentId       String
  status         PaymentCaptureStatus @default(SUCCEEDED)
  amountMinor    Int
  providerRef    String?
  capturedAt     DateTime?
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  intent                PaymentIntent                 @relation(fields: [intentId], references: [id], onDelete: Restrict)
  createdBy             User?                         @relation("PaymentCaptureActor", fields: [createdById], references: [id], onDelete: Restrict)
  refunds               PaymentRefund[]
  reconciliationRecords PaymentReconciliationRecord[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, intentId, createdAt, id])
  @@index([tenantId, status, createdAt, id])
}

// Provider event / webhook ingestion foundation. NO raw provider payload is
// stored — only normalized fields. (tenantId, provider, providerEventId) is
// unique so a duplicate provider event is idempotent per tenant/provider.
model PaymentEvent {
  id              String             @id @default(cuid())
  tenantId        String
  intentId        String?
  provider        PaymentProvider    @default(SIMULATED)
  providerEventId String
  eventType       PaymentEventType   @default(UNKNOWN)
  status          PaymentEventStatus @default(RECEIVED)
  providerRef     String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  idempotencyKey  String?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  intent    PaymentIntent? @relation(fields: [intentId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("PaymentEventActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, provider, providerEventId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, receivedAt, id])
  @@index([tenantId, intentId])
}

// Reconciliation foundation: a read/list model tracking whether a captured
// payment reconciles against provider-reported settlement. Phase 6 seeds a
// PENDING record on capture; no settlement accounting or provider import.
model PaymentReconciliationRecord {
  id                  String               @id @default(cuid())
  tenantId            String
  intentId            String?
  captureId           String?
  provider            PaymentProvider      @default(SIMULATED)
  status              ReconciliationStatus @default(PENDING)
  providerRef         String?
  expectedAmountMinor Int?
  reportedAmountMinor Int?
  currencyCode        String?
  notes               String?
  reconciledAt        DateTime?
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  intent    PaymentIntent?  @relation(fields: [intentId], references: [id], onDelete: Restrict)
  // Navigable relation for the captureId FK the migration already creates
  // (PaymentReconciliationRecord_captureId_fkey). The composite same-tenant FK
  // stays as hand-written hardening in migration SQL.
  capture   PaymentCapture? @relation(fields: [captureId], references: [id], onDelete: Restrict)
  createdBy User?           @relation("PaymentReconciliationActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt, id])
  @@index([tenantId, intentId])
}

// ---------------------------------------------------------------------------
// Phase 7 — CV product recognition & virtual basket foundation.
//
// The core USP flow: camera/CV event → evidence bundle → SKU candidates →
// review/policy decision → virtual basket line. Everything here is VENDOR-
// NEUTRAL: no dependency on any camera SDK, detector, or (V)LM provider.
// sourceType/sourceId/modelName/modelVersion are OPAQUE metadata a future
// adapter layer populates; the core never interprets them. There is NO edge
// runtime, camera integration, or training pipeline in this phase — only the
// normalized business/data flow that lets any provider's outputs become
// basket events.
//
// All models are tenant-owned (TenantScopedRepository subclasses only), with
// the same composite same-tenant FKs in migration SQL as Phases 3–5.
// ---------------------------------------------------------------------------

// Normalized product interaction event types (provider-neutral).
enum VisionEventType {
  PRODUCT_PICKUP
  PRODUCT_RETURN
  PRODUCT_TRANSFER
  CART_INSERTION
  EXIT_RECONCILIATION
}

// Event review lifecycle. PENDING_REVIEW is the only mutable state; APPROVED,
// REJECTED, and OVERRIDDEN are terminal — a decided event never changes again
// (its VisionEventReview row records the decision, append-only).
enum VisionEventStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  OVERRIDDEN
}

enum VisionReviewDecision {
  APPROVE
  REJECT
  OVERRIDE
}

// What a decision actually did to the linked session's basket. NONE covers
// rejections and the record-only event types (PRODUCT_TRANSFER,
// EXIT_RECONCILIATION) that never mutate the basket in this phase.
enum VisionBasketEffect {
  LINE_ADDED
  LINE_INCREASED
  LINE_DECREASED
  LINE_REMOVED
  NONE
}

// Evidence METADATA container for a capture window — never binary media.
// `artifacts` holds opaque descriptors only (kind, uri, contentType, sha256,
// durations, ...): the store of record for actual frames/clips is external
// and provider-owned. Screened for credential-/payment-bearing content
// before persistence (same shared detection as device metadata) — a
// rtsp://user:pass@... artifact URI must never reach storage.
//
// Append-only: no updatedAt, no update/delete repository methods, and
// migration-SQL triggers reject UPDATE/DELETE/TRUNCATE — evidence is
// tamper-evident by construction. All relations are Restrict/NoAction so no
// FK action can ever need to mutate a bundle row.
model EvidenceBundle {
  id               String             @id @default(cuid())
  tenantId         String
  // Opaque, vendor-neutral provenance (adapter-populated; never interpreted).
  sourceType       EvidenceSourceType @default(VISION)
  sourceId         String?
  modelName        String?
  modelVersion     String?
  // Capture window reported by the source.
  captureStartedAt DateTime?
  captureEndedAt   DateTime?
  // Opaque artifact descriptors (kind/uri/contentType/sha256/...) — metadata
  // ONLY, no binaries, screened for sensitive content before persistence.
  artifacts        Json?
  metadata         Json?
  createdById      String?
  createdAt        DateTime           @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy    User?         @relation("EvidenceBundleActor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  visionEvents VisionEvent[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
}

// A normalized product interaction event proposed by a vision source (or any
// future adapter). Ingested via the API, reviewed by a human/policy, and —
// only when approved — applied to the linked checkout session's basket.
// The event itself NEVER mutates inventory or the basket at ingest time.
model VisionEvent {
  id               String             @id @default(cuid())
  tenantId         String
  locationId       String
  unitId           String
  // Optional source camera/device (no edge runtime in Phase 7).
  deviceId         String?
  // Optional checkout session binding. Basket-affecting approvals REQUIRE a
  // session; events may still be ingested unbound (e.g. before the shopper's
  // session is known) and reviewed for the record.
  sessionId        String?
  type             VisionEventType
  status           VisionEventStatus  @default(PENDING_REVIEW)
  // Units of the product the source believes were moved (integer, in the
  // product's unit of measure — same integer-exact rule as the ledger).
  quantity         Int                @default(1)
  // When the interaction happened per the source; ingestedAt is server time.
  occurredAt       DateTime
  ingestedAt       DateTime           @default(now())
  // Opaque, vendor-neutral provenance (same set as EvidenceBundle).
  sourceType       EvidenceSourceType @default(VISION)
  sourceId         String?
  modelName        String?
  modelVersion     String?
  evidenceBundleId String?
  evidenceScore    Float?
  evidenceQuality  EvidenceQuality?
  reasonCodes      String[]           @default([])
  // SAFE, NON-SECRET normalized extras only (screened before persistence).
  metadata         Json?
  // Tenant-scoped ingestion idempotency: at-least-once delivery from edge
  // adapters replays the original event instead of duplicating it.
  idempotencyKey   String?
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location            Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit                RetailUnit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  device              Device?                @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  session             CheckoutSession?       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  evidenceBundle      EvidenceBundle?        @relation(fields: [evidenceBundleId], references: [id], onDelete: Restrict)
  createdBy           User?                  @relation("VisionEventActor", fields: [createdById], references: [id], onDelete: Restrict)
  candidates          VisionEventCandidate[]
  review              VisionEventReview?
  inferenceJobs       InferenceJob[]
  // Phase 26 — the store-flow projection that produced this event, if any.
  storeFlowProjection StoreFlowProjection?
  // Phase 27 — the shrink write-off recorded against this observation, if
  // an operator decided the goods left without being paid for. At most one.
  shrinkEvent         ShrinkEvent?

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, type])
  @@index([tenantId, sessionId])
  @@index([tenantId, unitId])
  @@index([tenantId, locationId])
}

// Ranked SKU candidate proposed for an event (rank 1 = strongest). Snapshots
// the product's sku/name at ingest time so review history never rewrites when
// the catalog is edited later. Append-only (triggers in migration SQL):
// candidates are evidence of what the source proposed and never change.
model VisionEventCandidate {
  id          String   @id @default(cuid())
  tenantId    String
  eventId     String
  productId   String
  rank        Int
  // Normalized [0, 1] confidence for THIS candidate, if the source ranks by
  // score. Opaque label is whatever the source called the object.
  score       Float?
  label       String?
  // Product snapshot at ingest time.
  sku         String
  productName String
  createdAt   DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  event   VisionEvent @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, tenantId])
  @@unique([tenantId, eventId, rank])
  @@unique([tenantId, eventId, productId])
  @@index([productId])
}

// The review/policy decision for an event — exactly one per event (the
// (tenantId, eventId) unique), created atomically WITH the basket effect it
// describes. Append-only (triggers in migration SQL): a decision is never
// edited; correcting a mistake is a new manual basket mutation with its own
// audit trail.
//
// Lineage note: the basket line written by an approval carries
// visionEventId (+ evidence refs) back to the event; this row carries
// sessionLineId forward to the line. The line's vlmReviewId column stays
// NULL in Phase 7 — line → event → review is the canonical chain.
model VisionEventReview {
  id               String               @id @default(cuid())
  tenantId         String
  eventId          String               @unique
  decision         VisionReviewDecision
  reason           String?
  // What was actually applied: the top candidate (APPROVE) or the reviewer's
  // choice (OVERRIDE). NULL for rejections and record-only event types.
  appliedProductId String?
  appliedQuantity  Int?
  basketEffect     VisionBasketEffect   @default(NONE)
  // The basket line the decision created/updated/removed, when any.
  sessionLineId    String?
  reviewedById     String?
  createdAt        DateTime             @default(now())

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  event          VisionEvent          @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  appliedProduct Product?             @relation("VisionReviewAppliedProduct", fields: [appliedProductId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sessionLine    CheckoutSessionLine? @relation(fields: [sessionLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewedBy     User?                @relation("VisionEventReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, tenantId])
  @@unique([tenantId, eventId])
  @@index([tenantId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Phase 9 — CV inference adapter & event queue foundation.
//
// Provider-neutral by construction: adapterKey/modelKey/modelVersion are
// OPAQUE strings, jobs carry a SAFE input descriptor (screened JSON — no raw
// media, no storage keys/signed URLs, no credentials), and no runtime ML or
// video dependency exists. A job is the unit of work between the (future)
// lightweight tracking/trigger layer and heavy crop inference; a SUCCEEDED
// job's result converts into a Phase 7 VisionEvent via the existing ingest
// contract — inference NEVER touches the basket or inventory itself.
// ---------------------------------------------------------------------------

enum InferenceJobType {
  TRACKING_EVENT
  SHELF_AUDIT
  PRODUCT_RECOGNITION
  OCR_REVIEW
  VLM_REVIEW
  EXIT_RECONCILIATION
}

enum InferenceJobStatus {
  // NON-CLAIMABLE creation state for callers that must commit a downstream
  // link (e.g. a video crop artifact → job link) before the work may be
  // delivered: the row exists and is discoverable/cancellable, but no
  // claim ever returns it. The caller publishes PENDING_LINK → QUEUED once
  // the link commits; a crash in between leaves work nothing can consume
  // and a later delete can retire.
  PENDING_LINK
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

// A queued unit of inference work. Lifecycle (PENDING_LINK →) QUEUED →
// RUNNING → SUCCEEDED/FAILED, with CANCELLED reachable from PENDING_LINK
// and QUEUED (orphan compensation); terminal statuses never transition
// again. The job row is the queue entry: claiming is a guarded
// compare-and-set on status, ordered by priority DESC then requestedAt ASC
// then id ASC (deterministic). Only QUEUED rows are claimable.
model InferenceJob {
  id              String             @id @default(cuid())
  tenantId        String
  // Optional store/unit/device/session context. Conversion to a Phase 7
  // VisionEvent requires locationId + unitId (the vision ingest contract).
  locationId      String?
  unitId          String?
  deviceId        String?
  sessionId       String?
  jobType         InferenceJobType
  status          InferenceJobStatus @default(QUEUED)
  // Queue priority, 0..1000 (CHECK in migration SQL); higher runs first.
  priority        Int                @default(100)
  requestedAt     DateTime           @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  // Lease ownership: every claim increments attempts and takes a lease;
  // complete/fail clear it. A RUNNING job whose lease expired (worker
  // crashed) is reclaimed on the next claim — back to QUEUED, or FAILED
  // with LEASE_EXPIRED once attempts are exhausted. RUNNING ⟺ leased
  // (CHECK in migration SQL).
  attempts        Int                @default(0)
  leaseExpiresAt  DateTime?
  // Opaque, vendor-neutral provenance (same closed enum as Phase 7).
  sourceType      EvidenceSourceType @default(VISION)
  sourceId        String?
  // Which registered adapter claimed the job (opaque key, e.g. "simulated").
  adapterKey      String?
  // SAFE, NON-SECRET input descriptor only (screened before persistence):
  // trigger context, crop/zone references by id, frame counts — never raw
  // media, media/storage URLs, signed URLs, or credentials.
  inputDescriptor Json?
  // FAILED only: a stable UPPER_SNAKE error code plus a screened message.
  errorCode       String?
  errorMessage    String?
  // Tenant-scoped creation idempotency: at-least-once trigger delivery
  // replays the original job instead of duplicating it.
  idempotencyKey  String?
  // Set once by the to-vision-event conversion; conversion is one-shot and
  // replays the linked event afterwards.
  visionEventId   String?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location       Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit           RetailUnit?      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  device         Device?          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  session        CheckoutSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  visionEvent    VisionEvent?     @relation(fields: [visionEventId], references: [id], onDelete: Restrict)
  createdBy      User?            @relation("InferenceJobActor", fields: [createdById], references: [id], onDelete: Restrict)
  result         InferenceResult?
  videoArtifacts VideoArtifact[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  // Matches the queue claim ordering (priority DESC, requestedAt ASC, id ASC)
  // under the status predicate.
  @@index([tenantId, status, priority(sort: Desc), requestedAt, id])
  @@index([tenantId, requestedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, jobType])
  @@index([tenantId, sessionId])
  @@index([tenantId, unitId])
}

// The normalized outcome of a SUCCEEDED job: a Phase 7-compatible event
// suggestion (eventType + signed quantityDelta) with ranked SKU candidates.
// quantityDelta is never zero and negative ONLY for PRODUCT_RETURN (CHECKs
// in migration SQL) — the VisionEvent conversion emits abs(quantityDelta),
// the sign is carried by the event type, matching the Phase 8 mapper.
// Append-only (triggers in migration SQL): what the adapter produced is
// evidence and never changes.
model InferenceResult {
  id              String           @id @default(cuid())
  tenantId        String
  jobId           String           @unique
  eventType       VisionEventType
  quantityDelta   Int
  // The SOURCE-reported interaction time (from the completion input), NOT
  // when inference ran — delayed/queued jobs keep correct event chronology,
  // and the VisionEvent conversion emits exactly this timestamp.
  occurredAt      DateTime
  evidenceScore   Float?
  evidenceQuality EvidenceQuality?
  // Opaque model/provider metadata (screened; never interpreted).
  modelKey        String?
  modelVersion    String?
  // SAFE, NON-SECRET normalized extras only (screened before persistence).
  metadata        Json?
  createdAt       DateTime         @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  job        InferenceJob         @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  candidates InferenceCandidate[]

  @@unique([id, tenantId])
  @@unique([tenantId, jobId])
}

// Ranked SKU candidate produced by an adapter (rank 1 = strongest). SKUs are
// normalized (uppercase) model-output strings — they resolve against the
// tenant catalog at VisionEvent conversion time, exactly like the Phase 8
// mapper output. Append-only (triggers in migration SQL).
model InferenceCandidate {
  id        String   @id @default(cuid())
  tenantId  String
  resultId  String
  rank      Int
  sku       String
  label     String?
  // Normalized [0, 1] confidence, rounded to 4 decimals by the adapter.
  score     Float
  createdAt DateTime @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  result InferenceResult @relation(fields: [resultId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, tenantId])
  @@unique([tenantId, resultId, rank])
  @@unique([tenantId, resultId, sku])
}

// ---------------------------------------------------------------------------
// Phase 10 — Video ingestion & crop extraction (controlled TEST videos only).
// Rows carry METADATA + an INTERNAL storage key only: raw media bytes never
// enter the database, no public/signed URLs exist, and the storage key is
// never exposed through the API. Local/dev storage adapter only — production
// camera runtime, streaming, and real model execution are later phases.
// ---------------------------------------------------------------------------

enum VideoAssetStatus {
  // DB-first staging state: the metadata row committed but the media write
  // has not succeeded yet. NOT screenable and NOT processable — a screening
  // decision, preview, validate, or extraction on a PENDING_MEDIA asset is
  // a controlled 409, so a concurrent screener can never APPROVE an asset
  // whose bytes may still fail to land. The upload publishes the asset
  // (PENDING_MEDIA → QUARANTINED) only AFTER the media write succeeds; a
  // failed write parks it PENDING_MEDIA → FAILED (UPLOAD_INCOMPLETE). A
  // crash in the window leaves this row as the recovery record (DELETE
  // cleans it).
  PENDING_MEDIA
  // Every upload whose media landed is published QUARANTINED: bytes are held
  // in local storage but the asset is NOT processable (validate/extract/crop
  // all 409) until an
  // audited frame-content screening decision APPROVEs it (→ UPLOADED) or
  // REJECTs it (media removed, → REJECTED). The upload attestation is
  // defense-in-depth only — quarantine is the enforced control.
  QUARANTINED
  UPLOADED
  VALIDATED
  REJECTED
  PROCESSING
  READY
  FAILED
}

enum VideoArtifactType {
  FRAME
  CROP
}

// Why a crop/frame was extracted — a closed vocabulary (mirrors the Phase 9
// job types plus shelf/cart context) so free text can never leak into it.
enum VideoCropReason {
  PRODUCT_PICKUP
  PRODUCT_RETURN
  SHELF_AUDIT
  CART_INSERTION
  OCR_REVIEW
  VLM_REVIEW
}

// DURABLE outcome of an upload's ONE media write (storage.put). Not a
// lifecycle status: it records whether a put is still in flight, so the
// DELETE cleanup can OBSERVE the drain instead of INFERRING it. PENDING is
// claimed under the asset advisory lock immediately before the put (in the
// same locked transaction as the pre-put liveness read, so a concurrent
// soft-delete either sees the claim or precedes it); SUCCEEDED is written
// the moment the put returns, FAILED when it throws. NULL means no durable
// media write was ever attempted for this row (rejected before the put, or
// a pre-existing row).
enum VideoMediaWriteState {
  PENDING
  SUCCEEDED
  FAILED
}

// A controlled test video uploaded for the Phase 9 inference pipeline.
// Lifecycle: UPLOADED → VALIDATED → PROCESSING → READY (or REJECTED/FAILED).
// Soft delete: deletedAt marks the row; the local file is removed and the
// metadata row is kept for audit lineage (artifacts keep their references).
model VideoAsset {
  id                       String                @id @default(cuid())
  tenantId                 String
  // Optional store/unit/device/session context, same binding rules as
  // Phase 9 inference jobs (all same-tenant, composite FKs in migration SQL).
  locationId               String?
  unitId                   String?
  deviceId                 String?
  sessionId                String?
  // Phase 22 — planogram binding captured at upload (or set afterwards):
  // the ACTIVE rack code at the bound store the clip shows, and where that
  // rack sits in the frame (normalized rectangle; null = whole frame).
  // Downstream stages (fusion v2 candidate scoping, pretrained evaluation)
  // read these instead of asking the operator again.
  planogramRackCode        String?
  rackFrameRegion          Json?
  // Sanitized original filename (basename only, safe charset) — display only,
  // NEVER used to build storage paths.
  originalFilename         String
  mimeType                 String
  sizeBytes                Int
  // Probed metadata (null until a probe/validate ran).
  durationMs               Int?
  width                    Int?
  height                   Int?
  fps                      Float?
  status                   VideoAssetStatus      @default(UPLOADED)
  // INTERNAL storage key relative to the configured local storage root
  // (opaque, server-generated). Never exposed in API responses and never
  // user-supplied.
  storageKey               String
  checksumSha256           String
  // Safe, stable failure information (UPPER_SNAKE code + screened message).
  errorCode                String?
  errorMessage             String?
  // Server-side SCREENING INSPECTION EVIDENCE: stamped ONLY by the guarded
  // screening-preview serve authorization (which requires a byte-reading
  // extractor and at least one actually-served frame), and REQUIRED by the
  // APPROVE screening decision — so an approval can never happen blind.
  // Cleared on EVERY status transition (evidence is QUARANTINED-scoped and
  // single-use; a fresh QUARANTINED publish starts with none).
  screeningInspectedAt     DateTime?
  screeningInspectedBy     String?
  screeningInspectedFrames Int?
  uploadedById             String?
  deletedAt                DateTime?
  // EXACTLY-ONCE media-removal completion marker: stamped by a DB
  // compare-and-set (updateMany WHERE mediaRemovedAt IS NULL) in the same
  // transaction as the "media removal completed" audit entry, so the
  // durable completion evidence is written exactly once no matter how the
  // filesystem removal and its retries/replays interleave — the marker,
  // never the storage adapter's "did anything exist" report, is the
  // authority. Shared by the screening-rejection removal and the delete
  // cleanup (the completion audit reason distinguishes them).
  mediaRemovedAt           DateTime?
  // DURABLE media-write phase for the upload's single storage.put. The
  // DELETE cleanup may record its exactly-once completion ONLY when this is
  // RESOLVED (SUCCEEDED/FAILED — or NULL, meaning no put was ever
  // attempted): while it is PENDING a put that claimed the write before the
  // soft-delete committed can still land bytes just after the prefix was
  // drained, so completion would be recorded over media that did not exist
  // yet. Replaces the old inference "the row is PENDING_MEDIA / already
  // soft-deleted, so the write must have drained", which a DELETE REPLAY
  // could not observe at all.
  mediaWriteState          VideoMediaWriteState?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location             Location?                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit                 RetailUnit?              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  device               Device?                  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  session              CheckoutSession?         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  uploadedBy           User?                    @relation("VideoAssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  artifacts            VideoArtifact[]
  extractionRequests   VideoExtractionRequest[]
  groundTruth          VideoGroundTruth?
  fusionRuns           PickupFusionRun[]
  replayCameraSources  CameraSource[]           @relation("CameraReplayAsset")
  cameraPilotRuns      CameraPilotRun[]
  pretrainedVisionRuns PretrainedVisionRun[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, sessionId])
}

// A frame or crop extracted from a VideoAsset. Internal reference only —
// like the asset, the row carries metadata + an internal storage key, never
// media bytes or a download URL. Append-only (triggers in migration SQL)
// except the one-shot inferenceJobId link set when a Phase 9 job is created
// from a crop.
model VideoArtifact {
  id             String            @id @default(cuid())
  tenantId       String
  videoAssetId   String
  artifactType   VideoArtifactType
  reason         VideoCropReason?
  // Position in the source video.
  timestampMs    Int
  // Crop box within the source frame (CROP only; null for full FRAMEs).
  cropX          Int?
  cropY          Int?
  cropWidth      Int?
  cropHeight     Int?
  // Output dimensions of the extracted artifact.
  width          Int
  height         Int
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  // INTERNAL storage key relative to the configured local storage root —
  // never exposed in API responses.
  storageKey     String
  // Set once when a Phase 9 inference job is created from this crop; the
  // job's input descriptor references this artifact BY ID only.
  inferenceJobId String?
  createdById    String?
  createdAt      DateTime          @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  videoAsset   VideoAsset    @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)
  inferenceJob InferenceJob? @relation(fields: [inferenceJobId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("VideoArtifactActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, videoAssetId, createdAt])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
}

// One extraction request (frames batch or manual crop) per tenant-scoped
// idempotency key. Artifact rows are append-only, so retrying a committed
// batch whose HTTP response was lost must REPLAY the recorded artifacts —
// never extract and append again. The row stores only ids (no media, no
// storage keys) and is written in the SAME transaction as its batch.
model VideoExtractionRequest {
  id                 String   @id @default(cuid())
  tenantId           String
  videoAssetId       String
  idempotencyKey     String
  // The artifact ids the committed batch produced, in creation order —
  // replay resolves them through the tenant-scoped artifact reads.
  artifactIds        Json
  // Canonical fingerprint of the request parameters that produced the batch
  // (fixed operation tag, fixed field order, defaults applied). A replay is
  // honored ONLY when the incoming request's fingerprint matches — the same
  // key with changed parameters is a controlled 409, never a silent replay
  // of the old batch. Null only on rows recorded before this column existed
  // (those fail closed: they can no longer prove the request is identical).
  requestFingerprint String?
  createdAt          DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, videoAssetId])
}

// ---------------------------------------------------------------------
// Phase 15 — live pilot EVALUATION loop (SHADOW ONLY). An evaluation run
// groups live sessions so pilot accuracy and speed can be measured;
// operator reviews are APPEND-ONLY labels over live CV observations
// (never a rewrite of the observation, never an inventory/billing
// side effect); the dataset export reads ONLY these tables plus the
// observations they label. Nothing in this module touches checkout,
// order, payment, or inventory state.
// ---------------------------------------------------------------------

enum PilotEvaluationRunStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum PilotObservationVerdict {
  CORRECT
  INCORRECT
  UNCERTAIN
  FALSE_TOUCH
  WRONG_SKU
  WRONG_ACTION
  MISSED_EVENT
}

enum PilotExpectedAction {
  PICKUP
  RETURN
  NO_OP
  UNKNOWN
}

model PilotEvaluationRun {
  id                 String                   @id @default(cuid())
  tenantId           String
  locationId         String?
  name               String
  description        String?
  status             PilotEvaluationRunStatus @default(OPEN)
  // One-SKU bootstrap identity: the product this run bootstraps, set ONLY
  // by the bootstrap workflow's find-or-create (NULL for every other
  // pilot run). A partial unique index (raw SQL in the
  // one_sku_bootstrap_run_identity migration — Prisma cannot express the
  // WHERE clause) allows at most ONE OPEN run per tenant/product, so
  // concurrent first corrections cannot split reviews across duplicates.
  bootstrapProductId String?
  createdById        String?
  createdAt          DateTime                 @default(now())
  completedAt        DateTime?

  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location               Location?                 @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bootstrapProduct       Product?                  @relation("PilotRunBootstrapProduct", fields: [bootstrapProductId], references: [id], onDelete: Restrict)
  sessions               PilotEvaluationSession[]
  reviews                PilotObservationReview[]
  testProtocols          CvTestProtocol[]
  datasetImprovementRuns CvDatasetImprovementRun[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, bootstrapProductId])
}

model PilotEvaluationSession {
  id              String   @id @default(cuid())
  tenantId        String
  evaluationRunId String
  liveSessionId   String
  createdAt       DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  evaluationRun PilotEvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Restrict)
  liveSession   LiveCameraSession  @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([evaluationRunId, liveSessionId])
  @@index([tenantId, evaluationRunId])
}

// APPEND-ONLY operator label over one live CV observation (or, for
// MISSED_EVENT, over an interaction the CV never produced an event for).
// predicted* fields are SERVER-side snapshots of the observation at
// review time — never caller-supplied. The newest review per observation
// is the one metrics use; older rows remain as audit history.
model PilotObservationReview {
  id                     String                  @id @default(cuid())
  tenantId               String
  evaluationRunId        String
  liveSessionId          String?
  journeyEventId         String?
  verdict                PilotObservationVerdict
  expectedAction         PilotExpectedAction
  expectedProductId      String?
  expectedSku            String?
  predictedProductId     String?
  predictedSku           String?
  predictedAction        PilotExpectedAction?
  // One-SKU bootstrap: OPAQUE id of the operator-approved manual CROP
  // VideoArtifact that supersedes the fusion run's automatic crop as
  // this observation's evidence. STRUCTURED (never parsed from notes),
  // validated tenant-scoped + same-video at write time, and carried into
  // Phase 18 candidates as evidenceCropArtifactId. Never a path or URL.
  operatorCropArtifactId String?
  notes                  String?
  reviewedById           String?
  createdAt              DateTime                @default(now())

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  evaluationRun   PilotEvaluationRun    @relation(fields: [evaluationRunId], references: [id], onDelete: Restrict)
  journeyEvent    CustomerJourneyEvent? @relation(fields: [journeyEventId], references: [id], onDelete: Restrict)
  expectedProduct Product?              @relation("PilotReviewExpectedProduct", fields: [expectedProductId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, evaluationRunId, createdAt])
  @@index([tenantId, journeyEventId, createdAt])
}

// ---------------------------------------------------------------------
// Phase 16 — live CV TEST PROTOCOL (SHADOW ONLY). A protocol organizes
// repeatable real-footage tests: named scenarios with expected outcomes,
// linked to ONE Phase 15 evaluation run for metrics/review/export.
// Purely organizational — no CV decision reads these tables, and nothing
// here touches checkout, order, payment, or inventory state.
// ---------------------------------------------------------------------

enum CvTestProtocolStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CvTestScenarioType {
  SINGLE_PICKUP
  SINGLE_RETURN
  FALSE_TOUCH_NO_PRODUCT_MOVED
  MISSED_PICKUP
  MISSED_RETURN
  TWO_PRODUCTS_VISIBLE_ONE_PICKED
  SIMILAR_SKU_CONFUSION
  MULTI_QUANTITY_PICKUP
  HAND_OCCLUSION
  FAST_PICKUP
  SLOW_PICKUP
  LOW_LIGHT
  BAD_ANGLE
  EMPTY_SHELF
  UNKNOWN_PRODUCT
}

enum CvTestScenarioResult {
  PASS
  FAIL
  INCONCLUSIVE
}

model CvTestProtocol {
  id               String               @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  locationId       String?
  cameraSourceId   String?
  evaluationRunId  String?
  /**
   * Whether the protocol EXPECTS fast mode (null = no expectation).
   */
  fastModeExpected Boolean?
  status           CvTestProtocolStatus @default(DRAFT)
  createdById      String?
  createdAt        DateTime             @default(now())
  completedAt      DateTime?

  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // SAME-TENANT composite location relation (Codex P1): the store join
  // carries the tenant in the FK itself — a malformed row can never
  // resolve another tenant's store name.
  location               Location?                 @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  cameraSource           CameraSource?             @relation(fields: [cameraSourceId], references: [id], onDelete: Restrict)
  evaluationRun          PilotEvaluationRun?       @relation(fields: [evaluationRunId], references: [id], onDelete: Restrict)
  scenarios              CvTestProtocolScenario[]
  datasetImprovementRuns CvDatasetImprovementRun[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
}

// One scripted test case inside a protocol: what the operator will act
// out on camera and what the CV is EXPECTED to conclude. The operator
// result (PASS/FAIL/INCONCLUSIVE) is reporting only — CV decisions never
// read scenarios.
model CvTestProtocolScenario {
  id                String                @id @default(cuid())
  tenantId          String
  protocolId        String
  scenarioType      CvTestScenarioType
  expectedAction    PilotExpectedAction
  expectedProductId String?
  expectedSku       String?
  expectedQuantity  Int?
  notes             String?
  liveSessionId     String?
  result            CvTestScenarioResult?
  resultNotes       String?
  resultById        String?
  resultAt          DateTime?
  createdById       String?
  createdAt         DateTime              @default(now())

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  protocol        CvTestProtocol     @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  // SAME-TENANT composite relation (Codex P1): the product join carries
  // the tenant in the FK itself — a malformed/imported row can never
  // resolve another tenant's product name through this relation.
  expectedProduct Product?           @relation("CvScenarioExpectedProduct", fields: [expectedProductId, tenantId], references: [id, tenantId], onDelete: Restrict)
  liveSession     LiveCameraSession? @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, protocolId, createdAt])
}

// ---------------------------------------------------------------------
// Phase 17 — camera calibration & pilot hardening (SHADOW ONLY).
// A calibration profile captures SAFE, structured setup metadata for one
// camera source (frame geometry, mount, orientation) plus normalized
// shelf/interaction/ignore zones used ONLY to make live CV testing more
// reliable and repeatable. NEVER stored here: RTSP URLs, file paths,
// credential slots, raw frames, or raw video. Zones are calibration and
// test aids — no CV decision, basket, order, payment, or inventory path
// reads or writes these tables.
// ---------------------------------------------------------------------

enum CameraCalibrationProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CameraCalibrationOrientation {
  LANDSCAPE
  PORTRAIT
  UNKNOWN
}

enum CameraCalibrationMount {
  OVERHEAD
  FRONT_SHELF
  ANGLED_SHELF
  UNKNOWN
}

enum CameraCalibrationZoneType {
  SHELF_ZONE
  INTERACTION_ZONE
  IGNORE_ZONE
  ENTRY_EXIT_ZONE
}

model CameraCalibrationProfile {
  id                 String                         @id @default(cuid())
  tenantId           String
  cameraSourceId     String
  locationId         String?
  name               String
  status             CameraCalibrationProfileStatus @default(DRAFT)
  calibrationVersion Int                            @default(1)
  frameWidth         Int?
  frameHeight        Int?
  orientation        CameraCalibrationOrientation   @default(UNKNOWN)
  cameraMount        CameraCalibrationMount         @default(UNKNOWN)
  // Screened free text (reject-on-write): never a URL, path, credential,
  // or connection string — same policy as camera connectionNote.
  notes              String?
  createdById        String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  activatedAt        DateTime?
  archivedAt         DateTime?

  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // SAME-TENANT composite relations (Codex P1): the FK itself carries the
  // tenant, so a malformed row can never resolve another tenant's source
  // or store.
  cameraSource           CameraSource              @relation(fields: [cameraSourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  location               Location?                 @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  zones                  CameraCalibrationZone[]
  datasetImprovementRuns CvDatasetImprovementRun[]

  // At most ONE ACTIVE profile per camera source: partial unique index in
  // migration SQL (Prisma cannot express the WHERE status = 'ACTIVE').
  @@unique([id, tenantId])
  @@index([tenantId, cameraSourceId, createdAt(sort: Desc)])
  @@index([tenantId, status])
}

// One normalized zone (coordinates in 0..1, never raw pixels). Polygon is
// controlled JSON: an array of {x, y} points, validated on write (3..20
// points, each coordinate in [0, 1]).
model CameraCalibrationZone {
  id                   String                    @id @default(cuid())
  tenantId             String
  calibrationProfileId String
  cameraSourceId       String
  zoneType             CameraCalibrationZoneType
  label                String
  polygon              Json
  qualityScore         Float?
  isActive             Boolean                   @default(true)
  sortOrder            Int                       @default(0)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  tenant             Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  calibrationProfile CameraCalibrationProfile       @relation(fields: [calibrationProfileId, tenantId], references: [id, tenantId], onDelete: Cascade)
  cameraSource       CameraSource                   @relation(fields: [cameraSourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  expectedProducts   CameraCalibrationZoneProduct[]

  @@unique([id, tenantId])
  @@index([tenantId, calibrationProfileId, sortOrder])
}

// Expected product on a SHELF_ZONE (testing aid only). expectedSku is a
// server-side snapshot of the product's SKU at link time, so the label
// survives renames — the same pattern as CvTestProtocolScenario.
model CameraCalibrationZoneProduct {
  id          String   @id @default(cuid())
  tenantId    String
  zoneId      String
  productId   String
  expectedSku String
  createdAt   DateTime @default(now())

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  zone    CameraCalibrationZone @relation(fields: [zoneId, tenantId], references: [id, tenantId], onDelete: Cascade)
  // SAME-TENANT composite product relation (Codex P1).
  product Product               @relation("CameraCalibrationZoneExpectedProduct", fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, zoneId, productId])
  @@index([tenantId, productId])
}

// ---------------------------------------------------------------------
// Phase 18 — dataset improvement & model tuning (SHADOW ONLY, advisory).
// A dataset improvement run turns REVIEWED/CORRECTED Phase 15/16 labels
// into training-ready METADATA: candidate references, quality reporting,
// deterministic split planning, and a safe export manifest for OFFLINE
// tuning. Candidates are references to existing safe records — never a
// copy of media. NEVER stored here: raw frames, crops, video, embeddings,
// model weights, RTSP URLs, file paths, or credential slots. No training
// runs inside the app; nothing in this phase touches checkout, order,
// payment, or inventory state, and it never mutates the review/scenario
// records it reads.
// ---------------------------------------------------------------------

enum CvDatasetImprovementRunStatus {
  DRAFT
  READY
  EXPORTED
  ARCHIVED
}

enum CvDatasetPurpose {
  SKU_CLASSIFICATION
  ACTION_RECOGNITION
  FALSE_TOUCH_FILTERING
  MISSED_EVENT_RECOVERY
  CALIBRATION_VALIDATION
  MIXED
}

enum CvDatasetCandidateSourceType {
  LIVE_REVIEW
  MISSED_EVENT
  PROTOCOL_SCENARIO
  // Reserved for re-importing Phase 15 dataset-export rows in a later
  // phase — never emitted by the MVP candidate collector.
  DATASET_EXPORT_ITEM
}

enum CvDatasetSplit {
  TRAIN
  VALIDATION
  TEST
  // Reserved for operator-managed holdout plans — the MVP split planner
  // never auto-assigns it.
  HOLDOUT
}

enum CvDatasetEligibility {
  ELIGIBLE
  EXCLUDED
}

model CvDatasetImprovementRun {
  id                           String                        @id @default(cuid())
  tenantId                     String
  sourceEvaluationRunId        String?
  sourceTestProtocolId         String?
  sourceCalibrationProfileId   String?
  name                         String
  status                       CvDatasetImprovementRunStatus @default(DRAFT)
  purpose                      CvDatasetPurpose
  trainSplitPercent            Int
  validationSplitPercent       Int
  testSplitPercent             Int
  minReviewedExamplesPerSku    Int
  minReviewedExamplesPerAction Int
  // Screened free text (reject-on-write): never a URL, path, credential,
  // or slot name — same policy as calibration notes.
  notes                        String?
  // sha256 over SAFE calibration content (profile id/version/orientation/
  // mount/updatedAt + zone counts, sorted zone ids, max zone updatedAt),
  // captured at candidate refresh when the linked profile is stamped on
  // eligible candidates. Export recomputes and compares, so profile edits
  // AND zone additions/updates/deletions after the refresh reject the
  // export instead of silently changing the manifest. Null when no
  // profile is linked or nothing is stamped (FILE_REPLAY exemption).
  calibrationFingerprint       String?
  createdById                  String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  exportedAt                   DateTime?
  archivedAt                   DateTime?

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // SAME-TENANT composite relations (Codex P1): the FK itself carries the
  // tenant, so a malformed row can never resolve another tenant's
  // evaluation run, protocol, or calibration profile.
  sourceEvaluationRun      PilotEvaluationRun?       @relation(fields: [sourceEvaluationRunId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sourceTestProtocol       CvTestProtocol?           @relation(fields: [sourceTestProtocolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sourceCalibrationProfile CameraCalibrationProfile? @relation(fields: [sourceCalibrationProfileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  candidates               CvDatasetCandidate[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
}

// One candidate example: a REFERENCE to an existing reviewed/corrected
// record (pilot review, missed-event review, or protocol scenario) plus
// safe label snapshots. sourceId/liveSessionId are deliberately plain
// references (no FK) — candidates are a planning ledger over records
// that may themselves be append-only; the ledger is rebuilt by refresh,
// never treated as ground truth. lightingBucket/occlusionBucket/
// calibrationZoneLabel are ALWAYS null in the MVP: no source data exists
// for them yet, and Phase 18 never fabricates values.
model CvDatasetCandidate {
  id                     String                       @id @default(cuid())
  tenantId               String
  runId                  String
  sourceType             CvDatasetCandidateSourceType
  sourceId               String
  liveSessionId          String?
  evaluationRunId        String?
  protocolId             String?
  calibrationProfileId   String?
  skuId                  String?
  skuCodeSnapshot        String?
  actionLabel            String
  correctedActionLabel   String?
  reviewVerdict          String
  reviewSource           String
  confidenceBucket       String?
  lightingBucket         String?
  occlusionBucket        String?
  calibrationZoneLabel   String?
  scenarioTypeSnapshot   String?
  // OPAQUE id of the operator-approved crop artifact this candidate's
  // evidence resolves to (copied from the source review's structured
  // operatorCropArtifactId at refresh). Null = the source event's own
  // automatic fusion crop. Reference marker only — never a path/URL.
  evidenceCropArtifactId String?
  split                  CvDatasetSplit?
  eligibility            CvDatasetEligibility
  exclusionReason        String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  run    CvDatasetImprovementRun @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, runId, sourceType, sourceId])
  @@index([tenantId, runId, eligibility])
}

// ---------------------------------------------------------------------------
// Phase 19 — pretrained retail vision adapters + planogram-aware SKU
// narrowing. EVERYTHING here is shadow evidence: planograms are a SOFT
// scoring prior for SKU candidate narrowing, and pretrained provider
// runs are local-only normalized evidence for side-by-side evaluation
// against the classical fallback. Nothing in this phase touches
// checkout, order, payment, settlement, or inventory tables.

enum PlanogramRackStatus {
  ACTIVE
  INACTIVE
}

// One VERSION of a store rack's planned layout (rows × columns grid).
// Publishing a new layout for the same rackCode deactivates the current
// ACTIVE version and creates version+1 — old evidence keeps pointing at
// the version it was scored against, so a planogram edit can never
// silently rewrite previously reviewed candidate labels.
model PlanogramRack {
  id          String              @id @default(cuid())
  tenantId    String
  locationId  String
  rackCode    String
  name        String?
  rows        Int
  columns     Int
  version     Int                 @default(1)
  status      PlanogramRackStatus @default(ACTIVE)
  activeFrom  DateTime            @default(now())
  activeTo    DateTime?
  createdById String?
  createdAt   DateTime            @default(now())

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location                  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  cells    PlanogramCellAssignment[]

  @@unique([id, tenantId])
  @@index([tenantId, locationId, rackCode, status])
}

// One SKU expected in one cell of a rack version. isPrimary marks the
// facing owner; additional rows are secondary placements. Snapshot SKU
// survives catalog renames for evidence traceability.
model PlanogramCellAssignment {
  id              String   @id @default(cuid())
  tenantId        String
  rackId          String
  cellCode        String
  rowIndex        Int
  columnIndex     Int
  productId       String
  skuCodeSnapshot String
  isPrimary       Boolean  @default(true)
  facingCount     Int      @default(1)
  createdAt       DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rack    PlanogramRack @relation(fields: [rackId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  eslLabels EslLabel[]

  @@unique([id, tenantId])
  @@unique([rackId, cellCode, productId])
  @@index([tenantId, rackId])
  @@index([tenantId, productId])
}

enum PretrainedVisionRunStatus {
  COMPLETED
  PROVIDER_UNAVAILABLE
  FAILED
}

// One LOCAL pretrained-provider evaluation over one uploaded clip.
// evidence is ALLOWLIST-normalized before persistence (classified codes,
// numbers, normalized boxes, SKU snapshots) — never file paths, model
// paths, raw tensors, raw media, or provider logs. Records the planogram
// version the run was scored against (version safety).
model PretrainedVisionRun {
  id                String                    @id @default(cuid())
  tenantId          String
  videoAssetId      String
  provider          String
  status            PretrainedVisionRunStatus
  planogramRackId   String?
  planogramVersion  Int?
  /**
   * The EXACT sanitized planogram section the run was scored against —
   * immutable evidence: publishing a new planogram version can never
   * rewrite what an old run's candidates/match status looked like.
   */
  planogramEvidence Json?
  evidence          Json
  createdById       String?
  createdAt         DateTime                  @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, videoAssetId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Phase 25 — Pricing.
//
// AGENTS.md hard rule: "Pricing changes must be versioned, auditable, and
// reversible." The model below makes that structural rather than procedural:
// a price is never a mutable column on Product. It lives in an immutable
// PriceBookEntry belonging to a PriceBookVersion, and the only way to change
// a price is to create a NEW version. Activation supersedes the previous
// version (closing its effective window) and rollback copies an earlier
// version forward — history is appended to, never rewritten or deleted.
// ---------------------------------------------------------------------------

enum PriceBookStatus {
  ACTIVE
  ARCHIVED
}

enum PriceBookVersionStatus {
  // Editable. Entries may be set/replaced; the version resolves no prices.
  DRAFT
  // The current version of its book. At most ONE per book — enforced by a
  // PARTIAL unique index in migration SQL (Prisma cannot express it).
  ACTIVE
  // Was active, then replaced by a newer version. Still resolves prices for
  // instants inside its closed [effectiveFrom, effectiveTo) window, which is
  // what makes historical price lookups correct.
  SUPERSEDED
  // Withdrawn without ever having been active (a discarded draft). Never
  // resolves a price. Rows are kept, never deleted.
  ARCHIVED
}

/// Closed vocabulary for WHY a price version exists. Free-form justification
/// goes in `note`, which is screened for credential/payment-bearing text
/// before it is persisted (it also flows into AuditLog.reason).
enum PriceChangeReason {
  INITIAL
  PRICE_CHANGE
  PROMOTION_BASE
  CORRECTION
  ROLLBACK
}

/// A named, currency-homogeneous set of prices. A book scoped to a location
/// overrides the tenant-wide book for that location; the resolution rule is
/// "most specific applicable book wins" (see pricing/pricing.logic.ts).
model PriceBook {
  id           String          @id @default(cuid())
  tenantId     String
  /// Unique per tenant, normalized to uppercase (like Product.sku).
  code         String
  name         String
  /// ISO-4217 alphabetic code. Every entry in every version of this book is
  /// denominated in it; a book never mixes currencies.
  currencyCode String
  /// NULL = tenant-wide default book. Set = applies only at that location.
  locationId   String?
  status       PriceBookStatus @default(ACTIVE)
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location  Location?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User?              @relation("PriceBookActor", fields: [createdById], references: [id], onDelete: Restrict)
  versions  PriceBookVersion[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, locationId, status])
}

/// One immutable revision of a price book. Append-only in spirit: after
/// activation the only columns that ever change are the supersession links
/// (`status`, `effectiveTo`, `supersededByVersionId`), written exactly once
/// when a newer version takes over.
model PriceBookVersion {
  id            String                 @id @default(cuid())
  tenantId      String
  priceBookId   String
  /// Monotonic per book, starting at 1. Never reused, even after archiving.
  versionNumber Int
  status        PriceBookVersionStatus @default(DRAFT)
  /// Instant the version starts applying. Set at activation (or scheduled
  /// ahead of time); a DRAFT carries its intended start.
  effectiveFrom DateTime
  /// Exclusive end of the window, written when a newer version activates.
  /// NULL while this version is the current one.
  effectiveTo   DateTime?
  reason        PriceChangeReason
  note          String?

  createdById             String?
  activatedById           String?
  activatedAt             DateTime?
  /// The version that replaced this one (set on the OLD row at activation).
  supersededByVersionId   String?   @unique
  /// For ROLLBACK versions: the historical version whose entries were copied
  /// forward. The source row itself is never resurrected or edited.
  rolledBackFromVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  priceBook   PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("PriceBookVersionActor", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy User?     @relation("PriceBookVersionActivator", fields: [activatedById], references: [id], onDelete: Restrict)

  supersededBy   PriceBookVersion?  @relation("PriceBookSupersession", fields: [supersededByVersionId], references: [id], onDelete: Restrict)
  supersedes     PriceBookVersion?  @relation("PriceBookSupersession")
  rolledBackFrom PriceBookVersion?  @relation("PriceBookRollback", fields: [rolledBackFromVersionId], references: [id], onDelete: Restrict)
  rollbackCopies PriceBookVersion[] @relation("PriceBookRollback")

  entries PriceBookEntry[]

  eslRenderedLabels EslLabel[]     @relation("EslLabelRenderedVersion")
  eslUpdateJobs     EslUpdateJob[] @relation("EslJobPriceVersion")

  // Phase 29 — the lines whose base price this version produced. Read-only
  // back-references: nothing downstream may write a price version.
  checkoutLines CheckoutSessionLine[] @relation("CheckoutLinePriceVersion")
  orderLines    OrderLine[]           @relation("OrderLinePriceVersion")

  @@unique([id, tenantId])
  @@unique([priceBookId, versionNumber])
  @@index([tenantId, priceBookId, status])
  @@index([tenantId, priceBookId, effectiveFrom])
}

/// One product's price inside one version. Immutable once its version leaves
/// DRAFT — the service refuses to touch entries of a non-DRAFT version, and
/// a price change is expressed as a new version instead.
model PriceBookEntry {
  id             String   @id @default(cuid())
  tenantId       String
  versionId      String
  productId      String
  /// Minor currency units (integer-exact; 1099 = 10.99). Never negative —
  /// a CHECK constraint in migration SQL backstops the DTO and the service.
  unitPriceMinor Int
  /// Denormalized snapshot of the owning book's currency, so a resolved
  /// price is self-describing without a join.
  currencyCode   String
  createdAt      DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  version PriceBookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([versionId, productId])
  @@index([tenantId, productId])
  @@index([tenantId, versionId])
}

// ---------------------------------------------------------------------------
// Phase 26 — the store flow: shopper entry, the bridge that turns observed
// pickups into basket effects, and exit settlement. Every table here is
// tenant-scoped and every automatic effect is gated by an autonomy policy
// whose default (SHADOW) reproduces the behaviour of every earlier phase.
// ---------------------------------------------------------------------------

enum ShopperStatus {
  ACTIVE
  BLOCKED
}

enum StoreEntryTokenStatus {
  ISSUED
  REDEEMED
  REVOKED
}

/// How much a store is allowed to do without a human.
enum StoreFlowAutonomyLevel {
  /// Observe only. Identical to the behaviour of every phase before 26: the
  /// journey stream records what the pipeline saw and nothing reaches a
  /// basket, an order, the ledger or a payment.
  SHADOW
  /// Observations additionally become PENDING_REVIEW vision events bound to
  /// the journey's checkout session, so a human can approve them in.
  PROPOSE
  /// As PROPOSE, and confident observations that pass inventory validation
  /// are approved automatically. Everything else still waits for a human.
  AUTO_APPLY
}

/// What the bridge did with one journey observation. Append-once per
/// observation, which is what makes projection idempotent.
enum StoreFlowProjectionOutcome {
  /// Not a product observation (entry, exit, shelf interaction), or the
  /// policy was SHADOW when it was projected.
  SKIPPED
  /// A vision event was created and awaits a human.
  PROPOSED
  /// A vision event was created and approved automatically into the basket.
  AUTO_APPLIED
  /// Deliberately routed to a human: low confidence, an inventory
  /// implausibility, or an observation the pipeline itself flagged.
  REVIEW_REQUIRED
  /// A human rejected the observation through the unified queue.
  REJECTED
}

/// How far the settlement pipeline has taken a store-flow journey.
enum StoreFlowSettlementStatus {
  NOT_STARTED
  BLOCKED_ON_REVIEW
  ORDER_CREATED
  PAID
  FAILED
}

/// A shopper in one tenant's stores. Anonymous by default — a row exists so
/// journeys, baskets and orders have a stable subject, and it carries no
/// personal data of its own. userId is set only when the shopper is a
/// signed-in platform user (staff testing the flow, or an app account).
model Shopper {
  id        String        @id @default(cuid())
  tenantId  String
  userId    String?
  status    ShopperStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation("ShopperUser", fields: [userId], references: [id], onDelete: Restrict)

  entryTokens StoreEntryToken[]
  journeys    CustomerJourney[]

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, userId])
}

/// A single-use, short-TTL store entry credential (SECURITY.md: store-entry
/// and session tokens are single-use and short-TTL, and no long-lived entry
/// credential is ever issued). The secret is returned exactly once at
/// issuance; only its SHA-256 digest is stored, so a database read can never
/// recover a usable token.
model StoreEntryToken {
  id                String                @id @default(cuid())
  tenantId          String
  locationId        String
  unitId            String
  shopperId         String?
  /// Hex SHA-256 of the issued secret. Never the secret itself.
  tokenHash         String
  status            StoreEntryTokenStatus @default(ISSUED)
  expiresAt         DateTime
  redeemedAt        DateTime?
  /// Set on redemption. UNIQUE, so one token can only ever open one journey.
  redeemedJourneyId String?               @unique
  revokedAt         DateTime?
  issuedById        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit     RetailUnit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  shopper  Shopper?         @relation(fields: [shopperId], references: [id], onDelete: Restrict)
  issuedBy User?            @relation("StoreEntryTokenIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  journey  CustomerJourney? @relation("StoreEntryTokenJourney", fields: [redeemedJourneyId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, tokenHash])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, locationId, unitId])
}

/// The autonomy policy for a tenant, or for one store within it. The row
/// itself holds no settings — it points at the ACTIVE version, so a change is
/// always a new immutable version and reverting is copying an old one
/// forward, exactly like a price book.
model StoreFlowPolicy {
  id              String   @id @default(cuid())
  tenantId        String
  /// NULL = the tenant-wide default. Set = overrides the default at that
  /// store. A partial unique index in migration SQL keeps at most one
  /// tenant-wide row per tenant (Postgres treats NULLs as distinct).
  locationId      String?
  activeVersionId String?  @unique
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location      Location?                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy     User?                    @relation("StoreFlowPolicyActor", fields: [createdById], references: [id], onDelete: Restrict)
  activeVersion StoreFlowPolicyVersion?  @relation("StoreFlowPolicyActiveVersion", fields: [activeVersionId], references: [id], onDelete: Restrict)
  versions      StoreFlowPolicyVersion[] @relation("StoreFlowPolicyVersions")

  @@unique([id, tenantId])
  @@unique([tenantId, locationId])
  @@index([tenantId, locationId])
}

/// One immutable set of autonomy settings. Never edited after creation.
model StoreFlowPolicyVersion {
  id                         String                 @id @default(cuid())
  tenantId                   String
  policyId                   String
  /// Monotonic per policy, starting at 1. Never reused.
  versionNumber              Int
  autonomyLevel              StoreFlowAutonomyLevel @default(SHADOW)
  /// Minimum fused score an observation must carry before AUTO_APPLY may
  /// apply it without a human. This is an uncalibrated ranking score, not a
  /// probability — see docs/cv/clip-lab.md.
  autoApplyMinConfidence     Float                  @default(0.7)
  /// When true (the default) an observation is checked against the store's
  /// inventory projection before it can be applied automatically.
  requireInventoryValidation Boolean                @default(true)
  /// When true, exiting a journey completes its checkout session into an
  /// order and settles it through the payment state machine.
  settleOnExit               Boolean                @default(false)
  /// Operator note. Screened for credential- and payment-bearing content on
  /// the way in, like every other free-text field in this codebase.
  note                       String?
  createdById                String?
  createdAt                  DateTime               @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  policy    StoreFlowPolicy  @relation("StoreFlowPolicyVersions", fields: [policyId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("StoreFlowPolicyVersionActor", fields: [createdById], references: [id], onDelete: Restrict)
  activeFor StoreFlowPolicy? @relation("StoreFlowPolicyActiveVersion")

  @@unique([id, tenantId])
  @@unique([policyId, versionNumber])
  @@index([tenantId, policyId, versionNumber])
}

/// The record of what the bridge did with one journey observation. One row
/// per journey event (UNIQUE), which is what makes a replayed sync a no-op
/// instead of a second basket line.
model StoreFlowProjection {
  id             String                     @id @default(cuid())
  tenantId       String
  journeyId      String
  journeyEventId String
  outcome        StoreFlowProjectionOutcome
  /// Controlled vocabulary only (see store-flow.constants.ts) — never
  /// pipeline or reviewer free text.
  reasonCode     String
  /// The vision event this observation became, when it became one.
  visionEventId  String?                    @unique
  /// The autonomy level in force when the observation was projected.
  autonomyLevel  StoreFlowAutonomyLevel
  /// The observation's fused score at projection time, for the audit trail.
  confidence     Float?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journey      CustomerJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  journeyEvent CustomerJourneyEvent @relation(fields: [journeyEventId], references: [id], onDelete: Cascade)
  visionEvent  VisionEvent?         @relation(fields: [visionEventId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, journeyEventId])
  @@index([tenantId, journeyId, createdAt])
  @@index([tenantId, outcome])
}

// ---------------------------------------------------------------------------
// Phase 27 — returns, refunds and inventory reconciliation: the reverse flow.
//
// Everything below is a DECISION RECORD. None of it is a second source of
// truth for stock or for money:
//
//   * Stock only ever changes through InventoryMovement. A return, a
//     cancellation, a cycle-count variance and a shrink each APPEND one
//     movement through the same `InventoryRepository.applyMovement` the sale
//     path uses, and each row below merely cites the movement it produced
//     (`movementId`). Nothing here writes an InventoryLevel.
//   * Money only ever moves through the provider-neutral payment abstraction.
//     A refund is a PaymentRefund against a CAPTURED intent, bounded by what
//     that intent actually captured, and settled by the owned refund-gateway
//     port (SIMULATED only — there is still no live gateway anywhere).
//
// SECURITY INVARIANT (AGENTS.md, unchanged): no raw card data. Every operator
// free-text field here (return reason, count note, discrepancy note, shrink
// reason) is screened for credential-/payment-bearing content before it is
// written, because these strings are persisted verbatim AND copied into
// AuditLog.reason, which audit redaction does not cover.
// ---------------------------------------------------------------------------

/// A refund's own lifecycle, independent of the intent's. PENDING is written
/// BEFORE the gateway is called (so a crash mid-flight leaves a visible,
/// replayable record instead of a silent gap); the gateway's answer settles it
/// to SUCCEEDED or FAILED exactly once.
enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Simulated money movement BACK to a shopper, against one captured payment.
///
/// Bounded by construction: the sum of PENDING + SUCCEEDED refunds on an
/// intent can never exceed the intent's `capturedAmountMinor` (checked under
/// the intent advisory lock, with a CHECK constraint on the intent as the
/// backstop). Idempotent by construction: (tenantId, idempotencyKey) is
/// unique, so a replayed refund request re-reads the original row instead of
/// moving money twice.
model PaymentRefund {
  id                String              @id @default(cuid())
  tenantId          String
  intentId          String
  /// The capture this money is coming back out of. Nullable only for the
  /// (unreachable today) case of a captured intent with no capture row.
  captureId         String?
  status            PaymentRefundStatus @default(PENDING)
  amountMinor       Int
  currencyCode      String
  /// Operator-supplied justification. Screened before persistence; also the
  /// audit reason.
  reason            String?
  /// OPAQUE provider references — never secrets, never card data.
  providerRef       String?
  providerRefundRef String?
  failureReason     String?
  /// Tenant-scoped idempotency for the refund request.
  idempotencyKey    String?
  requestedAt       DateTime            @default(now())
  settledAt         DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  intent    PaymentIntent   @relation(fields: [intentId], references: [id], onDelete: Restrict)
  capture   PaymentCapture? @relation(fields: [captureId], references: [id], onDelete: Restrict)
  createdBy User?           @relation("PaymentRefundActor", fields: [createdById], references: [id], onDelete: Restrict)
  returns   OrderReturn[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, intentId, createdAt, id])
  @@index([tenantId, status, createdAt, id])
}

/// Why goods came back. A CUSTOMER_RETURN takes named lines back; an
/// ORDER_CANCELLATION reverses the whole remaining order and cancels it.
enum OrderReturnKind {
  CUSTOMER_RETURN
  ORDER_CANCELLATION
}

/// The return's own lifecycle. RECORDED means the goods are accounted for
/// (stock reversed) and no money is owed — either nothing was captured or the
/// operator asked for no refund. The REFUND_* states track the money.
enum OrderReturnStatus {
  RECORDED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

/// Why a return recorded no refund. A closed vocabulary, never free text, so
/// the reason a shopper got no money back is always legible.
enum RefundSkipReason {
  /// The caller explicitly asked for a stock-only return.
  NOT_REQUESTED
  /// No payment intent on this order ever reached CAPTURED — including one
  /// that ended CANCELLED/FAILED/VOIDED/EXPIRED. There is no money to return.
  NO_CAPTURED_PAYMENT
  /// The returned lines carry no price (an order completed before pricing, or
  /// with an unpriced basket), so no amount can be justified.
  NO_PRICEABLE_LINES
  /// Everything this order captured has already been refunded.
  ALREADY_FULLY_REFUNDED
}

/// One return or cancellation against one order. Append-only in spirit: the
/// lines and their movements are written once inside a single transaction, and
/// afterwards only the refund linkage (`status`, `refundId`,
/// `refundSkipReason`) is ever set.
model OrderReturn {
  id                String            @id @default(cuid())
  tenantId          String
  orderId           String
  kind              OrderReturnKind
  status            OrderReturnStatus @default(RECORDED)
  /// Tenant-scoped idempotency reference supplied by the caller: replaying a
  /// return request returns the original return instead of reversing stock
  /// twice. Same contract as the goods-receipt (`recordMovement`) path.
  reference         String
  /// Operator free text, screened before persistence (also the audit reason).
  reason            String
  /// Total units that actually went back on the shelf (sum of the lines'
  /// restocked quantities). Derived at write time; never a stock figure.
  restockedQuantity Int               @default(0)
  /// Money owed back, derived from the returned lines' snapshotted prices.
  refundAmountMinor Int?
  currencyCode      String?
  refundId          String?
  refundSkipReason  RefundSkipReason?
  recordedById      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund     PaymentRefund?    @relation(fields: [refundId], references: [id], onDelete: Restrict)
  recordedBy User?             @relation("OrderReturnActor", fields: [recordedById], references: [id], onDelete: Restrict)
  lines      OrderReturnLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@index([tenantId, orderId, createdAt, id])
  @@index([tenantId, status, createdAt, id])
}

/// One order line coming back. `movementId` cites the RETURN_IN ledger entry
/// this line produced — NULL when the goods were not restocked (damaged or
/// unsellable), which is the honest record that stock did not change.
model OrderReturnLine {
  id                String   @id @default(cuid())
  tenantId          String
  returnId          String
  orderLineId       String
  productId         String
  /// Snapshot of what was returned, so history never rewrites when the
  /// catalog is edited (same rule as OrderLine).
  sku               String
  productName       String
  quantity          Int
  /// Whether these units went back on the shelf.
  restocked         Boolean  @default(true)
  movementId        String?
  /// Per-line money, derived from the order line's snapshotted unit price.
  refundAmountMinor Int?
  /// Operator note about condition. Screened before persistence.
  note              String?
  createdAt         DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  return    OrderReturn        @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderLine OrderLine          @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  movement  InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, returnId])
  @@index([tenantId, orderLineId])
}

/// A count's lifecycle. OPEN accepts counted quantities; RECONCILED is
/// terminal and means every line has been compared and any variance has
/// already become a ledger movement. CANCELLED is an abandoned count — it
/// never touched stock.
enum CycleCountStatus {
  OPEN
  RECONCILED
  CANCELLED
}

/// An operator counting a location — a spot cycle count or a full stocktake.
///
/// A count NEVER SETS STOCK. Reconciling compares three numbers (what was
/// counted, what the projection says, and what the ledger replays to) and
/// writes a signed CORRECTION_IN / CORRECTION_OUT movement for the
/// difference. The ledger stays the only history of how stock got where it is.
model CycleCount {
  id              String           @id @default(cuid())
  tenantId        String
  locationId      String
  /// Tenant-scoped idempotency/reference the operator can quote.
  reference       String
  status          CycleCountStatus @default(OPEN)
  /// Set when the whole location was counted (a stocktake) rather than a
  /// sample of products (a cycle count). Recorded for the audit trail only —
  /// it changes no arithmetic.
  isFullStocktake Boolean          @default(false)
  /// Operator free text, screened before persistence.
  note            String?
  reconciledAt    DateTime?
  cancelledAt     DateTime?
  createdById     String?
  reconciledById  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location     Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("CycleCountActor", fields: [createdById], references: [id], onDelete: Restrict)
  reconciledBy User?            @relation("CycleCountReconciler", fields: [reconciledById], references: [id], onDelete: Restrict)
  lines        CycleCountLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@index([tenantId, locationId, status])
  @@index([tenantId, status, createdAt, id])
}

/// One product counted at one location.
///
/// The three quantities are kept side by side on purpose:
///   countedQuantity  — what the human found on the shelf.
///   systemQuantity   — what the InventoryLevel projection said, read under
///                      the per-product advisory lock at reconcile time.
///   ledgerQuantity   — what the append-only movement ledger replays to.
/// `varianceQuantity` = counted − system, and is what becomes a movement.
/// `ledgerDriftQuantity` = system − ledger and must ALWAYS be zero; a
/// non-zero value means the projection and its own history disagree, which is
/// a platform bug, not a stock discrepancy, and is surfaced rather than
/// silently corrected.
model CycleCountLine {
  id                  String   @id @default(cuid())
  tenantId            String
  cycleCountId        String
  productId           String
  countedQuantity     Int
  systemQuantity      Int?
  ledgerQuantity      Int?
  varianceQuantity    Int?
  ledgerDriftQuantity Int?
  /// The CORRECTION_IN / CORRECTION_OUT movement this line's variance
  /// produced. NULL when there was no variance — the honest record that
  /// reconciling this line changed nothing.
  movementId          String?
  /// Operator discrepancy note. Screened before persistence.
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cycleCount CycleCount         @relation(fields: [cycleCountId], references: [id], onDelete: Restrict)
  product    Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  movement   InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  /// tenantId leads deliberately: it makes the composite key a TENANT-SCOPED
  /// write predicate, so an upsert can never reach another tenant's line.
  @@unique([tenantId, cycleCountId, productId])
  @@index([tenantId, cycleCountId])
  @@index([tenantId, productId])
}

/// Where a shrink decision came from. CV_DETECTED is the Phase 27 path: a
/// vision observation of goods leaving that no order ever accounted for.
enum ShrinkSource {
  CV_DETECTED
  OPERATOR
}

/// A recorded write-off of stock that left without being paid for.
///
/// At most ONE per vision event ((tenantId, visionEventId) is unique), so a
/// replayed decision can never write off the same loss twice. The SHRINK
/// ledger movement is the stock change; this row is why it happened.
model ShrinkEvent {
  id            String       @id @default(cuid())
  tenantId      String
  locationId    String
  productId     String
  /// The observation that detected the loss. NULL only for an OPERATOR-source
  /// write-off, which has no camera evidence behind it.
  visionEventId String?      @unique
  source        ShrinkSource @default(CV_DETECTED)
  quantity      Int
  /// Operator free text, screened before persistence (also the audit reason).
  reason        String
  /// The SHRINK movement this decision produced. NOT NULL: a shrink record
  /// without its ledger entry would be a stock claim with no history.
  movementId    String
  recordedById  String?
  createdAt     DateTime     @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location    Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  visionEvent VisionEvent?      @relation(fields: [visionEventId], references: [id], onDelete: Restrict)
  movement    InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  recordedBy  User?             @relation("ShrinkEventActor", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, locationId, createdAt, id])
  @@index([tenantId, productId, createdAt, id])
}

// ---------------------------------------------------------------------------
// Phase 28 — Electronic shelf labels.
//
// Labels are physical devices owned by a vendor gateway. BYOND never speaks a
// vendor protocol in domain code: every gateway names a `vendorCode` that
// resolves to an adapter behind EslVendorPort, and credentials are NEVER
// stored here — `credentialRef` is an opaque key the runtime looks up in
// configuration. Price propagation is queue-driven with the same lease +
// attempt-budget + fencing-token idiom as the inference queue, so a hung
// worker cannot strand a label and a replayed activation cannot double-push.
// ---------------------------------------------------------------------------

enum EslGatewayStatus {
  /// Registered but never reached; cannot be claimed by the processor.
  PENDING
  ACTIVE
  /// Operator-disabled. Jobs for its labels are cancelled, not retried.
  DISABLED
  /// Was ACTIVE, last contact failed. Still claimable — it may recover.
  UNREACHABLE
}

enum EslLabelStatus {
  /// Discovered on the gateway, not yet bound to a product.
  UNBOUND
  BOUND
  /// Physically removed. Never enqueued again.
  RETIRED
}

enum EslUpdateJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  /// The label was retired or its gateway disabled before delivery.
  CANCELLED
}

/// Why a label needed re-rendering. Closed vocabulary — a new trigger is a
/// schema change, never a free-text string.
enum EslUpdateTrigger {
  PRICE_ACTIVATION
  MANUAL_RERENDER
  LABEL_BOUND
  /// Enqueued by the reconciliation sweep, which repairs labels whose
  /// rendered version drifted from the price that is actually in force.
  RECONCILIATION
}

/// Closed error vocabulary. `lastErrorMessage` is a screened, vendor-supplied
/// string kept for operators; code is what logic branches on.
enum EslUpdateErrorCode {
  GATEWAY_UNREACHABLE
  GATEWAY_DISABLED
  LABEL_UNREACHABLE
  LABEL_RETIRED
  VENDOR_REJECTED
  VENDOR_TIMEOUT
  /// No price resolves for the bound product, so there is nothing to show.
  CONTENT_UNRESOLVABLE
  UNKNOWN_VENDOR
  LEASE_EXPIRED
}

/// A vendor gateway serving the labels in one location.
model EslGateway {
  id            String           @id @default(cuid())
  tenantId      String
  /// Unique per tenant, normalized to uppercase (like PriceBook.code).
  code          String
  name          String
  /// Selects the adapter behind EslVendorPort. 'SIMULATED' always resolves.
  vendorCode    String
  /// Labels belong to a store; a gateway is always location-bound.
  locationId    String
  status        EslGatewayStatus @default(PENDING)
  /// OPAQUE configuration key (e.g. 'ACME_STORE_01'). The runtime resolves it
  /// to a credential from the environment. A secret must NEVER be written
  /// here; the service rejects credential-shaped values.
  credentialRef String?
  /// Vendor-neutral, credential-free connection hints. Screened on write by
  /// findSensitiveKeyPath, exactly as Device.metadata is.
  metadata      Json?
  lastSeenAt    DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("EslGatewayActor", fields: [createdById], references: [id], onDelete: Restrict)

  labels     EslLabel[]
  updateJobs EslUpdateJob[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, locationId, status])
}

/// One physical label.
model EslLabel {
  id                  String         @id @default(cuid())
  tenantId            String
  gatewayId           String
  /// The vendor's own identifier for the hardware. Unique per gateway.
  vendorLabelId       String
  productId           String?
  /// Optional planogram placement, so a label can be traced to a shelf cell.
  cellAssignmentId    String?
  status              EslLabelStatus @default(UNBOUND)
  batteryPercent      Int?
  signalPercent       Int?
  /// What the label is actually SHOWING — set only when a push succeeded.
  lastRenderedAt      DateTime?
  renderedVersionId   String?
  /// Hash of the rendered content, so reconciliation can tell "already
  /// correct" from "never pushed" without storing the content itself.
  renderedContentHash String?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  gateway         EslGateway               @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  product         Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  cellAssignment  PlanogramCellAssignment? @relation(fields: [cellAssignmentId], references: [id], onDelete: Restrict)
  renderedVersion PriceBookVersion?        @relation("EslLabelRenderedVersion", fields: [renderedVersionId], references: [id], onDelete: Restrict)
  createdBy       User?                    @relation("EslLabelActor", fields: [createdById], references: [id], onDelete: Restrict)

  updateJobs EslUpdateJob[]

  @@unique([id, tenantId])
  @@unique([gatewayId, vendorLabelId])
  @@index([tenantId, status])
  @@index([tenantId, productId])
  @@index([tenantId, gatewayId, status])
}

/// A queued push of content to one label.
model EslUpdateJob {
  id                 String              @id @default(cuid())
  tenantId           String
  labelId            String
  /// Denormalized from the label so the processor can batch by gateway
  /// without a join, and so a claim stays a single indexed read.
  gatewayId          String
  trigger            EslUpdateTrigger
  /// The activation that caused this push, when there was one.
  priceBookVersionId String?
  status             EslUpdateJobStatus  @default(QUEUED)
  /// Content fingerprint at enqueue time. A push whose label already shows
  /// this hash is a no-op success, which makes replay free.
  contentHash        String
  /// Tenant-scoped de-duplication. For a price activation this is
  /// "<versionId>:<labelId>", so the same activation can never enqueue twice.
  idempotencyKey     String
  attempts           Int                 @default(0)
  /// Set on claim; the worker echoes it back as a fencing token so a late
  /// result from a reclaimed attempt cannot commit over the live one.
  claimedAttempt     Int?
  leaseExpiresAt     DateTime?
  /// Backoff gate: a QUEUED job is invisible to claims until this instant.
  nextAttemptAt      DateTime            @default(now())
  lastErrorCode      EslUpdateErrorCode?
  lastErrorMessage   String?
  requestedAt        DateTime            @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  label            EslLabel          @relation(fields: [labelId], references: [id], onDelete: Restrict)
  gateway          EslGateway        @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  priceBookVersion PriceBookVersion? @relation("EslJobPriceVersion", fields: [priceBookVersionId], references: [id], onDelete: Restrict)
  createdBy        User?             @relation("EslUpdateJobActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, nextAttemptAt, requestedAt, id])
  @@index([tenantId, labelId, status])
  @@index([tenantId, gatewayId, status])
  @@index([tenantId, priceBookVersionId])
}

// ---------------------------------------------------------------------------
// Phase 29 — Loyalty and promotions.
//
// THE CENTRAL INVARIANT: a promotion must not bypass price versioning.
// Phase 25 made a price an immutable entry inside a versioned price book;
// Phase 28 made activation the event that drives shelf labels. Nothing here
// writes, supersedes, or shadows a price row. A promotion is a SEPARATE,
// SUBTRACTIVE layer that composes on top of the price version already in
// force:
//
//     paid = resolvePrice(product, at, location)   <- pricing, unchanged
//            - selectPromotion(...)                <- this module, on top
//
// Both halves are recorded on the basket line (priceBookVersionId,
// basePriceMinor, promotionVersionId, promotionDiscountMinor), so any price a
// shopper paid can be explained by naming exactly one price version and at
// most one promotion version. Promotions carry their own version lifecycle —
// DRAFT -> ACTIVE -> SUPERSEDED with half-open effective windows, and
// rollback by copying an old version forward — so a discount is as versioned,
// auditable and reversible as a price is, WITHOUT either one editing the
// other. A promotion that must appear on a shelf label is not modelled here
// at all: it is a price book version with reason PROMOTION_BASE, which the
// ESL pipeline already propagates.
// ---------------------------------------------------------------------------

enum LoyaltyAccountStatus {
  ACTIVE
  /// Operator-held. Accrues nothing, redeems nothing, wins no member-only
  /// promotion. History is kept intact.
  SUSPENDED
  /// Terminal. Never reopened — enrol a new account instead.
  CLOSED
}

/// WHY a points movement exists. The ledger is append-only, so a mistake is
/// corrected by appending a REVERSAL, never by editing or deleting a row.
enum LoyaltyPointMovementType {
  ACCRUAL
  REDEMPTION
  ADJUSTMENT
  EXPIRY
  REVERSAL
}

enum PromotionStatus {
  ACTIVE
  ARCHIVED
}

enum PromotionVersionStatus {
  /// Editable. Rules may be replaced; the version discounts nothing.
  DRAFT
  /// The current version of its promotion. At most ONE per promotion —
  /// enforced by a PARTIAL unique index in migration SQL.
  ACTIVE
  /// Was active, then replaced. Still applies inside its closed
  /// [effectiveFrom, effectiveTo) window, which is what makes a historical
  /// quote ("what did this basket cost last Tuesday?") reproducible.
  SUPERSEDED
  /// Withdrawn without ever having been active. Never discounts anything.
  ARCHIVED
}

/// Who a promotion is for. LOYALTY_MEMBERS requires an ACTIVE loyalty account
/// on the basket; ALL_SHOPPERS applies to everyone, member or not.
enum PromotionAudience {
  ALL_SHOPPERS
  LOYALTY_MEMBERS
}

/// How a rule reduces a base price. All three are strictly subtractive and
/// integer-exact on minor units — a promotion can only ever lower a price,
/// never raise it (see loyalty.logic.ts, and the CHECKs in migration SQL).
enum PromotionRuleKind {
  /// `value` is basis points off the base price (1..10000 = 0.01%..100%).
  PERCENT_OFF
  /// `value` is minor units off the base price.
  AMOUNT_OFF
  /// `value` is the promoted unit price in minor units. Ignored (no discount)
  /// when it is not BELOW the base price.
  FIXED_UNIT_PRICE
}

/// Closed vocabulary for why a promotion version exists. Free-form
/// justification goes in `note`, which is screened for credential- and
/// payment-bearing text before it is persisted (it also flows into
/// AuditLog.reason).
enum PromotionChangeReason {
  INITIAL
  RULE_CHANGE
  CORRECTION
  ROLLBACK
}

/// A loyalty membership. Tenant-scoped, identified by a member code the
/// operator issues.
model LoyaltyAccount {
  id          String               @id @default(cuid())
  tenantId    String
  /// Unique per tenant, normalized to uppercase (like Product.sku).
  memberCode  String
  /// Operator-facing label only. Screened free text — never an email, phone,
  /// card, or any other credential-shaped value.
  displayName String?
  status      LoyaltyAccountStatus @default(ACTIVE)
  /// FORWARD LINK to the Phase 26 `Shopper`, which does not exist on this
  /// branch. Deliberately a bare nullable column with NO Prisma relation and
  /// NO foreign key yet: when Shopper lands, wiring it is one ALTER TABLE
  /// adding the composite same-tenant FK plus one relation line here — no
  /// column rename, no backfill, no data migration. Until then the column is
  /// never written by the API (there is no DTO field for it), and the partial
  /// unique index in migration SQL already reserves "at most one loyalty
  /// account per shopper per tenant".
  shopperId   String?
  enrolledAt  DateTime             @default(now())
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("LoyaltyAccountActor", fields: [createdById], references: [id], onDelete: Restrict)

  movements        LoyaltyPointMovement[]
  checkoutSessions CheckoutSession[]

  @@unique([id, tenantId])
  @@unique([tenantId, memberCode])
  @@index([tenantId, status])
  @@index([tenantId, shopperId])
}

/// One append to an account's points ledger.
///
/// APPEND-ONLY, at the database level: a trigger in migration SQL rejects
/// UPDATE, DELETE and TRUNCATE, exactly as it does for InventoryMovement and
/// AuditLog. The balance is therefore always DERIVED (SUM of `points`) and is
/// never a mutable counter anywhere in the system. `balanceAfter` is an
/// immutable stamp of that sum at insert time, kept so the floor can be a
/// CHECK on the row being written rather than a decision the application is
/// trusted to have made correctly.
model LoyaltyPointMovement {
  id                 String                   @id @default(cuid())
  tenantId           String
  accountId          String
  /// Monotonic per account, starting at 1. The unique index on
  /// (accountId, sequenceNumber) is what makes a lost update impossible: two
  /// concurrent redemptions that both read the same tail collide on the
  /// insert instead of both succeeding.
  sequenceNumber     Int
  type               LoyaltyPointMovementType
  /// Signed: accruals positive, redemptions negative. Never zero (CHECK).
  points             Int
  /// Derived balance after this movement. CHECK >= 0 — an overdraw is a
  /// FAILED WRITE, not a negative balance somebody notices later.
  balanceAfter       Int
  /// Uppercase operator vocabulary (PURCHASE, GOODWILL, ...). Screened.
  reasonCode         String
  /// Screened free text; also copied into AuditLog.reason.
  note               String?
  /// Optional lineage: the order that earned or spent the points.
  orderId            String?
  /// Optional lineage: the promotion version that granted them.
  promotionVersionId String?
  /// Tenant-scoped replay key. A repeat of the same key returns the original
  /// movement instead of moving points twice.
  idempotencyKey     String
  createdById        String?
  /// No updatedAt by design — rows are never updated.
  createdAt          DateTime                 @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account          LoyaltyAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  promotionVersion PromotionVersion? @relation("LoyaltyPointsPromotionVersion", fields: [promotionVersionId], references: [id], onDelete: Restrict)
  createdBy        User?             @relation("LoyaltyPointMovementActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@unique([accountId, sequenceNumber])
  @@index([tenantId, accountId, createdAt])
  @@index([tenantId, orderId])
}

/// A named discount programme. Its RULES live in versions, never here, for
/// the same reason a price lives in a price book version and not on Product.
model Promotion {
  id          String            @id @default(cuid())
  tenantId    String
  /// Unique per tenant, normalized to uppercase.
  code        String
  /// Operator-facing. Screened free text.
  name        String
  status      PromotionStatus   @default(ACTIVE)
  audience    PromotionAudience @default(ALL_SHOPPERS)
  /// NULL = applies tenant-wide. Set = applies only at that location, and
  /// beats a tenant-wide promotion there (same specificity rule as a price
  /// book).
  locationId  String?
  /// Deterministic tie-break when two promotions offer the SAME discount.
  /// Higher wins. It is a tie-break only: it can never make a smaller
  /// discount beat a larger one.
  priority    Int               @default(0)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("PromotionActor", fields: [createdById], references: [id], onDelete: Restrict)

  versions PromotionVersion[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, locationId, status])
}

/// One immutable revision of a promotion. Same lifecycle as
/// PriceBookVersion, deliberately: an operator who understands how a price
/// change is made already understands how a discount change is made.
model PromotionVersion {
  id            String                 @id @default(cuid())
  tenantId      String
  promotionId   String
  /// Monotonic per promotion, starting at 1. Never reused.
  versionNumber Int
  status        PromotionVersionStatus @default(DRAFT)
  effectiveFrom DateTime
  /// Exclusive end of the window, written when a newer version activates.
  effectiveTo   DateTime?
  reason        PromotionChangeReason
  note          String?

  createdById             String?
  activatedById           String?
  activatedAt             DateTime?
  supersededByVersionId   String?   @unique
  rolledBackFromVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("PromotionVersionActor", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy User?     @relation("PromotionVersionActivator", fields: [activatedById], references: [id], onDelete: Restrict)

  supersededBy   PromotionVersion?  @relation("PromotionSupersession", fields: [supersededByVersionId], references: [id], onDelete: Restrict)
  supersedes     PromotionVersion?  @relation("PromotionSupersession")
  rolledBackFrom PromotionVersion?  @relation("PromotionRollback", fields: [rolledBackFromVersionId], references: [id], onDelete: Restrict)
  rollbackCopies PromotionVersion[] @relation("PromotionRollback")

  rules PromotionRule[]

  checkoutLines  CheckoutSessionLine[]  @relation("CheckoutLinePromotionVersion")
  orderLines     OrderLine[]            @relation("OrderLinePromotionVersion")
  pointMovements LoyaltyPointMovement[] @relation("LoyaltyPointsPromotionVersion")

  @@unique([id, tenantId])
  @@unique([promotionId, versionNumber])
  @@index([tenantId, promotionId, status])
  @@index([tenantId, promotionId, effectiveFrom])
  @@index([tenantId, status, effectiveFrom])
}

/// One rule inside one promotion version. Immutable once its version leaves
/// DRAFT, for the same reason a price entry is: an order that cited it must
/// stay explicable forever.
model PromotionRule {
  id               String            @id @default(cuid())
  tenantId         String
  versionId        String
  /// NULL = applies to every product the base price covers. Set = applies to
  /// that product only, and beats the catalog-wide rule of the same version.
  productId        String?
  kind             PromotionRuleKind
  /// Meaning depends on `kind` (see PromotionRuleKind). Always positive.
  value            Int
  /// Optional ceiling in minor units, for PERCENT_OFF. NULL = uncapped.
  maxDiscountMinor Int?
  createdAt        DateTime          @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  version PromotionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, versionId])
}

// ---------------------------------------------------------------------------
// Phase 31 — Procurement. Suppliers, purchase orders and goods receipts.
//
// The hard rule this domain has to respect is the inventory one: receiving
// stock is an append-only ledger movement like every other stock change, so a
// goods receipt NEVER writes a quantity. It posts RECEIPT movements through
// InventoryRepository.applyMovement and lets the projection follow.
//
// Ordered-vs-received is likewise a projection: PurchaseOrderLine has no
// mutable receivedQuantity counter. What was received is the sum of the
// GoodsReceiptLine rows pointing at it, so the order can never drift from the
// ledger the receipts produced.
// ---------------------------------------------------------------------------

enum SupplierStatus {
  ACTIVE
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Closed vocabulary for "what arrived is not what was ordered". NONE is the
/// ordinary case and is stored explicitly so an unset value is never ambiguous.
enum GoodsReceiptDiscrepancy {
  NONE
  SHORT_DELIVERY
  OVER_DELIVERY
  DAMAGED
  SUBSTITUTED
}

/// A vendor this tenant buys from. Contact metadata is deliberately a small
/// set of plain columns rather than free-form JSON: credentials and payment
/// instruments must never land here (AGENTS.md payments invariant), and the
/// service screens every free-text field before it is stored.
model Supplier {
  id           String         @id @default(cuid())
  tenantId     String
  /// Short code, unique per tenant, normalized to uppercase.
  code         String
  name         String
  status       SupplierStatus @default(ACTIVE)
  contactName  String?
  contactEmail String?
  contactPhone String?
  /// Default lead time in days, used to suggest an expected delivery date.
  leadTimeDays Int?
  notes        String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("SupplierActor", fields: [createdById], references: [id], onDelete: Restrict)

  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

/// What one supplier calls one of our products, and what they charge for it.
/// The current cost lives here for fast reads; every change appends a
/// SupplierProductCost row, so purchase cost is auditable and reversible the
/// same way retail price is (see PriceBookVersion).
model SupplierProduct {
  id            String   @id @default(cuid())
  tenantId      String
  supplierId    String
  productId     String
  /// The supplier's own identifier for this product, as printed on their
  /// paperwork. Unique per supplier.
  supplierSku   String
  /// Units of OUR product per supplier pack. Ordering 3 packs of 12 receives
  /// 36 units into the ledger.
  packSize      Int      @default(1)
  /// Current purchase cost of ONE PACK, in minor currency units.
  unitCostMinor Int
  currencyCode  String
  leadTimeDays  Int?
  isPreferred   Boolean  @default(false)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("SupplierProductActor", fields: [createdById], references: [id], onDelete: Restrict)

  costHistory        SupplierProductCost[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([id, tenantId])
  @@unique([supplierId, productId])
  @@unique([supplierId, supplierSku])
  @@index([tenantId, productId])
  @@index([tenantId, supplierId])
}

/// Append-only cost history. Rows are never updated or deleted; the newest
/// row by recordedAt is what SupplierProduct.unitCostMinor mirrors.
model SupplierProductCost {
  id                String   @id @default(cuid())
  tenantId          String
  supplierProductId String
  unitCostMinor     Int
  currencyCode      String
  packSize          Int
  /// Why the cost changed, in the operator's words. Screened for
  /// credential- and payment-shaped values before it is stored.
  reason            String?
  recordedById      String?
  recordedAt        DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  recordedBy      User?           @relation("SupplierProductCostActor", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, supplierProductId, recordedAt(sort: Desc)])
}

/// An order placed with a supplier, delivered to one location.
model PurchaseOrder {
  id                String              @id @default(cuid())
  tenantId          String
  /// Human-facing reference, unique per tenant (PO-2026-0001).
  reference         String
  supplierId        String
  /// Where the goods are delivered; receiving writes the ledger here.
  locationId        String
  status            PurchaseOrderStatus @default(DRAFT)
  currencyCode      String
  expectedAt        DateTime?
  submittedAt       DateTime?
  /// Set when the order reaches RECEIVED or CANCELLED — the terminal states.
  closedAt          DateTime?
  cancelledReason   String?
  /// Sum of line (packs x unit cost) at submission, in minor units. Null
  /// while DRAFT, because a draft's lines are still moving.
  totalCostMinor    Int?
  notes             String?
  /// Opaque acknowledgement reference returned by the supplier adapter. Never
  /// a URL, a credential, or anything the adapter was given in confidence.
  externalReference String?
  createdById       String?
  submittedById     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("PurchaseOrderActor", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy User?    @relation("PurchaseOrderSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([tenantId, reference])
  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, supplierId])
  @@index([tenantId, locationId])
}

/// One product on a purchase order. There is deliberately NO receivedQuantity
/// column: what arrived is derived from the GoodsReceiptLine rows.
model PurchaseOrderLine {
  id                String   @id @default(cuid())
  tenantId          String
  purchaseOrderId   String
  productId         String
  /// Nullable so a line survives the supplier catalog entry being archived.
  supplierProductId String?
  /// Product snapshot, immutable even if the catalog entry is edited later.
  sku               String
  productName       String
  /// Packs ordered (>= 1, CHECK in migration SQL).
  quantityOrdered   Int
  /// Units of our product per pack, snapshotted at order time.
  packSize          Int      @default(1)
  /// Cost of ONE PACK in minor units at order time.
  unitCostMinor     Int
  currencyCode      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: Restrict)

  receiptLines GoodsReceiptLine[]

  @@unique([id, tenantId])
  @@unique([purchaseOrderId, productId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, productId])
}

/// What physically arrived, once. Append-only: a receipt is never edited or
/// deleted, because the ledger movements it produced cannot be unwritten. A
/// mistake is corrected by a further receipt or an inventory correction.
model GoodsReceipt {
  id              String   @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  /// Human-facing reference, unique per tenant (GR-2026-0001).
  reference       String
  /// The supplier's delivery note number, as written on the paperwork.
  deliveryNote    String?
  receivedAt      DateTime @default(now())
  notes           String?
  /// Tenant-scoped idempotency for posting replays: the same key returns the
  /// receipt it already created instead of writing the ledger twice.
  idempotencyKey  String?
  receivedById    String?
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy    User?         @relation("GoodsReceiptActor", fields: [receivedById], references: [id], onDelete: Restrict)

  lines GoodsReceiptLine[]

  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@unique([id, tenantId])
  @@index([tenantId, purchaseOrderId, receivedAt(sort: Desc)])
}

/// One product line of one receipt, and the ledger movement it produced.
/// `inventoryMovementId` is the audit bridge: every received unit is
/// traceable to the exact append-only movement that admitted it.
model GoodsReceiptLine {
  id                  String                  @id @default(cuid())
  tenantId            String
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String
  /// Packs accepted on this line. Zero is legal (nothing arrived); negative
  /// is not (CHECK in migration SQL).
  quantityReceived    Int
  /// Units of our product per pack, snapshotted from the order line, so the
  /// ledger delta is reconstructible without a join.
  packSize            Int                     @default(1)
  /// quantityReceived x packSize — the signed delta written to the ledger.
  unitsReceived       Int
  discrepancy         GoodsReceiptDiscrepancy @default(NONE)
  discrepancyNote     String?
  /// The RECEIPT movement this line appended. Null only when the line
  /// received nothing, so no movement was written.
  inventoryMovementId String?                 @unique
  createdAt           DateTime                @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryMovement InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
