# Local development configuration — placeholder values only.
# Never put real credentials in this file or commit a real .env.
DATABASE_URL=postgresql://byond:byond@localhost:5432/byond_dev
PORT=3000
NODE_ENV=development

# JWT signing secret (HS256). REQUIRED, minimum 32 characters, and the app
# refuses to boot with placeholder-looking values. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Explicit unit REQUIRED (3600s, 15m, 1h, 7d). Unitless values are rejected —
# jsonwebtoken would read "900" as 900 milliseconds.
JWT_EXPIRES_IN=15m

# Browser origins allowed by CORS (comma-separated, no wildcard). Defaults
# to the local admin-web dev server. NOTE: this is an EXACT-origin allowlist —
# localhost and 127.0.0.1 are different origins, and Vite moves from 5173 to
# 5174 when 5173 is busy, so local dev should list every combination.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Express "trust proxy" — how req.ip is derived (login throttling keys on it).
# Leave unset/false unless this instance runs behind a proxy you control.
# Allowed: true | false | loopback | linklocal | uniquelocal | <hop count>
# TRUST_PROXY=false

# Login throttling (per IP + email, in-memory). Defaults: 5 attempts / 60s.
# LOGIN_THROTTLE_LIMIT=5
# LOGIN_THROTTLE_WINDOW_MS=60000

# Local-only platform admin seeding (pnpm run db:seed). BOTH variables below
# are required: SEED_PLATFORM_ADMIN=true is a separate explicit opt-in, so a
# routine catalog seed with a stray password in the environment can never
# create an administrator by accident. Never set these in shared or
# production environments (production additionally requires SEED_ALLOW_PROD).
# Password must satisfy the login policy: 8+ characters, at most 72 UTF-8 bytes.
# SEED_PLATFORM_ADMIN=true
# SEED_ADMIN_EMAIL=admin@byond.local
# SEED_ADMIN_PASSWORD=choose-a-local-only-password

# Phase 10 — video ingestion (local/dev storage ONLY; never a public bucket).
# Uploaded test videos and extracted frame/crop artifacts are stored under
# this gitignored directory behind server-generated keys; the path is never
# exposed through the API. Relative paths resolve against services/api.
# VIDEO_STORAGE_ROOT=../../.local/video-ingest
# Upload ceiling in bytes (default 52428800 = 50 MiB — short test clips
# only; hard maximum 268435456 = 256 MiB, enforced at boot: uploads buffer
# in memory and the size column is a signed 32-bit integer).
# VIDEO_MAX_UPLOAD_BYTES=52428800
# Opt-in local system ffmpeg adapter for real frame/crop extraction. Off by
# default: the simulated extractor covers dev/test without media tooling.
# VIDEO_FFMPEG_ENABLED=false
# Opt-in local system tesseract adapter for the PRE-STORAGE frame screen
# (OCR over EVERY decoded source frame of every upload — no sampling —
# BEFORE any byte reaches durable storage). Off by default: the simulated
# recognizer never reads pixels, so with it uploads fail closed (503) —
# there is no bypass.
# VIDEO_OCR_ENABLED=false
# Ceiling on the probed duration (ms) eligible for the mandatory
# pre-storage frame screen: every source frame is OCR-screened, so this —
# together with VIDEO_MAX_SCREENING_FRAMES — bounds the synchronous upload
# request. Longer clips are a controlled 400 before any byte is stored.
# Default 30000 (30 s); boot-enforced bounds 1000..300000.
# VIDEO_MAX_SCREENING_DURATION_MS=30000
# Ceiling on the DECODED FRAME COUNT eligible for the pre-storage screen:
# the screen decodes and OCR-inspects EVERY source frame (an fps sample
# would let content visible only between samples pass), so worst case ONE
# upload costs up to this many OCR calls — byte-identical frames are
# sha256-deduped first, so static test scenes collapse to a handful.
# Clips whose estimated frame count (ceil(fps x duration)) exceeds it are
# a controlled 400 before any decode, as is a VFR decode that still runs
# past it. Default 900 (30 fps x 30 s); boot-enforced bounds 30..3600.
# VIDEO_MAX_SCREENING_FRAMES=900
# Master switch for the ONLY upload mode Phase 10 supports: controlled
# INTERNAL TEST clips, ingested under an explicit policy gate. REQUIRED for
# uploads to be accepted at all — unset/false means the endpoint accepts
# nothing. NON-PRODUCTION ONLY: setting it to true FAILS startup validation
# unless NODE_ENV is explicitly development or test (an unset NODE_ENV fails
# too). This flag does not make video content safe — text/OCR screening is
# only a rejection layer, and the clips themselves must be ones you control.
# VIDEO_TEST_MEDIA_INGEST_ENABLED=false
# Aggregate wall-clock budget (ms) for screening ONE upload: total time spent
# decoding plus OCR-screening it, not a per-frame allowance. When the budget
# is spent the upload is rejected before any byte is stored, so a slow clip
# cannot hold an HTTP request or pin CPU indefinitely.
# Default 30000 (30 s); boot-enforced bounds 1000..300000.
# VIDEO_SCREENING_TIMEOUT_MS=30000
# UNSUPPORTED — the unscreened-upload bypass has been REMOVED in every
# environment (development, test, and production alike): raw media cannot
# be persisted before screening, so setting this to true FAILS startup
# validation everywhere. The variable remains declared only so env files
# that carry it as false/unset keep booting; the service never reads it.
# Leave unset.
# VIDEO_UNSAFE_ALLOW_UNSCREENED_UPLOADS=false

# Local VLM verifier (pickup-fusion-v2, SHADOW mode) — Ollama by default.
# No API key required in local mode; PICKUP_VLM_API_KEY only matters for
# PICKUP_VLM_PROVIDER=anthropic.
# PICKUP_VLM_ENABLED=true
# PICKUP_VLM_PROVIDER=local
# PICKUP_VLM_BASE_URL=http://127.0.0.1:11434
# PICKUP_VLM_MODEL=qwen2.5vl:7b
# Local default 60000 (60 s): a 7B vision model cold-loading into VRAM can
# need more than 30 s on its first generation. Anthropic default 30000.
# Boot-enforced bounds 1000..600000 (1 s .. 10 min).
# PICKUP_VLM_TIMEOUT_MS=60000
# PICKUP_VLM_MODE=VALIDATION_ALWAYS
# Ollama context window for the multi-image evidence prompt. Ollama's own
# default (4096) is too small — frames + reference images ≈ 4600+ tokens,
# which fails with HTTP 400 "exceeds the available context size".
# Boot-enforced bounds 512..131072.
# PICKUP_VLM_NUM_CTX=8192
# LOCAL-DEV ONLY: map the retired {choice, confidence} VLM response shape
# onto the strict {verdict, selectedSku, ...} schema instead of rejecting
# it as INVALID_SCHEMA. Mapped results always carry LEGACY_SCHEMA_MAPPED
# and requiresHumanReview=true, so they can never auto-propose. Leave
# unset in anything resembling production.
# PICKUP_VLM_LEGACY_COMPAT=false

# Phase 19/20 — LOCAL pretrained vision provider slots (shadow-only
# evidence; never authoritative). classical (default) keeps only the
# always-ready classical fallback; yolo_local / hybrid enable the YOLO
# detector slot. NEVER an external API or cloud model call.
# CV_PRETRAINED_PROVIDER=yolo_local
# Lab-only deterministic stub inference (evidence labeled synthetic).
# CV_PRETRAINED_STUB_MODE=false

# Phase 20 — safe local model registry for the YOLO_LOCAL slot. Models are
# external, gitignored artifacts: <root>/<modelId>/manifest.json plus the
# weights file the manifest names. The API selects by REGISTRY KEY only;
# no path is ever exposed in a response. Missing interpreter/runtime/model
# keeps the slot UNAVAILABLE with a classified reason code.
# Absolute, or relative to the repo root. Default <repo>/ml/models.
# CV_LOCAL_MODEL_ROOT=ml/models
# CV_LOCAL_YOLO_MODEL_ID=yolo-retail-v1
# Bare executable on PATH (default python) or an absolute path. Needs
# `pip install ultralytics` (pulls torch + numpy) in that interpreter.
# CV_LOCAL_PYTHON_BIN=python
# Bounds 5000..300000 (default 60000).
# CV_LOCAL_YOLO_TIMEOUT_MS=60000
# CV_LOCAL_YOLO_CONF_THRESHOLD=0.25
# Frames per second of source time, 0.5..8 (default 2; max 32 frames/clip).
# CV_LOCAL_YOLO_FPS=2
# auto | cpu | cuda
# CV_LOCAL_YOLO_DEVICE=auto
