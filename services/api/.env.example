# BYOND API — example configuration. PLACEHOLDER VALUES ONLY.
#
# Never put a real credential in this file, and never commit a real .env.
#
# This file is GENERATED FROM src/config/env.validation.ts and kept in step
# with it by env-example-drift.spec.ts, which fails if the validator declares
# a key this file does not mention. That guard exists because of a trap this
# repository has already been bitten by: validateEnv runs with
# `whitelist: true`, so a variable that is NOT declared in the validator is
# STRIPPED before any module reads it. A flag set in the environment but
# missing from the validator is silently dead — it does not warn, it does not
# fail, it simply never takes effect.
#
# Every key below is listed with what it does, whether it is required, and
# its default. Optional keys are commented out: uncomment only what the
# deployment actually needs. A commented key means "the code's default
# applies", which is always the safe choice.

# =============================================================================
# Core — the two REQUIRED keys, and the basics of how the process is reached
# =============================================================================

# REQUIRED. PostgreSQL connection string for this deployment.
DATABASE_URL=postgresql://byond:byond@localhost:5432/byond_dev

# REQUIRED. HS256 secret signing every access token. Minimum 32 characters,
# and the app REFUSES TO BOOT on placeholder-looking values (change-me,
# example, secret, password, ...), so generate a real one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token lifetime. An explicit unit is REQUIRED (3600s, 15m, 1h, 7d);
# jsonwebtoken would read a unitless "900" as 900 milliseconds. Default 15m.
JWT_EXPIRES_IN=15m

# HTTP port the API listens on. Default 3000.
PORT=3000

# development | test | production. Several capabilities are non-production
# only and an UNSET value is treated exactly like production. Default unset.
NODE_ENV=development

# Browser origins allowed by CORS, comma-separated. EXACT-origin allowlist,
# never a wildcard: localhost and 127.0.0.1 are different origins, and Vite
# moves to 5174 when 5173 is busy. Default http://localhost:5173.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Express "trust proxy" — how req.ip is derived, which is what EVERY throttle
# below keys on. Leave false unless this instance really is behind a proxy
# you control; behind an untrusted proxy every caller shares one bucket.
# Allowed: true | false | loopback | linklocal | uniquelocal | <hop count>.
# Default false.
# TRUST_PROXY=false

# =============================================================================
# Rate limiting — the public, unauthenticated surfaces
# =============================================================================
# In-memory sliding windows, per process. A multi-instance deployment needs
# shared (Redis-backed) throttling as well; these are the app-level control.

# POST /auth/login: attempts per (IP + attempted email) per window.
# Default 5.
# LOGIN_THROTTLE_LIMIT=5

# POST /auth/login: total attempts per IP per window regardless of which
# emails are tried (bounds credential stuffing). Default 4x the above.
# LOGIN_THROTTLE_IP_LIMIT=20

# Sliding-window width for the login buckets, ms. Default 60000.
# LOGIN_THROTTLE_WINDOW_MS=60000

# POST /shopper/session: redemption attempts per IP per window. The tightest
# shopper bucket — this is the credential-guessing surface. Default 30.
# SHOPPER_SESSION_THROTTLE_LIMIT=30

# GET /shopper/basket and POST /shopper/exit: requests per CREDENTIAL per
# window. The bucket a real shopper meets while the app polls. Default 60.
# SHOPPER_VISIT_THROTTLE_LIMIT=60

# The same two routes: requests per IP per window however many credentials
# are presented, so rotating them evades nothing. Default 600.
# SHOPPER_VISIT_IP_THROTTLE_LIMIT=600

# Sliding-window width for the shopper buckets, ms. Default 60000.
# SHOPPER_THROTTLE_WINDOW_MS=60000

# =============================================================================
# Electronic shelf labels — the background queue runner
# =============================================================================
# Activating a price queues a push to every bound label. SOMETHING has to
# drain that queue: either this in-process runner, or an external scheduler
# hitting POST /esl/update-jobs/process and POST /esl/reconcile. A deployment
# that arranges NEITHER will show stale prices on shelves with no error
# anywhere.

# Master switch for the in-process runner. Default false.
# ESL_QUEUE_WORKER_ENABLED=false

# Milliseconds between drain sweeps. Bounds 1000..3600000. Default 15000.
# ESL_QUEUE_WORKER_INTERVAL_MS=15000

# Jobs claimed per tenant per sweep. Bounds 1..100. Default 50.
# ESL_QUEUE_WORKER_BATCH_SIZE=50

# Milliseconds between drift-repair passes per tenant (the reconcile half,
# which re-reads every bound label). Bounds 60000..86400000. Default 900000.
# ESL_RECONCILE_INTERVAL_MS=900000

# =============================================================================
# Video ingestion — local/dev storage ONLY, never a public bucket
# =============================================================================

# Server-side directory holding uploaded test clips and extracted frames,
# behind server-generated keys; never exposed through the API. Relative paths
# resolve against services/api. Default ../../.local/video-ingest.
# VIDEO_STORAGE_ROOT=../../.local/video-ingest

# Upload ceiling in bytes. Uploads buffer in memory and the size column is a
# signed 32-bit integer, so the boot-enforced maximum is 268435456 (256 MiB).
# Default 52428800 (50 MiB).
# VIDEO_MAX_UPLOAD_BYTES=52428800

# Opt-in local system ffmpeg adapter for real frame/crop extraction. Off means
# the simulated extractor, which needs no media tooling. Default false.
# VIDEO_FFMPEG_ENABLED=false

# Opt-in local system OCR adapter for the mandatory PRE-STORAGE frame screen.
# Off means the simulated recognizer, with which uploads fail CLOSED (503) —
# there is no bypass. Default false.
# VIDEO_OCR_ENABLED=false

# Master switch for the only upload mode supported: controlled INTERNAL TEST
# clips. Unset/false means the endpoint accepts nothing. NON-PRODUCTION ONLY —
# true FAILS startup unless NODE_ENV is explicitly development or test (an
# unset NODE_ENV fails too). Default false.
# VIDEO_TEST_MEDIA_INGEST_ENABLED=false

# UNSUPPORTED. The unscreened-upload bypass is gone in EVERY environment;
# true fails startup everywhere. Declared only so env files carrying it as
# false keep booting. Leave unset.
# VIDEO_UNSAFE_ALLOW_UNSCREENED_UPLOADS=false

# Longest probed clip duration (ms) eligible for the pre-storage screen;
# longer clips are a controlled 400 before any byte is stored. Bounds
# 1000..300000. Default 30000.
# VIDEO_MAX_SCREENING_DURATION_MS=30000

# Ceiling on DECODED FRAMES per upload — the screen inspects every source
# frame, no sampling. Bounds 30..3600. Default 900 (30 fps x 30 s).
# VIDEO_MAX_SCREENING_FRAMES=900

# Whole-upload wall-clock budget (ms) for decode + screen, so a slow clip
# cannot hold a request open. Bounds 1000..300000. Default 30000.
# VIDEO_SCREENING_TIMEOUT_MS=30000

# How many decoded frames may be in OCR at once during that screen. Every
# unique frame is still recognized - this only bounds the side-by-side
# recognizer processes (each holds one PNG frame). The recognizer costs
# ~0.4 s per 1080p frame on a laptop CPU, so a 60 fps phone clip (530
# frames for 9 s) needs ~220 s sequentially against the 120 s enforceable
# deadline, and ~40 s at 6. Size to roughly cores / 3.
# Default 1 (sequential); boot-enforced bounds 1..16.
# VIDEO_SCREENING_OCR_CONCURRENCY=1

# =============================================================================
# Pickup detection — the CV pipeline's own switches
# =============================================================================

# Master switch for the automatic pickup-detection worker AND the manual run
# endpoint. Default false.
# PICKUP_DETECTION_ENABLED=false

# LAB/DEV ONLY. Let a store with ZERO inventory rows match against the
# tenant-wide catalog instead of matching nothing. A production store must
# never claim a pickup of a product it does not stock. Default false.
# PICKUP_LAB_MODE=false

# Analysis sampling rate, frames per second of source time. Bounds 1..15.
# Default 5.
# PICKUP_ANALYSIS_FPS=5

# Recognition confidence below which a match claims NOTHING (UNKNOWN_PRODUCT,
# no product id). Bounds 0..1. Default 0.62.
# PICKUP_CONFIDENCE_THRESHOLD=0.62

# Fusion v2: score at or above which a candidate may auto-propose. Bounds
# 0.05..1.
# PICKUP_FUSION_AUTO_THRESHOLD=0.62

# Fusion v2: VLM score below which the verdict is treated as weak. Bounds
# 0..1.
# PICKUP_FUSION_VLM_LOW=0.35

# Fusion v2: minimum gap between the top two candidates before either can
# auto-propose. Bounds 0..1.
# PICKUP_FUSION_MARGIN=0.08

# LIVE fast mode: skip the pre-VLM per-crop screening passes on live-window
# runs. Review-first behaviour is unchanged. Default false.
# CV_LIVE_FAST_MODE=false

# Dev/admin-only pilot test runner endpoint. Disabled means a controlled 409.
# Default false.
# CV_LIVE_PILOT_RUNNER_ENABLED=false

# Local YOLO ONNX model path for the fusion EVENT detector; empty means the
# classical motion detector runs alone. Default unset.
# PICKUP_YOLO_MODEL_PATH=

# Which adapter serves the fusion RETRIEVAL signal: hog_lab (dependency-free
# HOG-and-colour index) or clip_local (the local embedding runtime).
# Default hog_lab.
# PICKUP_RETRIEVAL_PROVIDER=hog_lab

# =============================================================================
# VLM verification — LOCAL by default; never a paid API implicitly
# =============================================================================

# Opt-in switch for the fusion VLM verification stage. Default false.
# PICKUP_VLM_ENABLED=false

# Which verifier adapter runs: local (Ollama on your own box) or anthropic.
# Default local.
# PICKUP_VLM_PROVIDER=local

# UNCERTAIN_ONLY verifies only the uncertainty band; VALIDATION_ALWAYS
# verifies every candidate (lab evaluation). Default UNCERTAIN_ONLY.
# PICKUP_VLM_MODE=UNCERTAIN_ONLY

# Per-verification deadline, ms. A 7B vision model cold-loading into VRAM can
# need more than 30 s. Bounds 1000..600000. Default 60000 local / 30000
# anthropic.
# PICKUP_VLM_TIMEOUT_MS=60000

# Local verifier endpoint. The adapter REFUSES any non-loopback URL.
# Default http://127.0.0.1:11434.
# PICKUP_VLM_BASE_URL=http://127.0.0.1:11434

# Remote verifier endpoint override, for PICKUP_VLM_PROVIDER=anthropic only.
# Default unset (the provider's own endpoint).
# PICKUP_VLM_ENDPOINT=

# Model name asked of whichever provider is selected.
# Default qwen2.5vl:7b locally.
# PICKUP_VLM_MODEL=qwen2.5vl:7b

# SECRET. Only used when PICKUP_VLM_PROVIDER=anthropic; local mode needs no
# key. Never commit a real value. Default unset.
# PICKUP_VLM_API_KEY=

# Ollama context window for the multi-image evidence prompt. Ollama's own
# default (4096) is too small and fails with HTTP 400. Bounds 512..131072.
# Default 8192.
# PICKUP_VLM_NUM_CTX=8192

# What ONE image costs in the prompt budget, in tokens (measured 1089 for
# qwen2.5-vl). Bounds 256..4096. Default 1100.
# PICKUP_VLM_TOKENS_PER_IMAGE=1100

# Reference photos shown to the VLM per candidate; fewer are sent
# automatically when they would not fit the context. Bounds 1..4. Default 3.
# PICKUP_VLM_REFERENCES_PER_CANDIDATE=3

# LOCAL-DEV ONLY. Map the retired {choice, confidence} response shape onto the
# strict schema instead of rejecting it; mapped results always require human
# review. Default false.
# PICKUP_VLM_LEGACY_COMPAT=false

# SHADOW/TEST-ONLY fault injection: NONE | UNAVAILABLE | INVALID_SKU. Any
# value but NONE FAILS startup unless NODE_ENV is explicitly development or
# test. Default NONE.
# PICKUP_VLM_FAULT=NONE

# =============================================================================
# Local vision runtime — local models only, no cloud inference
# =============================================================================

# Which LOCAL pretrained provider set the adapter registry enables:
# classical | yolo_local | embeddings_local | hybrid. Default classical.
# CV_PRETRAINED_PROVIDER=classical

# Lab-only DETERMINISTIC stub inference for the optional local adapters, so
# the evaluation flow can run before the heavy runtimes are installed. Stub
# evidence is labelled synthetic. Default false.
# CV_PRETRAINED_STUB_MODE=false

# Root of the safe local model registry: <root>/<modelId>/manifest.json plus
# the weights the manifest names. Absolute, or relative to the repo root.
# Models are external, gitignored artifacts. Default ml/models.
# CV_LOCAL_MODEL_ROOT=ml/models

# Registry KEY (directory name under the root) of the YOLO model to run —
# never a path. Unset leaves the slot UNAVAILABLE. Default unset.
# CV_LOCAL_YOLO_MODEL_ID=yolo-retail-v1

# Python interpreter running the confined worker: a bare name looked up on
# PATH or an absolute path. Needs ultralytics + numpy installed in it; a
# missing runtime is a classified UNAVAILABLE, never a boot failure.
# Default python.
# CV_LOCAL_PYTHON_BIN=python

# Wall-clock kill timeout for one detector invocation, ms. Bounds
# 5000..300000. Default 60000.
# CV_LOCAL_YOLO_TIMEOUT_MS=60000

# Detection confidence floor passed to the model. Bounds 0..1. Default 0.25.
# CV_LOCAL_YOLO_CONF_THRESHOLD=0.25

# Detector sampling rate, frames per second of source time (at most 32 frames
# per clip regardless). Bounds 0.5..8. Default 2.
# CV_LOCAL_YOLO_FPS=2

# Inference device hint shared by the detector and the embedding encoder:
# auto | cpu | cuda. Default auto.
# CV_LOCAL_YOLO_DEVICE=auto

# Registry KEY of the local image-EMBEDDING model (an open_clip-class
# encoder). Unset leaves the embedding runtime UNAVAILABLE. Default unset.
# CV_LOCAL_EMBED_MODEL_ID=clip-vit-b32

# Wall-clock kill timeout for one embedding invocation, ms. Bounds
# 5000..300000. Default 60000.
# CV_LOCAL_EMBED_TIMEOUT_MS=60000

# =============================================================================
# Seed script only — read by prisma/seed.ts, NOT by the API config
# =============================================================================
# These are deliberately absent from env.validation.ts: they are consumed by
# `pnpm run db:seed`, never by a running API process. Never set them in a
# shared or production environment (production additionally requires
# SEED_ALLOW_PROD).

# Explicit opt-in to creating a platform administrator. Without it, a routine
# catalog seed can never create one by accident. Default unset.
# SEED_PLATFORM_ADMIN=true

# Email for that administrator. Default admin@byond.local.
# SEED_ADMIN_EMAIL=admin@byond.local

# Password for that administrator: 8+ characters, at most 72 UTF-8 bytes.
# Local-only placeholder — choose your own and never commit it.
# SEED_ADMIN_PASSWORD=choose-a-local-only-password
