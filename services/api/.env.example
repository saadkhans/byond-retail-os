# Local development configuration — placeholder values only.
# Never put real credentials in this file or commit a real .env.
DATABASE_URL=postgresql://byond:byond@localhost:5432/byond_dev
PORT=3000
NODE_ENV=development

# JWT signing secret (HS256). REQUIRED, minimum 32 characters, and the app
# refuses to boot with placeholder-looking values. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Explicit unit REQUIRED (3600s, 15m, 1h, 7d). Unitless values are rejected —
# jsonwebtoken would read "900" as 900 milliseconds.
JWT_EXPIRES_IN=15m

# Browser origins allowed by CORS (comma-separated, no wildcard). Defaults
# to the local admin-web dev server.
# CORS_ORIGINS=http://localhost:5173

# Express "trust proxy" — how req.ip is derived (login throttling keys on it).
# Leave unset/false unless this instance runs behind a proxy you control.
# Allowed: true | false | loopback | linklocal | uniquelocal | <hop count>
# TRUST_PROXY=false

# Login throttling (per IP + email, in-memory). Defaults: 5 attempts / 60s.
# LOGIN_THROTTLE_LIMIT=5
# LOGIN_THROTTLE_WINDOW_MS=60000

# Local-only platform admin seeding (pnpm run db:seed). BOTH variables below
# are required: SEED_PLATFORM_ADMIN=true is a separate explicit opt-in, so a
# routine catalog seed with a stray password in the environment can never
# create an administrator by accident. Never set these in shared or
# production environments (production additionally requires SEED_ALLOW_PROD).
# Password must satisfy the login policy: 8+ characters, at most 72 UTF-8 bytes.
# SEED_PLATFORM_ADMIN=true
# SEED_ADMIN_EMAIL=admin@byond.local
# SEED_ADMIN_PASSWORD=choose-a-local-only-password

# Phase 10 — video ingestion (local/dev storage ONLY; never a public bucket).
# Uploaded test videos and extracted frame/crop artifacts are stored under
# this gitignored directory behind server-generated keys; the path is never
# exposed through the API. Relative paths resolve against services/api.
# VIDEO_STORAGE_ROOT=../../.local/video-ingest
# Upload ceiling in bytes (default 52428800 = 50 MiB — short test clips
# only; hard maximum 268435456 = 256 MiB, enforced at boot: uploads buffer
# in memory and the size column is a signed 32-bit integer).
# VIDEO_MAX_UPLOAD_BYTES=52428800
# Opt-in local system ffmpeg adapter for real frame/crop extraction. Off by
# default: the simulated extractor covers dev/test without media tooling.
# VIDEO_FFMPEG_ENABLED=false
# Opt-in local system tesseract adapter for the PRE-STORAGE frame screen
# (OCR over sampled frames of every upload BEFORE any byte reaches durable
# storage). Off by default: the simulated recognizer never reads pixels, so
# with it uploads fail closed (503) unless the unsafe override below is set.
# VIDEO_OCR_ENABLED=false
# DANGER — non-production/simulated environments ONLY: permits uploads
# WITHOUT the pre-storage frame screen when the extractor/recognizer
# toolchain cannot perform it. Every upload accepted under this flag records
# the bypass in its create audit entry. PRODUCTION MUST NEVER SET THIS.
# VIDEO_UNSAFE_ALLOW_UNSCREENED_UPLOADS=false
