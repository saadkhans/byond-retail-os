# BYOND edge runtime — example configuration.
# Never commit real credentials; this file documents names only.

NODE_ENV=development

# Identity of this edge node. Issued by the cloud control plane. The local
# store is sealed to these three on first open and the runtime refuses to
# start against a store sealed to anyone else, so re-provisioning a box to a
# different tenant, location or device means giving it a fresh store root.
EDGE_TENANT_ID=replace-me
EDGE_LOCATION_ID=replace-me
EDGE_DEVICE_ID=replace-me

# Durable local store root (created if absent). Holds the working set and the
# append-only logs. Never holds media bytes or card data.
EDGE_STORE_ROOT=./.edge-store

# Cloud control plane. TLS is mandatory outside development; an http:// URL is
# accepted only for loopback while NODE_ENV is development or test.
EDGE_CLOUD_BASE_URL=https://api.example.com
# Device-scoped credential. Least privilege; rotated by the control plane.
EDGE_CLOUD_TOKEN=replace-me

# Sync cadence and delivery budget.
EDGE_SYNC_INTERVAL_MS=15000
EDGE_SYNC_BATCH_SIZE=50
EDGE_SYNC_MAX_ATTEMPTS=8
EDGE_SYNC_BACKOFF_BASE_MS=1000
EDGE_SYNC_BACKOFF_MAX_MS=300000
EDGE_OUTBOX_MAX_ENTRIES=10000

# A CV proposal below this confidence goes to the local review queue instead of
# the local ledger. Tenant-configurable in the cloud; this is the edge default.
EDGE_REVIEW_CONFIDENCE_THRESHOLD=0.75

# Hardware drivers to register, as kind:adapterKey pairs.
EDGE_DRIVERS=camera:simulated,scale:simulated,esl:simulated,gate:simulated,pos:simulated
EDGE_HEARTBEAT_INTERVAL_MS=30000

# Operational surface. Loopback by default: metrics describe the store.
EDGE_OPS_PORT=3100
EDGE_OPS_BIND_ADDRESS=127.0.0.1
