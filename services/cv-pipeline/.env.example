# CV pipeline — tier-1 tracking and tier-2 triggers.
# Copy to .env. Never commit a filled-in copy.

NODE_ENV=development
CV_PIPELINE_PORT=3100

# --- The API this pipeline proposes to -------------------------------------
# http(s) only, no credentials, no query string, no fragment.
CV_PIPELINE_API_BASE_URL=http://127.0.0.1:3000
# Access token for a service account holding `inference:manage` on a tenant
# with the `inference` module enabled. Never logged by this service.
CV_PIPELINE_API_TOKEN=
CV_PIPELINE_API_TIMEOUT_MS=10000

# --- What this camera is looking at ----------------------------------------
# Opaque ids carried onto every job so the API can place the moment.
CV_PIPELINE_LOCATION_ID=
CV_PIPELINE_UNIT_ID=
CV_PIPELINE_DEVICE_ID=

# --- Where frames come from ------------------------------------------------
# simulated (default; no ffmpeg, no camera, deterministic) or ffmpeg.
CV_PIPELINE_FRAME_SOURCE=simulated
#
# The NAME of the environment variable holding the camera input — not the
# input itself. The indirection keeps the address out of the validated
# configuration object, which is the thing most likely to end up in a log.
# The value it names may be a credential-free rtsp:// URL or, in
# development, a local file path.
#CV_PIPELINE_SOURCE_ENV_KEY=CAMERA_SOURCE_LANE_1
#CAMERA_SOURCE_LANE_1=rtsp://camera.local:554/stream1

# --- Tier 1: tracking ------------------------------------------------------
# Downscaled by design; the service refuses anything above 640x480, because
# high-resolution pixels belong to tier 3 and never to the continuous loop.
CV_PIPELINE_FRAME_WIDTH=320
CV_PIPELINE_FRAME_HEIGHT=240
CV_PIPELINE_SAMPLE_INTERVAL_MS=200
CV_PIPELINE_FRAME_TIMEOUT_MS=5000

# simulated (deterministic) or motion (frame difference).
CV_PIPELINE_TRACKER=motion
CV_PIPELINE_PIXEL_DELTA_THRESHOLD=18
CV_PIPELINE_CELL_ACTIVATION_RATIO=0.12

# Shelf zones in normalized frame coordinates (0..1, origin top-left).
# Zone codes are opaque here — pair them with the planogram cells the API
# already knows about.
CV_PIPELINE_ZONES=[{"zoneCode":"A1","box":{"x":0.05,"y":0.1,"width":0.4,"height":0.35}}]

# --- Tier 2: triggers ------------------------------------------------------
CV_PIPELINE_ZONE_COVERAGE_THRESHOLD=0.2
CV_PIPELINE_MOTION_RATIO_THRESHOLD=0.04
# A moment must last this long to count...
CV_PIPELINE_TRIGGER_MIN_DURATION_MS=400
# ...and the zone must be quiet this long before it can trigger again.
CV_PIPELINE_TRIGGER_REARM_QUIET_MS=2000
# A moment that never ends is still emitted once, here.
CV_PIPELINE_TRIGGER_MAX_DURATION_MS=15000
CV_PIPELINE_TRIGGER_RATE_LIMIT=20
CV_PIPELINE_TRIGGER_RATE_WINDOW_MS=60000
CV_PIPELINE_EXIT_QUIET_MS=8000

# --- Backpressure ----------------------------------------------------------
# At capacity the OLDEST pending submission is dropped and counted.
CV_PIPELINE_QUEUE_CAPACITY=200
CV_PIPELINE_QUEUE_MAX_ATTEMPTS=5
CV_PIPELINE_QUEUE_BACKOFF_BASE_MS=1000
CV_PIPELINE_QUEUE_BACKOFF_MAX_MS=30000
