{
  "name": "@byond/mobile-app",
  "version": "0.1.0",
  "private": true,
  "description": "BYOND Shopper App — a mobile-first web app for store entry, the live basket, exit and payment against the Phase 26 store loop.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
