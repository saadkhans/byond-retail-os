# Shopper app configuration — placeholder values only.
#
# This file lists EVERY variable the app reads. There is exactly one, and it
# is not a secret: a Vite bundle is public, so anything put here is public
# too. The shopper credential is never built in — it is typed or scanned at
# the door and lives only in the tab's sessionStorage.

# Base URL of the BYOND API (no trailing slash).
VITE_API_BASE_URL=http://localhost:3000

# Reminder for local runs: the API's CORS allowlist is explicit and defaults
# to the admin shell alone. Start the API with
#   CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# or the browser will block every request this app makes.
