{
  "name": "@byond/admin-web",
  "version": "0.1.0",
  "private": true,
  "description": "BYOND Admin Web Shell — functional admin visibility for stores, units, devices, catalog, and inventory.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src vite.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@byond/shared": "workspace:*",
    "@byond/ui": "workspace:*",
    "react": "^18.3.1",
