{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "BYOND React package",
  "_comment": "Bundler-resolved ESM + DOM for the React packages and apps (Vite/Vitest compile the TypeScript; tsc only typechecks).",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  }
}
