{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "BYOND Node service",
  "_comment": "CommonJS Node services (NestJS): decorator metadata, declarations, source maps.",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true
  }
}
